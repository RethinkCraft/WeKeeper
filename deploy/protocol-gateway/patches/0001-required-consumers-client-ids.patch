+CREATE TABLE required_event_consumers(
+    consumer_id TEXT PRIMARY KEY,
+    registered_after INTEGER NOT NULL CHECK(registered_after>=0),
+    acknowledged_sequence INTEGER NOT NULL CHECK(acknowledged_sequence>=registered_after),
+    delivered_sequence INTEGER NOT NULL CHECK(delivered_sequence>=acknowledged_sequence)
+);
+CREATE TABLE client_id_reservations(
+    idempotency_key TEXT PRIMARY KEY,
+    client_id INTEGER NOT NULL UNIQUE CHECK(client_id BETWEEN 1 AND 4294967295)
+);
+CREATE INDEX outbox_client_id ON outbox(client_id);
+PRAGMA user_version=9;
diff --git a/packages/native-client-rust/crates/wechat-store/src/event_consumers.rs b/packages/native-client-rust/crates/wechat-store/src/event_consumers.rs
new file mode 100644
index 0000000..cad8976
--- /dev/null
+++ b/packages/native-client-rust/crates/wechat-store/src/event_consumers.rs
@@ -0,0 +1,343 @@
+//! Required event consumers retain operational events until their local ACK.
+//! An ACK means the consumer saved the event; it never marks a chat as read.
+use super::*;
+use rusqlite::OptionalExtension;
+
+#[derive(Debug, Clone, Serialize, Deserialize, ts_rs::TS)]
+#[serde(rename_all = "camelCase")]
+pub struct RequiredEventConsumer {
+    pub consumer_id: String,
+    pub required: bool,
+    pub registered_after: String,
+    pub acknowledged_cursor: String,
+    pub delivered_cursor: String,
+}
+
+fn validate_name(consumer: &str) -> Result<()> {
+    anyhow::ensure!(
+        !consumer.is_empty()
+            && consumer.len() <= 128
+            && consumer
+                .bytes()
+                .all(|c| c.is_ascii_alphanumeric() || b"._-".contains(&c)),
+        "invalid consumer name"
+    );
+    Ok(())
+}
+
+fn consumer_row(db: &Connection, consumer: &str) -> Result<Option<RequiredEventConsumer>> {
+    Ok(db.query_row(
+        "SELECT registered_after,acknowledged_sequence,delivered_sequence FROM required_event_consumers WHERE consumer_id=?1",
+        [consumer],
+        |r| Ok(RequiredEventConsumer {
+            consumer_id: consumer.into(), required: true,
+            registered_after: r.get::<_, i64>(0)?.to_string(),
+            acknowledged_cursor: r.get::<_, i64>(1)?.to_string(),
+            delivered_cursor: r.get::<_, i64>(2)?.to_string(),
+        }),
+    ).optional()?)
+}
+
+fn check_cursor(db: &Connection, after: i64) -> Result<i64> {
+    anyhow::ensure!(after >= 0, "invalid event cursor");
+    let (first, latest): (Option<i64>, i64) = db.query_row(
+        "SELECT MIN(sequence),COALESCE(MAX(sequence),0) FROM events",
+        [],
+        |r| Ok((r.get(0)?, r.get(1)?)),
+    )?;
+    if first.is_some_and(|first| after < first - 1) {
+        bail!("event_cursor_expired");
+    }
+    anyhow::ensure!(after <= latest, "invalid future event cursor");
+    Ok(latest)
+}
+
+/// Keep the recent window, plus every event not ACKed by every required reader.
+/// Called inside the same write transaction as every event producer.
+pub(crate) fn prune_events(db: &Connection, latest: i64) -> Result<()> {
+    db.execute(
+        "DELETE FROM events WHERE sequence<=MIN(?1,COALESCE((SELECT MIN(acknowledged_sequence) FROM required_event_consumers),?1))",
+        [latest.saturating_sub(10_000)],
+    )?;
+    Ok(())
+}
+
+/// Return false for legacy consumers, whose ACKs do not pin event retention.
+pub(crate) fn acknowledge_required(db: &Connection, consumer: &str, cursor: i64) -> Result<bool> {
+    let Some(current) = consumer_row(db, consumer)? else {
+        return Ok(false);
+    };
+    anyhow::ensure!(cursor >= 0, "invalid consumer acknowledgement");
+    let delivered = current.delivered_cursor.parse::<i64>()?;
+    anyhow::ensure!(cursor <= delivered, "consumer_cursor_not_delivered");
+    // An old retry is harmless; it cannot roll the committed ACK backwards.
+    db.execute(
+        "UPDATE required_event_consumers SET acknowledged_sequence=MAX(acknowledged_sequence,?2) WHERE consumer_id=?1",
+        params![consumer, cursor],
+    )?;
+    let latest = db.query_row("SELECT COALESCE(MAX(sequence),0) FROM events", [], |r| {
+        r.get(0)
+    })?;
+    prune_events(db, latest)?;
+    Ok(true)
+}
+
+impl Store {
+    pub fn register_required_consumer(
+        &self,
+        account: &str,
+        consumer: &str,
+        after: i64,
+    ) -> Result<RequiredEventConsumer> {
+        validate_name(consumer)?;
+        self.control(account, |db| {
+            let tx = db.transaction()?;
+            if let Some(current) = consumer_row(&tx, consumer)? {
+                anyhow::ensure!(
+                    current.registered_after == after.to_string(),
+                    "consumer_registration_conflict"
+                );
+                return Ok(current);
+            }
+            check_cursor(&tx, after)?;
+            tx.execute(
+                "INSERT INTO required_event_consumers VALUES(?1,?2,?2,?2)",
+                params![consumer, after],
+            )?;
+            let state = consumer_row(&tx, consumer)?.context("consumer_not_found")?;
+            tx.commit()?;
+            Ok(state)
+        })
+    }
+
+    pub fn required_consumer(
+        &self,
+        account: &str,
+        consumer: &str,
+    ) -> Result<RequiredEventConsumer> {
+        validate_name(consumer)?;
+        self.control(account, |db| {
+            consumer_row(db, consumer)?.context("consumer_not_found")
+        })
+    }
+
+    /// Deliver a contiguous prefix. Requesting beyond the previous delivered
+    /// cursor is refused, so an ACK cannot skip a page that was never offered.
+    pub fn consumer_events(
+        &self,
+        account: &str,
+        consumer: &str,
+        after: Option<i64>,
+        limit: usize,
+    ) -> Result<(Vec<Event>, RequiredEventConsumer)> {
+        validate_name(consumer)?;
+        anyhow::ensure!((1..=200).contains(&limit), "invalid event limit");
+        self.control(account, |db| {
+            let tx = db.transaction()?;
+            let current = consumer_row(&tx, consumer)?.context("consumer_not_found")?;
+            let after = after.unwrap_or(current.acknowledged_cursor.parse()?);
+            check_cursor(&tx, after)?;
+            anyhow::ensure!(after >= current.registered_after.parse()?, "invalid cursor before registration");
+            anyhow::ensure!(after <= current.delivered_cursor.parse()?, "consumer_cursor_not_delivered");
+            let items = {
+                let mut query = tx.prepare("SELECT sequence,kind,data_json,created_at FROM events WHERE sequence>?1 ORDER BY sequence LIMIT ?2")?;
+                let rows = query.query_map(params![after, limit as i64], |r| {
+                    Ok((r.get::<_, i64>(0)?, r.get::<_, String>(1)?, r.get::<_, String>(2)?, r.get::<_, String>(3)?))
+                })?.collect::<rusqlite::Result<Vec<_>>>()?;
+                rows.into_iter().map(|(seq, kind, raw, created_at)| Ok(Event {
+                    cursor: seq.to_string(), kind, data: serde_json::from_str(&raw)?, created_at,
+                })).collect::<Result<Vec<_>>>()?
+            };
+            if let Some(last) = items.last() {
+                tx.execute("UPDATE required_event_consumers SET delivered_sequence=MAX(delivered_sequence,?2) WHERE consumer_id=?1", params![consumer, last.cursor.parse::<i64>()?])?;
+            }
+            let state = consumer_row(&tx, consumer)?.context("consumer_not_found")?;
+            tx.commit()?;
+            Ok((items, state))
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+

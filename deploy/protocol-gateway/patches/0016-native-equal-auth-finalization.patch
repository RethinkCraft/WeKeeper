+        destination: &str,
+        client_id: &str,
+        created_at: u32,
+        _content: &str,
+    ) -> Result<Vec<u8>> {
+        let sequence = self.calls.fetch_add(1, Ordering::SeqCst) + 1;
+        if self.change_cookie.load(Ordering::SeqCst) {
+            state.cookie = vec![(sequence as u8).wrapping_add(7); 15];

+struct Commits<'a> {
+    store: &'a Store,
+    count: Arc<AtomicUsize>,
+}
+unsafe extern "C" fn count_commit(
+    kind: u32,
+    context: *mut c_void,
+    statement: *mut c_void,
+    _sql: *mut c_void,
+) -> std::ffi::c_int {
+    if kind == rusqlite::ffi::SQLITE_TRACE_STMT as u32 {
+        let text = rusqlite::ffi::sqlite3_sql(statement.cast());
+        if !text.is_null()
+            && CStr::from_ptr(text)
+                .to_bytes()
+                .eq_ignore_ascii_case(b"COMMIT")
+        {
+            (&*context.cast::<AtomicUsize>()).fetch_add(1, Ordering::SeqCst);
+        }
+    }
+    0
+}
+impl<'a> Commits<'a> {
+    fn new(store: &'a Store) -> Self {
+        let count = Arc::new(AtomicUsize::new(0));
+        store
+            .control("one", |db| {
+                let rc = unsafe {
+                    rusqlite::ffi::sqlite3_trace_v2(
+                        db.handle(),
+                        rusqlite::ffi::SQLITE_TRACE_STMT as u32,
+                        Some(count_commit),
+                        Arc::as_ptr(&count).cast_mut().cast(),
+                    )
+                };
+                anyhow::ensure!(rc == rusqlite::ffi::SQLITE_OK, "trace setup failed");
+                Ok(())
+            })
+            .unwrap();
+        Self { store, count }
+    }
+}
+impl Drop for Commits<'_> {
+    fn drop(&mut self) {
+        let _ = self.store.control("one", |db| {
+            unsafe {
+                rusqlite::ffi::sqlite3_trace_v2(db.handle(), 0, None, std::ptr::null_mut());
+            }
+            Ok(())
+        });
+    }
+}
+unsafe extern "C" fn deny_commit(
+    _ctx: *mut c_void,
+    action: std::ffi::c_int,
+    first: *const std::ffi::c_char,
+    _second: *const std::ffi::c_char,
+    _db: *const std::ffi::c_char,
+    _trigger: *const std::ffi::c_char,
+) -> std::ffi::c_int {
+    if action == rusqlite::ffi::SQLITE_TRANSACTION
+        && !first.is_null()
+        && CStr::from_ptr(first).to_bytes() == b"COMMIT"
+    {
+        rusqlite::ffi::SQLITE_DENY
+    } else {
+        rusqlite::ffi::SQLITE_OK
+    }
+}
+fn reject_commit(store: &Store) {
+    store
+        .control("one", |db| {
+            let rc = unsafe {
+                rusqlite::ffi::sqlite3_set_authorizer(
+                    db.handle(),
+                    Some(deny_commit),
+                    std::ptr::null_mut(),
+                )
+            };
+            anyhow::ensure!(rc == rusqlite::ffi::SQLITE_OK, "authorizer setup failed");
+            Ok(())
+        })
+        .unwrap();
+}

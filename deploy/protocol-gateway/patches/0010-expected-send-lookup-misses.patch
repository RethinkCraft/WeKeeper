+#[test]
+fn failed_lookup_sql_or_receipt_decode_still_discards_the_writer() {
+    let (_directory, store) = wal_store();
+    let (intent, _) = store
+        .create_send("one", "known", "peer", "hash", b"sealed", "7")
+        .unwrap();
+    store
+        .put_runtime("one", &format!("send-projected:{}", intent.id), &[0xff])
+        .unwrap();
+    let error = store.send_by_key("one", "known").unwrap_err();
+    assert!(error
+        .to_string()
+        .contains("invalid text projection receipt"));
+    assert_eq!(store.admitted.lock().unwrap().cached_writers(), 0);
+    store
+        .control("one", |db| {
+            db.execute_batch("DROP TABLE media_jobs")?;
+            Ok(())
+        })
+        .unwrap();
+    let error = store
+        .media_job_by_key("one", "unknown")
+        .err()
+        .expect("bad table is not missing key");
+    assert!(!matches!(
+        error.downcast_ref::<rusqlite::Error>(),
+        Some(rusqlite::Error::QueryReturnedNoRows)
+    ));
+    assert_eq!(store.admitted.lock().unwrap().cached_writers(), 0);
+}

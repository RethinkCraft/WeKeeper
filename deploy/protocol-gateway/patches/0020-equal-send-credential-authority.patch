+#[test]
+fn preserve_final_outbox_event_or_commit_failure_rolls_back_cleanup() {
+    for target in ["outbox", "events", "commit"] {
+        let (_dir, store, intent, snapshot) = setup();
+        let staged = stage(&store, &intent, &snapshot);
+        if target == "commit" {
+            reject_commit(&store);
+        } else {
+            store.control("one", |db| {
+                let sql = if target == "outbox" {
+                    "CREATE TRIGGER reject_preserve_final BEFORE UPDATE ON outbox BEGIN SELECT RAISE(ABORT,'synthetic final fault'); END"
+                } else {
+                    "CREATE TRIGGER reject_preserve_final BEFORE INSERT ON events BEGIN SELECT RAISE(ABORT,'synthetic final fault'); END"
+                };
+                db.execute_batch(sql)?; Ok(())
+            }).unwrap();
+        }
+        assert!(preserve(&store, &intent, &staged).is_err());
+        assert_eq!(
+            store.runtime("one", "account-state").unwrap().as_deref(),
+            Some(OLD)
+        );
+        assert_eq!(store.send("one", &intent.id).unwrap().state, "submitting");
+        assert_eq!(
+            store
+                .runtime("one", "saved-login-projection-needed")
+                .unwrap()
+                .as_deref(),
+            Some(staged.token.as_slice())
+        );
+        assert_blocked(&store);
+        assert_raw(&store, &intent);
+    }
+}

@@ -0,0 +1,612 @@
+//! Receive custody does not wait for the official profile projection worker.
+use super::*;
+use crate::native_ingress_message::{
+    normalize_received_message, ReceivedDisposition, ReceivedMessageSnapshot,
+};
+use wechat_store::{NativeIngressBatch, NativeIngressMessageInput, NativeIngressRecallInput};
+
+impl Core {
+    fn native_ingress_recalls(
+        &self,
+        account: &str,
+        own: &str,
+        id: &str,
+        batch: &wechat_protocol::wire::SyncBatch,
+    ) -> Result<Vec<NativeIngressRecallInput>> {
+        let mut recalls = Vec::new();
+        for (index, command) in batch.commands.iter().enumerate().filter(|(_, c)| c.id == 5) {
+            let parse = || -> Result<Option<crate::recalls::IncomingRecall>> {
+                let fields = wechat_protocol::protobuf::decode(&command.payload)?;
+                let mut seen = std::collections::BTreeSet::new();
+                anyhow::ensure!(
+                    fields.iter().all(|f| seen.insert(f.number)),
+                    "ambiguous_received_field"
+                );
+                if wechat_protocol::protobuf::scalar(&fields, 4)? != 10002 {
+                    return Ok(None);
+                }
+                let snapshot = normalize_received_message(account, own, &command.payload);
+                anyhow::ensure!(
+                    snapshot.reason.as_deref() == Some("unsupported_received_type"),
+                    "received_identity_invalid"
+                );
+                let message = wechat_protocol::wire::decode_add_message(&command.payload, own)?;
+                crate::recalls::incoming_recall(&message, own)
+            };
+            if let Ok(Some(recall)) = parse() {
+                let receipt = format!("projected:{id}:{index}");
+                recalls.push(NativeIngressRecallInput {
+                    thread_id: recall.thread,
+                    server_id: recall.server,
+                    recalled_at: recall.recalled_at,
+                    sealed_control: self.vault.seal(
+                        account,
+                        &format!("sync-control:{receipt}"),
+                        &command.payload,
+                    )?,
+                    control_receipt: receipt,
+                });
+            }
+        }
+        Ok(recalls)
+    }
+    fn native_ingress_items(
+        &self,
+        account: &str,
+        own: &str,
+        batch_id: &str,
+        batch: &wechat_protocol::wire::SyncBatch,
+    ) -> Result<Vec<NativeIngressMessageInput>> {
+        let mut items = Vec::new();
+        for (index, command) in batch.commands.iter().enumerate().filter(|(_, c)| c.id == 5) {
+            let snapshot = normalize_received_message(account, own, &command.payload);
+            let identity = match (&snapshot.thread_id, &snapshot.server_id) {
+                (Some(thread), Some(server)) => serde_json::to_vec(&(account, thread, server))?,
+                _ => serde_json::to_vec(&(account, batch_id, index))?,
+            };
+            let id = format!("recv_{:x}", Sha256::digest(identity));
+            let plain = zeroize::Zeroizing::new(serde_json::to_vec(&snapshot)?);
+            items.push(NativeIngressMessageInput {
+                received_id: id.clone(),
+                command_index: index,
+                thread_id: snapshot.thread_id.clone(),
+                server_id: snapshot.server_id.clone(),
+                disposition: serde_json::to_value(&snapshot.disposition)?
+                    .as_str()
+                    .context("invalid native disposition")?
+                    .into(),
+                reason: snapshot.reason.clone(),
+                source_sha256: snapshot.source_sha256.clone(),
+                identity_fingerprint: snapshot.identity_fingerprint(),
+                sealed_snapshot: self.vault.seal(
+                    account,
+                    &format!("native-received:{id}"),
+                    plain.as_slice(),
+                )?,
+            });
+        }
+        Ok(items)
+    }
+
+    /// Index every pre-existing sealed message batch as historical, including
+    /// projected and blocked ones. Never reinterpret migration time as arrival.
+    pub(super) fn catalogue_native_history(&self, account: &str, own: &str) -> Result<()> {
+        loop {
+            let batches = self.store.uncatalogued_native_batches(account)?;
+            if batches.is_empty() {
+                return Ok(());
+            }
+            for (id, sealed) in batches {
+                let raw = self
+                    .vault
+                    .open_record(account, &format!("apply:{id}"), &sealed)?;
+                let batch: wechat_protocol::wire::SyncBatch = serde_json::from_slice(&raw)?;
+                let messages = self.native_ingress_items(account, own, &id, &batch)?;
+                let recalls = self.native_ingress_recalls(account, own, &id, &batch)?;
+                self.store.stage_native_ingress(
+                    account,
+                    NativeIngressBatch {
+                        batch_id: id,
+                        payload: None,
+                        cursor: None,
+                        ownership_generation: self.ownership_generation.clone(),
+                        historical: true,
+                        caught_up: false,
+                        origin: "catchup".into(),
+                        messages,
+                        recalls,
+                    },
+                )?;
+            }
+        }
+    }
+
+    pub(super) fn commit_native_ingress(
+        &self,
+        account: &str,
+        id: &str,
+        batch: &wechat_protocol::wire::SyncBatch,
+        origin: &str,
+    ) -> Result<String> {
+        let own = self.account_state(account)?.own_username.clone();
+        self.catalogue_native_history(account, &own)?;
+        let messages = self.native_ingress_items(account, &own, id, batch)?;
+        let recalls = self.native_ingress_recalls(account, &own, id, batch)?;
+        self.store.stage_native_ingress(
+            account,
+            NativeIngressBatch {
+                batch_id: id.into(),
+                payload: Some(self.vault.seal(
+                    account,
+                    &format!("apply:{id}"),
+                    &serde_json::to_vec(batch)?,
+                )?),
+                cursor: Some(self.vault.seal(account, "received-cursor", &batch.cursor)?),
+                ownership_generation: self.ownership_generation.clone(),
+                historical: false,
+                caught_up: !batch.continuation,
+                origin: origin.into(),
+                messages,
+                recalls,
+            },
+        )
+    }
+
+    fn load_received_snapshot(
+        &self,
+        account: &str,
+        id: &str,
+    ) -> Result<(wechat_store::NativeIngressRecord, ReceivedMessageSnapshot)> {
+        let record = self.store.native_ingress_record(account, id)?;
+        let raw = self.vault.open_record(
+            account,
+            &format!("native-received:{id}"),
+            &record.sealed_snapshot,
+        )?;
+        let snapshot: ReceivedMessageSnapshot = serde_json::from_slice(&raw)?;
+        anyhow::ensure!(
+            snapshot.account_id == account && snapshot.source_sha256 == record.source_sha256,
+            "native_ingress_identity_mismatch"
+        );
+        Ok((record, snapshot))
+    }
+    pub(crate) fn received_snapshot(
+        &self,
+        account: &str,
+        id: &str,
+    ) -> Result<ReceivedMessageSnapshot> {
+        let (record, snapshot) = self.load_received_snapshot(account, id)?;
+        anyhow::ensure!(
+            record.disposition != "quarantined"
+                && snapshot.disposition != ReceivedDisposition::Quarantined,
+            "received_message_quarantined"
+        );
+        Ok(snapshot)
+    }
+    pub fn received_message(&self, account: &str, id: &str) -> Result<Value> {
+        let (record, mut snapshot) = self.load_received_snapshot(account, id)?;
+        if record.disposition == "quarantined" {
+            snapshot.disposition = ReceivedDisposition::Quarantined;
+            snapshot.reason = record.reason;
+            snapshot.quote_reference = None;
+        }
+        Ok(snapshot.to_public(id, &record.first_received_sequence))
+    }
+    pub async fn activate_native_consumer(
+        self: &Arc<Self>,
+        account: &str,
+        consumer: &str,
+        expected_own: &str,
+    ) -> Result<Value> {
+        let guard = self.lock_account(account).await?;
+        let core = self.clone();
+        let account = account.to_owned();
+        let consumer = consumer.to_owned();
+        let expected = expected_own.to_owned();
+        blocking(move || {
+            let _guard = guard;
+            let own = core.account_state(&account)?.own_username.clone();
+            anyhow::ensure!(own == expected, "native_ingress_identity_mismatch");
+            core.store.activate_native_consumer(
+                &account,
+                &consumer,
+                &own,
+                &core.ownership_generation,
+            )
+        })
+        .await
+    }
+
+    /// One command per gate acquisition: incoming commits and queued sends can
+    /// acquire the FIFO account gate between profile writes. Failed commands
+    /// remain in the original batch and never hold up receive custody.
+    fn project_one_native_command(&self, account: &str) -> Result<()> {
+        if let Some((id, sealed)) = self.store.pending_sync(account)?.into_iter().next() {
+            let raw = self
+                .vault
+                .open_record(account, &format!("apply:{id}"), &sealed)?;
+            let batch: wechat_protocol::wire::SyncBatch = serde_json::from_slice(&raw)?;
+            let scan = format!("native-profile-scan:{id}");
+            let mut index = self
+                .store
+                .runtime(account, &scan)?
+                .and_then(|v| String::from_utf8(v).ok())
+                .and_then(|v| v.parse::<usize>().ok())
+                .unwrap_or(0);
+            let origin = self
+                .store
+                .runtime(account, &format!("apply-origin:{id}"))?
+                .and_then(|v| String::from_utf8(v).ok())
+                .unwrap_or_else(|| "catchup".into());
+            while index < batch.commands.len() {
+                let receipt = format!("projected:{id}:{index}");
+                let command = &batch.commands[index];
+                index += 1;
+                if self.store.runtime(account, &receipt)?.is_some() {
+                    continue;
+                }
+                let outcome = self.apply_received_sync_command(account, command, &receipt, &origin);
+                self.store
+                    .put_runtime(account, &scan, index.to_string().as_bytes())?;
+                if let Err(error) = outcome {
+                    let detail=sync_projection::projection_blocker(&error).unwrap_or_else(||json!({"commandId":command.id,"reason":"unsupported_or_unavailable_profile"}));
+                    self.store.append_event_once(account,&format!("native-profile-blocked:{id}:{}",index-1),"projection.blocked",&json!({"batchId":id,"commands":[detail],"blockedCommandCount":1,"truncated":false}))?;
+                }
+                return Ok(());
+            }
+            let mut complete = true;
+            for index in 0..batch.commands.len() {
+                complete &= self
+                    .store
+                    .runtime(account, &format!("projected:{id}:{index}"))?
+                    .is_some();
+            }
+            if complete {
+                self.store.finish_sync(account, &id)?;
+            } else {
+                self.store.block_sync(account, &id)?;
+            }
+            self.store.clear_runtime(account, &scan)?;
+            if complete && self.store.pending_sync_count(account)? == 0 {
+                let _ = self.publish_profile_checkpoint(account);
+            }
+            return Ok(());
+        }
+        Ok(())
+    }
+
+    pub(super) fn start_native_ingress_worker(self: &Arc<Self>, account: &str) -> Result<()> {
+        let core = self.clone();
+        let account = account.to_owned();
+        tokio::spawn(async move {
+            let mut next_send_projection = std::time::Instant::now();
+            loop {
+                if core.stopping.load(Ordering::SeqCst) {
+                    break;
+                }
+                let send_projection = if std::time::Instant::now() >= next_send_projection {
+                    next_send_projection = std::time::Instant::now() + Duration::from_secs(1);
+                    core.store
+                        .next_pending_text_projection(&account)
+                        .ok()
+                        .flatten()
+                } else {
+                    None
+                };
+                if send_projection.is_none()
+                    && !core
+                        .store
+                        .native_projection_work_pending(&account)
+                        .unwrap_or(false)
+                {
+                    tokio::time::sleep(Duration::from_millis(250)).await;
+                    continue;
+                }
+                let Ok(guard) = core.lock_account(&account).await else {
+                    break;
+                };
+                let worker = core.clone();
+                let owned = account.clone();
+                let _ = blocking(move || {
+                    let _guard = guard;
+                    let own = worker.account_state(&owned)?.own_username.clone();
+                    worker.catalogue_native_history(&owned, &own)?;
+                    if worker.store.queued_sends(&owned)?.is_empty() {
+                        if let Some(id) = send_projection {
+                            // Local repair only: accepted sends never re-enter
+                            // the network submission path, even after failure.
+                            let _ = worker.project_message_send(&owned, &id);
+                        } else {
+                            worker.project_one_native_command(&owned)?;
+                        }
+                    }
+                    Ok(())
+                })
+                .await;
+                tokio::time::sleep(Duration::from_millis(25)).await;
+            }
+        });
+        Ok(())
+    }
+}

+//! Coalesce a redundant auth refresh only after retaining the original reply.
+use super::*;
+use wechat_store::{EqualSendSnapshot, EqualSendStage};
+use zeroize::Zeroizing;
+
+pub(super) struct EqualSendContext {
+    pub(super) snapshot: Option<EqualSendSnapshot>,
+    pub(super) pending: Option<PendingEqualSend>,
+    pub(super) suppress_auth: bool,
+}
+
+impl EqualSendContext {
+    pub(super) fn new(snapshot: Option<EqualSendSnapshot>) -> Self {
+        Self {
+            snapshot,
+            pending: None,
+            suppress_auth: false,
+        }
+    }
+}
+
+pub(super) struct PendingEqualSend {
+    pub(super) snapshot: EqualSendSnapshot,
+    pub(super) stage: EqualSendStage,
+}
+
+pub(super) struct PreparedEqualSend {
+    pub(super) stage: EqualSendStage,
+    pub(super) new_cipher: Vec<u8>,
+}
+
+fn complete_state_equal(left: &AccountState, right: &AccountState) -> Result<bool> {
+    // Typed serialization covers every persistent field, including future
+    // fields. No plaintext, field values or credential-derived hash is logged.
+    let left = Zeroizing::new(serde_json::to_vec(left)?);
+    let right = Zeroizing::new(serde_json::to_vec(right)?);
+    Ok(left.as_slice() == right.as_slice())
+}
+
+impl Core {
+    pub(super) fn capture_equal_send_state(
+        &self,
+        account: &str,
+        state: &AccountState,
+        trace: &QuoteTrace,
+    ) -> Result<Option<EqualSendSnapshot>> {
+        let span = trace.span(TimingStage::EqualStateCapture);
+        let result = (|| -> Result<Option<EqualSendSnapshot>> {
+            let snapshot = self
+                .store
+                .capture_equal_send_snapshot(account, &self.ownership_generation)?;
+            let Some(snapshot) = snapshot else {
+                return Ok(None);
+            };
+            let saved = self.native_send_state(account, &snapshot.state_cipher)?;
+            if !complete_state_equal(&saved, state)? {
+                return Ok(None);
+            }
+            Ok(Some(snapshot))
+        })();
+        span.finish(match result.as_ref() {
+            Ok(Some(_)) => TimingOutcome::Ok,
+            Ok(None) => TimingOutcome::Skipped,
+            Err(_) => TimingOutcome::Error,
+        });
+        result
+    }
+
+    pub(super) fn equal_send_state_unchanged(
+        &self,
+        account: &str,
+        state: &AccountState,
+        snapshot: &EqualSendSnapshot,
+        trace: &QuoteTrace,
+    ) -> Result<bool> {
+        let span = trace.span(TimingStage::EqualStateCompare);
+        let result = self
+            .native_send_state(account, &snapshot.state_cipher)
+            .and_then(|saved| complete_state_equal(&saved, state));
+        span.finish(match result.as_ref() {
+            Ok(true) => TimingOutcome::Unchanged,
+            Ok(false) => TimingOutcome::Other,
+            Err(_) => TimingOutcome::Error,
+        });
+        result
+    }
+
+    pub(super) fn prepare_equal_send_final(
+        &self,
+        account: &str,
+        state: &AccountState,
+        pending: PendingEqualSend,
+        trace: &QuoteTrace,
+    ) -> Result<Option<PreparedEqualSend>> {
+        let proof = trace.span(TimingStage::EqualStateProfileProof);
+        let eligible = self.prove_equal_send_saved_login(account, state, &pending.snapshot);
+        proof.finish(match eligible.as_ref() {
+            Ok(true) => TimingOutcome::Unchanged,
+            Ok(false) => TimingOutcome::Other,
+            Err(_) => TimingOutcome::Error,
+        });
+        if !eligible? {
+            return Ok(None);
+        }
+        let new_cipher = trace.measure(TimingStage::StateValidateSeal, || {
+            let bytes = Zeroizing::new(serde_json::to_vec(state)?);
+            self.vault.seal(account, "account-state", &bytes)
+        })?;
+        Ok(Some(PreparedEqualSend {
+            stage: pending.stage,
+            new_cipher,
+        }))
+    }
+
+    /// Caller holds the account gate, or is completing single-threaded startup.
+    /// This repairs owned local records only and never calls a remote service.
+    pub(super) fn repair_blocked_equal_authorization(
+        &self,
+        account: &str,
+        trace: &QuoteTrace,
+    ) -> Result<bool> {
+        let Some(snapshot) = self.store.blocked_authorization_snapshot(account)? else {
+            return Ok(false);
+        };
+        let span = trace.span(TimingStage::BlockedAuthorizationRepair);
+        let result = (|| -> Result<bool> {
+            anyhow::ensure!(self.owns_profile(account)?, "profile_ownership_required");
+            let state = self.native_send_state(account, &snapshot.state_cipher)?;
+            self.upstream.validate_state(&state)?;
+            self.check_state_profile(account, &state)?;
+            let bytes = Zeroizing::new(serde_json::to_vec(&state)?);
+            let fresh = self.vault.seal(account, "account-state", &bytes)?;
+            let installed = self
+                .store
+                .repair_blocked_authorization(account, &snapshot, &fresh)?;
+            if installed {
+                // The accepted-state commit created the ordinary pending
+                // publication marker before any official-profile work.
+                let _ = self.project_saved_login(account, &state);
+            }
+            Ok(installed)
+        })();
+        span.finish(match result.as_ref() {
+            Ok(true) => TimingOutcome::Ok,
+            Ok(false) => TimingOutcome::Skipped,
+            Err(_) => TimingOutcome::Error,
+        });
+        result
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn complete_persistent_equality_covers_all_fields_and_nested_auth_sections() {
+        let original = super::super::tests::state();
+        let value = serde_json::to_value(&original).unwrap();
+        assert!(complete_state_equal(&original, &original).unwrap());
+        let mut paths = Vec::new();
+        fn fields(value: &Value, prefix: Vec<String>, paths: &mut Vec<Vec<String>>) {
+            if let Value::Object(map) = value {
+                for (key, value) in map {
+                    let mut next = prefix.clone();
+                    next.push(key.clone());
+                    fields(value, next, paths);
+                }
+            } else {
+                paths.push(prefix);
+            }
+        }
+        fields(&value, Vec::new(), &mut paths);
+        assert!(paths.len() >= 21);
+        for path in paths {
+            let mut changed = value.clone();
+            let mut field = &mut changed;
+            for segment in &path {
+                field = field.get_mut(segment).unwrap();
+            }
+            match field {
+                Value::String(text) => text.push('x'),
+                Value::Number(number) => *field = json!(number.as_i64().unwrap() + 1),
+                Value::Array(bytes) if bytes.is_empty() => bytes.push(json!(1)),
+                Value::Array(bytes) => bytes[0] = json!(bytes[0].as_u64().unwrap() ^ 1),
+                _ => panic!("unhandled persistent field kind"),
+            }
+            let changed: AccountState = serde_json::from_value(changed).unwrap();
+            assert!(
+                !complete_state_equal(&original, &changed).unwrap(),
+                "persistent field not compared: {}",
+                path.join(".")
+            );
+        }
+    }
+}

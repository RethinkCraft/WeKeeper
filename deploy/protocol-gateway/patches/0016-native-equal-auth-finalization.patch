+#[test]
+fn missing_projected_pending_journal_or_current_owner_never_capture_fast_path() {
+    for key in [
+        "saved-login-projection-needed",
+        "saved-login-publication",
+        NETWORK_BLOCKED_STATE,
+        "saved-login-projected-state-generation",
+        "validated-generation",
+    ] {
+        let (_dir, store, intent, _snapshot) = setup();
+        store.put_runtime("one", key, b"unproven").unwrap();

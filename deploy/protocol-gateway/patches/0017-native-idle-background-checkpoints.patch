+++ b/packages/native-client-rust/crates/wx/src/serve_maintenance_tests.rs
@@ -0,0 +1,116 @@
+//! Exercise the actual serve body while another owner retains Core and Store.
+use super::*;
+use std::{collections::BTreeSet, sync::atomic::Ordering, time::Instant};
+static SERIAL: tokio::sync::Mutex<()> = tokio::sync::Mutex::const_new(());
+
+struct NoTransport;
+impl wechat_core::upstream::Upstream for NoTransport {
+    fn kind(&self) -> wechat_core::upstream::UpstreamKind {
+        wechat_core::upstream::UpstreamKind::Native
+    }
+}
+
+fn checkpoint_threads() -> BTreeSet<u32> {
+    std::fs::read_dir("/proc/self/task")
+        .unwrap()
+        .filter_map(|entry| {
+            let path = entry.ok()?.path();
+            let name = std::fs::read_to_string(path.join("comm")).ok()?;
+            name.starts_with("control-check")
+                .then(|| path.file_name()?.to_str()?.parse().ok())
+                .flatten()
+        })
+        .collect()
+}
+
+fn fixture() -> (
+    tempfile::TempDir,
+    Arc<Core>,
+    wechat_config::ServerConfig,
+    BTreeSet<u32>,
+) {
+    let before = checkpoint_threads();
+    let temporary = tempfile::tempdir().unwrap();
+    let root = temporary.path().join("data");
+    let store = Arc::new(wechat_store::Store::open(&root).unwrap());
+    store.create_account("one").unwrap();
+    let core = Core::with_upstream(store, None, Arc::new(NoTransport)).unwrap();
+    let deadline = Instant::now() + Duration::from_secs(2);
+    let created = loop {
+        let added = checkpoint_threads()
+            .difference(&before)
+            .copied()
+            .collect::<BTreeSet<_>>();
+        if !added.is_empty() {
+            break added;
+        }
+        assert!(Instant::now() < deadline, "checkpoint worker did not start");
+        std::thread::sleep(Duration::from_millis(1));
+    };
+    let config = wechat_config::ServerConfig {
+        schema_version: 1,
+        config_file: temporary.path().join("server.toml"),
+        config_present: false,
+        data_dir: root,
+        token_file: temporary.path().join("api-token"),
+        token_explicit: false,
+        storage_key_file: None,
+        profile_format_key_file: None,
+        listen: "127.0.0.1:0".parse().unwrap(),
+        network_listen: None,
+        tls_cert_file: None,
+        tls_key_file: None,
+    };
+    (temporary, core, config, created)
+}
+
+fn joined_while_owned(core: &Core, store: &Arc<wechat_store::Store>, workers: &BTreeSet<u32>) {
+    assert!(core.stopping.load(Ordering::SeqCst));
+    assert!(
+        Arc::strong_count(store) >= 2,
+        "Store was dropped instead of explicitly joined"
+    );
+    assert!(workers
+        .iter()
+        .all(|id| !Path::new("/proc/self/task").join(id.to_string()).exists()));
+    assert_eq!(
+        core.storage_maintenance_health("one").unwrap()["stopping"],
+        true
+    );
+    store
+        .put_runtime("one", "after-cli-join", b"still-owned")
+        .unwrap();
+    assert_eq!(
+        store.runtime("one", "after-cli-join").unwrap().unwrap(),
+        b"still-owned"
+    );
+}
+
+#[tokio::test]
+async fn serve_setup_error_joins_checkpoint_before_return_with_other_core_owners() {
+    let _serial = SERIAL.lock().await;
+    let (_temporary, core, mut config, workers) = fixture();
+    let store = core.store.clone();
+    let occupied = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    config.listen = occupied.local_addr().unwrap();
+    let error = serve_owned(core.clone(), config, "synthetic-owner-token".into())
+        .await
+        .unwrap_err();
+    assert_eq!(
+        error.downcast_ref::<std::io::Error>().unwrap().kind(),
+        std::io::ErrorKind::AddrInUse
+    );
+    joined_while_owned(&core, &store, &workers);
+}
+
+#[tokio::test]
+async fn serve_graceful_shutdown_joins_checkpoint_before_cli_process_exit() {
+    let _serial = SERIAL.lock().await;
+    let (_temporary, core, config, workers) = fixture();
+    let store = core.store.clone();
+    core.shutdown();
+    serve_owned(core.clone(), config, "synthetic-owner-token".into())
+        .await
+        .unwrap();
+    joined_while_owned(&core, &store, &workers);
+}

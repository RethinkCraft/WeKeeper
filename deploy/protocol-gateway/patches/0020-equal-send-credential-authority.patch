+        .capture_equal_send_snapshot("one", "owner")
+        .unwrap()
+        .unwrap();
+    let current = stage(&store, &second, &snapshot);
+    assert_ne!(old.token, current.token);
+    preserve(&store, &first, &old).unwrap();
+    assert_eq!(
+        store
+            .runtime("one", "saved-login-projection-needed")
+            .unwrap()

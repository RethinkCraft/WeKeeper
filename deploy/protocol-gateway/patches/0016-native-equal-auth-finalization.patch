+}
+fn stage(store: &Store, intent: &SendIntent, snapshot: &EqualSendSnapshot) -> EqualSendStage {
+    match store
+        .retain_equal_send_receipt("one", &intent.id, RAW, Some(snapshot))
+        .unwrap()

+#[test]
+fn staged_profile_proof_failure_uses_fenced_original_three_commit_path() {
+    let (_dir, store, intent, snapshot) = setup();
+    let counter = Commits::new(&store);
+    let _staged = stage(&store, &intent, &snapshot);
+    assert!(store
+        .save_accepted_equal_fallback("one", &snapshot, FRESH)
+        .unwrap());
+    let final_intent = store
+        .update_send("one", &intent.id, "accepted", Some("17"), None)
+        .unwrap();
+    assert_eq!(final_intent.state, "accepted");
+    assert_eq!(counter.count.load(Ordering::SeqCst), 3);
+    assert!(store
+        .runtime("one", NETWORK_BLOCKED_STATE)
+        .unwrap()
+        .is_none());
+    assert_raw(&store, &intent);
+}

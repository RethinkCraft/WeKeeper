+impl Drop for Span {
+    fn drop(&mut self) {
+        if let Some(start) = self.start.take() {
+            self.trace.emit(
+                self.stage,
+                Edge::End,
+                Some(micros(start.elapsed())),
+                Some(Outcome::Incomplete),
+            );
+        }
+    }
+}

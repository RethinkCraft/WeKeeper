+    f.core.stopping.store(true, Ordering::SeqCst);
+    let queued = f
+        .core
+        .send_quoted_source_text(
+            "one",
+            "double-crash",
+            "room@chatroom",
+            "fixed reply",
+            QuoteSourceReference::Received(f.reference.clone()),
+        )
+        .await
+        .unwrap();
+    tokio::time::sleep(Duration::from_millis(20)).await;
+    f.core.stopping.store(false, Ordering::SeqCst);

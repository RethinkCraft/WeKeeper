+        );
+        drop(store);
+        let store = Store::open(&temp.path().join("data")).unwrap();
+        let state = store.required_consumer("one", "slow").unwrap();
+        assert_eq!(state.acknowledged_cursor, "0");
+        assert_eq!(state.delivered_cursor, "10");
+        // A lost response or restart reoffers the page until the local ACK.
+        assert_eq!(
+            store.consumer_events("one", "slow", None, 10).unwrap().0[0].cursor,
+            "1"
+        );
+        let mut after = 0;
+        loop {
+            let (page, _) = store
+                .consumer_events("one", "fast", Some(after), 200)
+                .unwrap();
+            if page.is_empty() {
+                break;
+            }
+            after = page.last().unwrap().cursor.parse().unwrap();
+        }
+        assert_eq!(store.acknowledge("one", "fast", after).unwrap(), 10_022);
+        assert_eq!(count(&store), 10_022);
+        assert_eq!(store.acknowledge("one", "slow", 10).unwrap(), 10);
+        assert_eq!(count(&store), 10_012);
+        assert_eq!(store.acknowledge("one", "slow", 0).unwrap(), 10);
+        assert_eq!(
+            store
+                .required_consumer("one", "slow")
+                .unwrap()
+                .acknowledged_cursor,
+            "10"
+        );
+        assert_eq!(
+            store
+                .register_required_consumer("one", "slow", 0)
+                .unwrap()
+                .acknowledged_cursor,
+            "10"
+        );
+        assert_eq!(
+            store.consumer_events("one", "slow", None, 1).unwrap().0[0].cursor,
+            "11"
+        );
+    }
+
+    #[test]
+    fn failed_fetch_and_ack_leave_progress_and_retention_unchanged() {
+        let (_temp, store) = fixture();
+        store
+            .register_required_consumer("one", "required", 0)
+            .unwrap();
+        publish(&store, 10_002);
+        store.control("one", |db| {
+            db.execute_batch("CREATE TRIGGER reject_consumer_update BEFORE UPDATE ON required_event_consumers BEGIN SELECT RAISE(ABORT,'synthetic failure'); END;")?;
+            Ok(())
+        }).unwrap();
+        assert!(store.consumer_events("one", "required", None, 2).is_err());
+        assert_eq!(
+            store
+                .required_consumer("one", "required")
+                .unwrap()
+                .delivered_cursor,
+            "0"
+        );
+        assert!(store.acknowledge("one", "required", 1).is_err());
+        store
+            .control("one", |db| {
+                db.execute_batch("DROP TRIGGER reject_consumer_update;")?;
+                Ok(())
+            })
+            .unwrap();
+        store.consumer_events("one", "required", None, 2).unwrap();
+        store.control("one", |db| {
+            db.execute_batch("CREATE TRIGGER reject_prune BEFORE DELETE ON events BEGIN SELECT RAISE(ABORT,'synthetic failure'); END;")?;
+            Ok(())
+        }).unwrap();
+        assert!(store.acknowledge("one", "required", 2).is_err());
+        assert_eq!(
+            store
+                .required_consumer("one", "required")
+                .unwrap()
+                .acknowledged_cursor,
+            "0"
+        );
+        assert_eq!(count(&store), 10_002);
+    }
+}

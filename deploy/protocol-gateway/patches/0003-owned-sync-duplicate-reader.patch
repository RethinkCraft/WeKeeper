+++ b/packages/native-client-rust/crates/wechat-core/src/sync_duplicate_tests.rs
@@ -0,0 +1,198 @@
+//! Synthetic encrypted profiles only; no network or retained account data.
+use super::encrypted_roundtrip::{add, state};
+use super::*;
+
+fn fixture() -> (tempfile::TempDir, Arc<Store>, Arc<Core>) {
+    let temporary = tempfile::tempdir().unwrap();
+    let store = Arc::new(Store::open(&temporary.path().join("data")).unwrap());
+    store.create_account("one").unwrap();
+    let core = Core::new(store.clone(), None).unwrap();
+    core.configure_profile_format_key(&[9; 16]).unwrap();
+    core.install_login_state("one", &state(), None).unwrap();
+    core.ensure_managed_profile("one", &state()).unwrap();
+    assert!(core.owns_profile("one").unwrap());
+    (temporary, store, core)
+}
+
+fn message(sid: u64, text: &[u8]) -> SyncCommand {
+    add(1, "peer", "synthetic_self", text, sid, 100)
+}
+
+fn stage(core: &Core, id: &str, commands: Vec<SyncCommand>) {
+    let batch = wechat_protocol::wire::SyncBatch {
+        code: 0,
+        flags: 0,
+        cursor: wechat_protocol::protobuf::uint(1, 0),
+        continuation: false,
+        commands,
+    };
+    core.store
+        .stage_sync(
+            "one",
+            id,
+            &core
+                .vault
+                .seal(
+                    "one",
+                    &format!("apply:{id}"),
+                    &serde_json::to_vec(&batch).unwrap(),
+                )
+                .unwrap(),
+            &core
+                .vault
+                .seal("one", "received-cursor", &batch.cursor)
+                .unwrap(),
+        )
+        .unwrap();
+}
+
+fn committed(store: &Store) -> usize {
+    store
+        .events("one", 0, 100)
+        .unwrap()
+        .iter()
+        .filter(|event| event.kind == "message.committed")
+        .count()
+}
+
+fn rows(core: &Core) -> usize {
+    core.messages("one", "peer", None, None).unwrap()["items"]
+        .as_array()
+        .unwrap()
+        .len()
+}
+
+#[tokio::test]
+async fn same_batch_duplicates_use_no_full_profile_copies_or_extra_rows() {
+    let (_temporary, store, core) = fixture();
+    let _gate = core.lock_account("one").await.unwrap();
+    stage(
+        &core,
+        "duplicates",
+        vec![
+            message(71, b"First"),
+            message(71, b"First"),
+            message(72, b"Second"),
+            message(72, b"Second"),
+        ],
+    );
+    let before = wechat_profile::thread_snapshot_copy_stats();
+    let result = core.recover_projection("one").unwrap();
+    let after = wechat_profile::thread_snapshot_copy_stats();
+    assert_eq!(result["projectedCommands"], 4);
+    assert_eq!(result["pendingCommands"], 0);
+    assert_eq!(after.snapshots - before.snapshots, 0);
+    assert_eq!(after.copied_bytes - before.copied_bytes, 0);
+    assert_eq!(after.verified_bytes - before.verified_bytes, 0);
+    assert_eq!(rows(&core), 2);
+    assert_eq!(committed(&store), 2);
+    assert!(store.pending_sync("one").unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn duplicate_lookup_observes_canonical_write_after_cached_read() {
+    let (_temporary, store, core) = fixture();
+    let _gate = core.lock_account("one").await.unwrap();
+    core.apply_sync_command("one", &message(71, b"Before"), "first", "live")
+        .unwrap();
+    core.apply_sync_command("one", &message(71, b"Before"), "prime-cache", "catchup")
+        .unwrap();
+    let id = store
+        .events("one", 0, 100)
+        .unwrap()
+        .into_iter()
+        .find(|event| event.kind == "message.committed")
+        .unwrap()
+        .data["messageId"]
+        .as_str()
+        .unwrap()
+        .to_owned();
+    let source = crate::source_message_id(&id).unwrap();
+    let (location, _) = core.profile_location_keys("one").unwrap();
+    let database =
+        rusqlite::Connection::open(location.root().join("db_storage").join(&source.database))
+            .unwrap();
+    let password = [42u8; 32];
+    assert_eq!(
+        unsafe { rusqlite::ffi::sqlite3_key(database.handle(), password.as_ptr().cast(), 32) },
+        0
+    );
+    database
+        .execute_batch(
+            "PRAGMA cipher_compatibility=4;PRAGMA cipher_page_size=4096;PRAGMA kdf_iter=256000;",
+        )
+        .unwrap();
+    database
+        .execute(
+            &format!(
+                "UPDATE \"{}\" SET message_content=?1 WHERE local_id=?2",
+                source.table
+            ),
+            rusqlite::params!["After", source.local_id],
+        )
+        .unwrap();
+    let before = wechat_profile::thread_snapshot_copy_stats();
+    assert_eq!(
+        core.apply_sync_command("one", &message(71, b"Before"), "stale-replay", "catchup")
+            .unwrap_err()
+            .to_string(),
+        "message_identity_conflict"
+    );
+    core.apply_sync_command("one", &message(71, b"After"), "fresh-replay", "catchup")
+        .unwrap();
+    assert_eq!(
+        wechat_profile::thread_snapshot_copy_stats().snapshots,
+        before.snapshots
+    );
+    assert_eq!(rows(&core), 1);
+    assert_eq!(committed(&store), 1);
+    assert!(store.runtime("one", "stale-replay").unwrap().is_none());
+}
+
+#[tokio::test]
+async fn interrupted_event_commit_recovers_existing_row_after_restart_without_copies() {
+    let (temporary, store, core) = fixture();
+    let gate = core.lock_account("one").await.unwrap();
+    stage(&core, "interrupted", vec![message(71, b"Recover once")]);
+    let control =
+        rusqlite::Connection::open(store.root.join("accounts/one/agent/control.sqlite")).unwrap();
+    control.execute_batch("CREATE TRIGGER interrupt_commit BEFORE INSERT ON events WHEN NEW.kind='message.committed' BEGIN SELECT RAISE(ABORT,'synthetic interruption'); END;").unwrap();
+    assert_eq!(
+        core.recover_projection("one").unwrap()["pendingCommands"],
+        1
+    );
+    assert_eq!(rows(&core), 1);
+    assert_eq!(committed(&store), 0);
+    assert!(store
+        .runtime("one", "projected:interrupted:0")
+        .unwrap()
+        .is_none());
+    control
+        .execute_batch("DROP TRIGGER interrupt_commit")
+        .unwrap();
+    drop(control);
+    drop(gate);
+    drop(core);
+    drop(store);
+    let store = Arc::new(Store::open_existing(&temporary.path().join("data")).unwrap());
+    let core = Core::new(store.clone(), None).unwrap();
+    core.configure_profile_format_key(&[9; 16]).unwrap();
+    let _gate = core.lock_account("one").await.unwrap();
+    assert!(core.owns_profile("one").unwrap());
+    let before = wechat_profile::thread_snapshot_copy_stats();
+    assert_eq!(
+        core.recover_projection("one").unwrap()["projectedCommands"],
+        1
+    );
+    assert_eq!(
+        wechat_profile::thread_snapshot_copy_stats().snapshots,
+        before.snapshots
+    );
+    assert_eq!(
+        core.recover_projection("one").unwrap()["projectedCommands"],
+        0
+    );
+    assert_eq!(rows(&core), 1);
+    assert_eq!(committed(&store), 1);
+    assert!(store.pending_sync("one").unwrap().is_empty());
+}

include LICENSE README.md README_zh.md UPSTREAM.md ROADMAP.md
include pyproject.toml requirements.txt
recursive-include chatlog_keeper *.py *.c
recursive-include tests *.py *.json
recursive-include docs *.md
recursive-include deploy *.example
recursive-include examples *.toml
recursive-include scripts *.py
recursive-include .github/workflows *.yml
global-exclude *.py[cod] *.so *.key *.pem *.db *.sqlite *.dat *.log
prune .venv
prune state
prune private
prune results
prune archive
prune tools
prune wechat

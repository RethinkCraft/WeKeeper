+#[test]
+fn preserve_rechecks_every_final_stage_receipt_and_immutable_send_fence() {
+    for change in [
+        "token",
+        "block",
+        "receipt_missing",
+        "receipt_changed",
+        "client",
+        "payload",
+        "destination",
+        "owner",
+        "epoch",
+        "cipher",
+        "desired",
+        "logout",
+        "projected",
+        "journal",
+    ] {
+        let (_dir, store, intent, snapshot) = setup();
+        let staged = stage(&store, &intent, &snapshot);
+        match change {
+            "token" => store
+                .put_runtime("one", "saved-login-projection-needed", b"other-stage")
+                .unwrap(),
+            "block" => store
+                .put_runtime("one", NETWORK_BLOCKED_STATE, b"other-generation")
+                .unwrap(),
+            "receipt_missing" => store
+                .clear_runtime("one", &receipt_key(&intent.id))
+                .unwrap(),
+            "receipt_changed" => store
+                .put_runtime("one", &receipt_key(&intent.id), b"other-receipt")
+                .unwrap(),
+            "client" | "payload" | "destination" => store
+                .control("one", |db| {
+                    let sql = match change {
+                        "client" => "UPDATE outbox SET client_id='99' WHERE id=?1",
+                        "payload" => "UPDATE outbox SET payload=x'02' WHERE id=?1",
+                        _ => "UPDATE outbox SET destination='other-room' WHERE id=?1",
+                    };
+                    db.execute(sql, [&intent.id])?;
+                    Ok(())
+                })
+                .unwrap(),
+            "owner" => store
+                .put_runtime("one", "validated-generation", b"other-owner")
+                .unwrap(),
+            "epoch" => store
+                .put_runtime("one", "logout-epoch", b"other-epoch")
+                .unwrap(),
+            "cipher" => store
+                .put_runtime("one", "account-state", b"other-cipher")
+                .unwrap(),
+            "desired" => store
+                .put_runtime("one", "desired", b"disconnected")
+                .unwrap(),
+            "logout" => store.put_runtime("one", "logged-out", b"epoch").unwrap(),
+            "projected" => store
+                .put_runtime(
+                    "one",
+                    "saved-login-projected-state-generation",
+                    b"other-projection",
+                )
+                .unwrap(),
+            "journal" => store
+                .put_runtime("one", "saved-login-publication", b"other-publication")
+                .unwrap(),
+            _ => unreachable!(),
+        }
+        let cipher = store.runtime("one", "account-state").unwrap();
+        let block = store.runtime("one", NETWORK_BLOCKED_STATE).unwrap();
+        let pending = store
+            .runtime("one", "saved-login-projection-needed")
+            .unwrap();
+        let raw = store.runtime("one", &receipt_key(&intent.id)).unwrap();
+        let result = preserve(&store, &intent, &staged).unwrap();
+        assert_eq!(result.intent.state, "accepted", "{change}");
+        assert!(!result.authorization_installed, "{change}");
+        assert_eq!(
+            store.runtime("one", "account-state").unwrap(),
+            cipher,
+            "{change}"
+        );
+        assert_eq!(
+            store.runtime("one", NETWORK_BLOCKED_STATE).unwrap(),
+            block,
+            "{change}"
+        );
+        assert_eq!(
+            store
+                .runtime("one", "saved-login-projection-needed")
+                .unwrap(),
+            pending,
+            "{change}"
+        );
+        assert_eq!(
+            store.runtime("one", &receipt_key(&intent.id)).unwrap(),
+            raw,
+            "{change}"
+        );
+    }
+}

+++ b/packages/native-client-rust/crates/wechat-core/src/quote_timing.rs
@@ -0,0 +1,480 @@
+//! Optional, lossy observations. Never part of send authority or recovery.
+use serde::Serialize;
+use sha2::{Digest, Sha256};
+use std::{
+    io::Write,
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        mpsc::{self, Receiver, SyncSender},
+        Arc,
+    },
+    time::{Instant, SystemTime, UNIX_EPOCH},
+};
+
+const CAPACITY: usize = 1024;
+
+#[derive(Clone, Copy, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum Runtime {
+    Native,
+    Simulator,
+}
+
+#[derive(Clone, Copy, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum Stage {
+    Sink,
+    CommandBinding,
+    QueueTotal,
+    QueueGateWait,
+    QueueReplayCheck,
+    QueueAccountValidation,
+    ClientIdReserve,
+    SourceResolve,
+    PayloadPrepare,
+    IntentCreate,
+    AsyncScheduleWait,
+    WorkerTotal,
+    WorkerGateWait,
+    BlockingScheduleWait,
+    WorkerPrepare,
+    SourceRecheck,
+    Claim,
+    RawRpc,
+    ReceiptRetain,
+    ReceiptLoadDecode,
+    ReceiptRecovery,
+    StateValidateSeal,
+    AuthorizationPersist,
+    SavedLoginProjection,
+    ValidatedMarker,
+    FinalStatePersist,
+}
+
+#[derive(Clone, Copy, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum Outcome {
+    Ok,
+    Error,
+    Incomplete,
+    Created,
+    Replay,
+    Claimed,
+    ClaimLost,
+    Accepted,
+    Rejected,
+    Unknown,
+    Cancelled,
+    Skipped,
+    Pending,
+    Unchanged,
+    Other,
+}
+
+#[derive(Clone, Copy, Serialize)]
+#[serde(rename_all = "snake_case")]
+enum Edge {
+    Begin,
+    End,
+    Bind,
+}
+
+#[derive(Clone, Default)]
+pub(super) struct Timings(Option<Arc<Sink>>);
+
+struct Sink {
+    sender: SyncSender<Record>,
+    dropped: Arc<AtomicU64>,
+    sequence: AtomicU64,
+    origin: Instant,
+    boot_id: String,
+}
+
+#[derive(Clone, Default)]
+pub(super) struct Trace {
+    sink: Option<Arc<Sink>>,
+    runtime: Option<Runtime>,
+    command_id: Option<String>,
+    command_key_hash: Option<String>,
+    intent_id: Option<String>,
+    attempt_id: Option<String>,
+    recovery_context_missing: bool,
+}
+
+#[derive(Serialize)]
+pub(super) struct Record {
+    schema: u8,
+    event: &'static str,
+    source_tree: &'static str,
+    boot_id: String,
+    runtime: Option<Runtime>,
+    sequence: u64,
+    dropped_records: u64,
+    unix_us: u64,
+    monotonic_us: u64,
+    command_id: Option<String>,
+    command_key_hash: Option<String>,
+    intent_id: Option<String>,
+    attempt_id: Option<String>,
+    recovery_context_missing: bool,
+    stage: Stage,
+    edge: Edge,
+    duration_us: Option<u64>,
+    outcome: Option<Outcome>,
+}
+
+fn micros(value: std::time::Duration) -> u64 {
+    value.as_micros().try_into().unwrap_or(u64::MAX)
+}
+
+fn source_tree() -> &'static str {
+    let value = option_env!("WEKEEPER_GATEWAY_SOURCE_TREE").unwrap_or("");
+    if value.len() == 40 && value.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+        value
+    } else {
+        "unavailable"
+    }
+}
+
+fn private_stdout() -> Option<std::fs::File> {
+    #[cfg(unix)]
+    {
+        use std::os::{fd::AsFd, unix::fs::MetadataExt};
+        let file = std::fs::File::from(std::io::stdout().as_fd().try_clone_to_owned().ok()?);
+        let metadata = file.metadata().ok()?;
+        // SAFETY: geteuid has no arguments, pointers, or process side effects.
+        let owner = unsafe { libc::geteuid() };
+        if metadata.is_file() && metadata.mode() & 0o077 == 0 && metadata.uid() == owner {
+            return Some(file);
+        }
+    }
+    None
+}
+
+fn write_records(mut output: impl Write, receiver: Receiver<Record>, dropped: Arc<AtomicU64>) {
+    for mut record in receiver {
+        record.dropped_records = dropped.load(Ordering::Relaxed);
+        // Serialize only this closed schema, never errors or protocol values.
+        let Ok(mut bytes) = serde_json::to_vec(&record) else {
+            dropped.fetch_add(1, Ordering::Relaxed);
+            continue;
+        };
+        bytes.push(b'\n');
+        if bytes.len() > 2048 || output.write_all(&bytes).is_err() {
+            dropped.fetch_add(1, Ordering::Relaxed);
+            break;
+        }
+    }
+}
+
+impl Timings {
+    pub(super) fn from_env() -> Self {
+        if std::env::var_os("WX_QUOTE_TIMINGS").is_none_or(|value| value != "1") {
+            return Self::default();
+        }
+        let Some(output) = private_stdout() else {
+            return Self::default();
+        };
+        let (timings, receiver) = Self::channel(CAPACITY);
+        let Some(sink) = &timings.0 else {
+            return Self::default();
+        };
+        let dropped = sink.dropped.clone();
+        if std::thread::Builder::new()
+            .name("quote-timings".into())
+            .spawn(move || write_records(output, receiver, dropped))
+            .is_err()
+        {
+            return Self::default();
+        }
+        Trace {
+            sink: timings.0.clone(),
+            ..Trace::default()
+        }
+        .emit(Stage::Sink, Edge::End, Some(0), Some(Outcome::Ok));
+        timings
+    }
+
+    fn channel(capacity: usize) -> (Self, Receiver<Record>) {
+        let (sender, receiver) = mpsc::sync_channel(capacity);
+        (
+            Self(Some(Arc::new(Sink {
+                sender,
+                dropped: Arc::new(AtomicU64::new(0)),
+                sequence: AtomicU64::new(0),
+                origin: Instant::now(),
+                boot_id: uuid::Uuid::new_v4().to_string(),
+            }))),
+            receiver,
+        )
+    }
+
+    pub(super) fn command(&self, account: &str, key: &str, runtime: Runtime) -> Trace {
+        let Some(sink) = &self.0 else {
+            return Trace::default();
+        };
+        let mut hash = Sha256::new();
+        hash.update(b"wx-quote-command-v1\0");
+        for value in [account, key] {
+            hash.update((value.len() as u64).to_be_bytes());
+            hash.update(value.as_bytes());
+        }
+        Trace {
+            sink: Some(sink.clone()),
+            runtime: Some(runtime),
+            command_id: Some(uuid::Uuid::new_v4().to_string()),
+            command_key_hash: Some(format!("{:x}", hash.finalize())),
+            ..Trace::default()
+        }
+    }
+
+    pub(super) fn recovered_worker(&self, id: &str, runtime: Runtime) -> Trace {
+        if self.0.is_none() {
+            return Trace::default();
+        }
+        Trace {
+            sink: self.0.clone(),
+            runtime: Some(runtime),
+            intent_id: uuid::Uuid::parse_str(id).ok().map(|id| id.to_string()),
+            attempt_id: Some(uuid::Uuid::new_v4().to_string()),
+            recovery_context_missing: true,
+            ..Trace::default()
+        }
+    }
+
+    #[cfg(test)]
+    pub(super) fn test_channel(capacity: usize) -> (Self, Receiver<Record>) {
+        Self::channel(capacity)
+    }
+}
+
+impl Trace {
+    fn emit(&self, stage: Stage, edge: Edge, duration_us: Option<u64>, outcome: Option<Outcome>) {
+        let Some(sink) = &self.sink else {
+            return;
+        };
+        let record = Record {
+            schema: 1,
+            event: "quote_phase_timing",
+            source_tree: source_tree(),
+            boot_id: sink.boot_id.clone(),
+            runtime: self.runtime,
+            sequence: sink.sequence.fetch_add(1, Ordering::Relaxed),
+            dropped_records: sink.dropped.load(Ordering::Relaxed),
+            unix_us: micros(
+                SystemTime::now()
+                    .duration_since(UNIX_EPOCH)
+                    .unwrap_or_default(),
+            ),
+            monotonic_us: micros(sink.origin.elapsed()),
+            command_id: self.command_id.clone(),
+            command_key_hash: self.command_key_hash.clone(),
+            intent_id: self.intent_id.clone(),
+            attempt_id: self.attempt_id.clone(),
+            recovery_context_missing: self.recovery_context_missing,
+            stage,
+            edge,
+            duration_us,
+            outcome,
+        };
+        if sink.sender.try_send(record).is_err() {
+            sink.dropped.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+
+    pub(super) fn bind(&self, id: &str, outcome: Outcome) -> Self {
+        if self.sink.is_none() {
+            return Self::default();
+        }
+        let mut bound = self.clone();
+        bound.intent_id = uuid::Uuid::parse_str(id).ok().map(|id| id.to_string());
+        bound.emit(Stage::CommandBinding, Edge::Bind, None, Some(outcome));
+        bound
+    }
+
+    pub(super) fn worker(&self) -> Self {
+        if self.sink.is_none() {
+            return Self::default();
+        }
+        let mut worker = self.clone();
+        worker.attempt_id = Some(uuid::Uuid::new_v4().to_string());
+        worker
+    }
+
+    pub(super) fn span(&self, stage: Stage) -> Span {
+        let start = self.sink.as_ref().map(|_| Instant::now());
+        self.emit(stage, Edge::Begin, None, None);
+        Span {
+            trace: self.clone(),
+            stage,
+            start,
+        }
+    }
+
+    pub(super) fn measure<T, E>(
+        &self,
+        stage: Stage,
+        action: impl FnOnce() -> Result<T, E>,
+    ) -> Result<T, E> {
+        let span = self.span(stage);
+        let result = action();
+        span.result(&result);
+        result
+    }
+
+    pub(super) fn send_update<E>(
+        &self,
+        action: impl FnOnce() -> Result<wechat_store::SendIntent, E>,
+    ) -> Result<wechat_store::SendIntent, E> {
+        let span = self.span(Stage::FinalStatePersist);
+        let result = action();
+        span.send_result(&result);
+        result
+    }
+}
+
+pub(super) struct Span {
+    trace: Trace,
+    stage: Stage,
+    start: Option<Instant>,
+}
+
+impl Span {
+    pub(super) fn finish(mut self, outcome: Outcome) {
+        if let Some(start) = self.start.take() {
+            self.trace.emit(
+                self.stage,
+                Edge::End,
+                Some(micros(start.elapsed())),
+                Some(outcome),
+            );
+        }
+    }
+
+    pub(super) fn result<T, E>(self, result: &Result<T, E>) {
+        self.finish(if result.is_ok() {
+            Outcome::Ok
+        } else {
+            Outcome::Error
+        });
+    }
+
+    pub(super) fn send_result<E>(self, result: &Result<wechat_store::SendIntent, E>) {
+        self.finish(match result.as_ref().map(|intent| intent.state.as_str()) {
+            Ok("accepted") => Outcome::Accepted,
+            Ok("failed") => Outcome::Rejected,
+            Ok("needs_review") => Outcome::Unknown,
+            Ok("cancelled") => Outcome::Cancelled,
+            Ok(_) => Outcome::Other,
+            Err(_) => Outcome::Error,
+        });
+    }
+}

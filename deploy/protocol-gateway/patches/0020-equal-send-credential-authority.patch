+fn preserve_cleanup_failure_keeps_recovery_while_committing_verified_send_fact() {
+    let (_dir, store, intent, snapshot) = setup();
+    let staged = stage(&store, &intent, &snapshot);
+    store.control("one", |db| {
+        db.execute_batch("CREATE TRIGGER reject_preserve_cleanup BEFORE DELETE ON runtime WHEN OLD.key='network-blocked-state' BEGIN SELECT RAISE(ABORT,'synthetic cleanup fault'); END")?;
+        Ok(())
+    }).unwrap();
+    let result = preserve(&store, &intent, &staged).unwrap();
+    assert_eq!(result.intent.state, "accepted");
+    assert!(!result.authorization_installed);
+    assert_eq!(
+        store.runtime("one", "account-state").unwrap().as_deref(),
+        Some(OLD)
+    );
+    assert_eq!(
+        store
+            .runtime("one", "saved-login-projection-needed")
+            .unwrap()
+            .as_deref(),
+        Some(staged.token.as_slice())
+    );
+    assert_blocked(&store);
+    assert_raw(&store, &intent);
+}

+//! Native-received queue admission never reads/publishes the official profile.
+//! The original account-gated worker remains the authority for actual sending.
+use super::*;
+use crate::{
+    native_ingress_message::{ReceivedDisposition, ReceivedMessageSnapshot},
+    quote_send::ResolvedQuote,
+    QuoteSourceReference, ReceivedQuoteReference,
+};
+use wechat_store::{
+    NativeQuoteSource, NativeSendDecision, NativeSendFence, NativeSendInsert, NativeSendSnapshot,
+};
+
+fn admitted<T>(decision: NativeSendDecision<T>) -> Result<T> {
+    match decision {
+        NativeSendDecision::Accepted(value) => Ok(value),
+        NativeSendDecision::Rejected(code) => bail!(code),
+    }
+}
+fn source<'a>(thread: &'a str, reference: &'a ReceivedQuoteReference) -> NativeQuoteSource<'a> {
+    NativeQuoteSource {
+        received_id: &reference.received_id,
+        thread_id: thread,
+        server_id: &reference.server_id,
+        source_sha256: &reference.source_sha256,
+    }
+}
+impl Core {
+    pub(super) fn native_send_admission_gate(&self, account: &str) -> Result<Arc<AsyncMutex<()>>> {
+        self.store.account(account)?;
+        let mut gates = self
+            .native_send_gates
+            .lock()
+            .map_err(|_| anyhow::anyhow!("account manager unavailable"))?;
+        Ok(gates
+            .entry(account.into())
+            .or_insert_with(|| Arc::new(AsyncMutex::new(())))
+            .clone())
+    }
+    pub(super) fn native_send_snapshot(
+        &self,
+        account: &str,
+        thread: &str,
+        reference: &ReceivedQuoteReference,
+    ) -> Result<NativeSendSnapshot> {
+        QuoteSourceReference::Received(reference.clone()).validate()?;
+        anyhow::ensure!(self.owns_profile(account)?, "profile_ownership_required");
+        admitted(self.store.native_send_admission_snapshot(
+            account,
+            &self.ownership_generation,
+            source(thread, reference),
+        )?)
+    }
+    pub(super) fn native_send_state(
+        &self,
+        account: &str,
+        encrypted: &[u8],
+    ) -> Result<AccountState> {
+        let raw = self
+            .vault
+            .open_record(account, "account-state", encrypted)?;
+        let state: AccountState = serde_json::from_slice(&raw)
+            .map_err(|_| anyhow::anyhow!("invalid protected account state"))?;
+        state.validate()?;
+        Ok(state)
+    }
+    pub(super) fn resolve_native_send_quote(
+        &self,
+        account: &str,
+        thread: &str,
+        text: &str,
+        target: &QuoteSourceReference,
+        own: &str,
+        record: &wechat_store::NativeIngressRecord,
+    ) -> Result<ResolvedQuote> {
+        let QuoteSourceReference::Received(reference) = target else {
+            bail!("invalid_quote_reference");
+        };
+        let raw = self.vault.open_record(
+            account,
+            &format!("native-received:{}", reference.received_id),
+            &record.sealed_snapshot,
+        )?;
+        let snapshot: ReceivedMessageSnapshot = serde_json::from_slice(&raw)?;
+        anyhow::ensure!(
+            snapshot.schema_version == 1
+                && snapshot.account_id == account
+                && snapshot.own_username == own
+                && snapshot.thread_id.as_deref() == Some(thread)
+                && snapshot.server_id.as_deref() == Some(reference.server_id.as_str())
+                && snapshot.source_sha256 == reference.source_sha256
+                && snapshot.source_sha256 == record.source_sha256,
+            "quote_target_mismatch"
+        );
+        anyhow::ensure!(
+            record.disposition == "ready" && snapshot.disposition == ReceivedDisposition::Ready,
+            "quote_target_unavailable"
+        );
+        let quote = snapshot
+            .quote_reference
+            .context("quote_target_unavailable")?;
+        Ok(ResolvedQuote {
+            target: target.clone(),
+            xml: wechat_protocol::quote_send::quote_xml(own, text, &quote)?,
+        })
+    }
+    pub(super) fn create_native_send(
+        &self,
+        account: &str,
+        send: NativeSendInsert<'_>,
+        reference: &ReceivedQuoteReference,
+        snapshot: &NativeSendSnapshot,
+        original: &AccountState,
+    ) -> Result<(SendIntent, bool)> {
+        let thread = send.destination;
+        admitted(self.store.create_native_received_send(
+            account,
+            send,
+            NativeSendFence {
+                owner: &self.ownership_generation,
+                logout_epoch: snapshot.logout_epoch.as_deref(),
+                source: source(thread, reference),
+                sealed_snapshot: &snapshot.source.sealed_snapshot,
+            },
+            |cipher| {
+                let current = self.native_send_state(account, cipher)?;
+                Ok(current.uin == original.uin
+                    && current.own_username == original.own_username
+                    && current.device.device_id == original.device.device_id
+                    && current.device.device_type == original.device.device_type
+                    && current.device.client_version == original.device.client_version)
+            },
+        )?)
+    }
+}

+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn fixture() -> (tempfile::TempDir, Store) {
+        let temp = tempfile::tempdir().unwrap();
+        let store = Store::open(&temp.path().join("data")).unwrap();
+        store.create_account("one").unwrap();
+        (temp, store)
+    }
+    fn item(id: &str, disposition: &str) -> NativeIngressMessageInput {
+        NativeIngressMessageInput {
+            received_id: id.into(),
+            command_index: 0,
+            thread_id: Some("room@chatroom".into()),
+            server_id: Some(id.into()),
+            disposition: disposition.into(),
+            reason: (disposition == "quarantined").then(|| "unsupported_received_type".into()),
+            source_sha256: "a".repeat(64),
+            identity_fingerprint: "b".repeat(64),
+            sealed_snapshot: b"sealed native snapshot".to_vec(),
+        }
+    }
+    fn batch(
+        id: &str,
+        terminal: bool,
+        messages: Vec<NativeIngressMessageInput>,
+    ) -> NativeIngressBatch {
+        NativeIngressBatch {
+            batch_id: id.into(),
+            payload: Some(b"sealed raw batch".to_vec()),
+            cursor: Some(format!("cursor:{id}").into_bytes()),
+            ownership_generation: "generation-one".into(),
+            historical: false,
+            caught_up: terminal,
+            origin: "live".into(),
+            messages,
+            recalls: vec![],
+        }
+    }
+    #[test]
+    fn native_receive_rolls_back_raw_cursor_messages_and_events_together() {
+        let (_temp, store) = fixture();
+        store.control("one",|db| {db.execute_batch("CREATE TRIGGER fail_receive BEFORE INSERT ON events WHEN NEW.kind='message.received' BEGIN SELECT RAISE(ABORT,'synthetic interruption'); END;")?;Ok(())}).unwrap();
+        assert!(store
+            .stage_native_ingress("one", batch("a", true, vec![item("71", "ready")]))
+            .is_err());
+        assert_eq!(store.pending_sync_count("one").unwrap(), 0);
+        assert!(store.runtime("one", "received-cursor").unwrap().is_none());
+        assert!(store.native_ingress_record("one", "71").is_err());
+        assert!(store.events("one", 0, 100).unwrap().is_empty());
+        assert!(store
+            .activate_native_consumer("one", "bot", "self", "generation-one")
+            .is_err());
+    }
+    #[test]
+    fn native_activation_ignores_profile_backlog_but_requires_current_receive_fence() {
+        let (_temp, store) = fixture();
+        store
+            .stage_sync("one", "old", b"old raw", b"old cursor")
+            .unwrap();
+        store.block_sync("one", "old").unwrap();
+        let mut old = batch("old", false, vec![item("71", "quarantined")]);
+        old.payload = None;
+        old.cursor = None;
+        old.historical = true;
+        assert_eq!(store.stage_native_ingress("one", old).unwrap(), "1");
+        assert!(store
+            .activate_native_consumer("one", "bot", "self", "generation-one")
+            .is_err());
+        store
+            .stage_native_ingress("one", batch("terminal", true, vec![]))
+            .unwrap();
+        let activation = store
+            .activate_native_consumer("one", "bot", "self", "generation-one")
+            .unwrap();
+        assert_eq!(activation["checkpoint"]["receivedBoundary"], "2");
+        assert_eq!(store.pending_sync_count("one").unwrap(), 2);
+        assert!(store.pending_cursor_projection("one").unwrap());
+        store
+            .stage_native_ingress("one", batch("future", true, vec![item("72", "ready")]))
+            .unwrap();
+        let replay = store
+            .activate_native_consumer("one", "bot", "self", "generation-two")
+            .unwrap();
+        assert_eq!(activation["checkpoint"], replay["checkpoint"]);
+        let (page, _) = store.consumer_events("one", "bot", None, 100).unwrap();
+        assert_eq!(page.len(), 1);
+        assert_eq!(page[0].data["receivedId"], "72");
+        store
+            .acknowledge("one", "bot", page[0].cursor.parse().unwrap())
+            .unwrap();
+        assert_eq!(
+            store
+                .native_ingress_record("one", "71")
+                .unwrap()
+                .disposition,
+            "quarantined"
+        );
+        assert!(store.native_ingress_record("one", "72").is_ok());
+        assert!(store
+            .activate_native_consumer("one", "other", "self", "generation-two")
+            .is_err());
+        let mut replay = batch("future", true, vec![item("72", "ready")]);
+        replay.ownership_generation = "generation-two".into();
+        store.stage_native_ingress("one", replay).unwrap();
+        assert!(store
+            .activate_native_consumer("one", "other", "self", "generation-two")
+            .is_ok());
+    }
+    #[test]
+    fn logout_and_new_login_invalidate_fence_but_preserve_existing_cutover() {
+        let (_temp, store) = fixture();
+        store
+            .stage_native_ingress("one", batch("terminal", true, vec![]))
+            .unwrap();
+        let original = store
+            .activate_native_consumer("one", "existing", "self", "generation-one")
+            .unwrap();
+        let op = Operation {
+            id: "logout-test".into(),
+            account_id: "one".into(),
+            kind: "logout".into(),
+            state: "queued".into(),
+            result: Value::Null,
+            created_at: "2026-01-01T00:00:00Z".into(),
+            updated_at: "2026-01-01T00:00:00Z".into(),
+        };
+        store.begin_logout(&op, b"epoch").unwrap();
+        assert!(store
+            .activate_native_consumer("one", "new", "self", "generation-one")
+            .is_err());
+        assert_eq!(
+            store
+                .activate_native_consumer("one", "existing", "self", "generation-one")
+                .unwrap()["checkpoint"],
+            original["checkpoint"]
+        );
+        // A new accepted login independently clears stale same-process evidence.
+        store
+            .put_runtime("one", "native-ingress-caught-up", b"generation-one")
+            .unwrap();
+        store
+            .commit_login_authorization("one", b"sealed-auth", Some(b"epoch"), "generation-one")
+            .unwrap();
+        assert!(store
+            .activate_native_consumer("one", "new", "self", "generation-one")
+            .is_err());
+        store
+            .stage_native_ingress("one", batch("fresh-terminal", true, vec![]))
+            .unwrap();
+        assert!(store
+            .activate_native_consumer("one", "new", "self", "generation-one")
+            .is_ok());
+    }
+    #[test]
+    fn accepted_projection_rotation_cannot_starve_after_a_full_page_of_failures() {
+        let (temp, store) = fixture();
+        store.control("one", |db| {
+            for index in 0..103 {
+                let id=format!("send-{index:03}");
+                db.execute("INSERT INTO outbox VALUES(?1,?1,'hash','peer',x'01','accepted',?2,?2,NULL,'2026-01-01T00:00:00Z')",params![id,(index+1).to_string()])?;
+            }
+            Ok(())
+        }).unwrap();
+        for index in 0..102 {
+            assert_eq!(
+                store.next_pending_text_projection("one").unwrap(),
+                Some(format!("send-{index:03}"))
+            );
+        }
+        drop(store);
+        let store = Store::open_existing(&temp.path().join("data")).unwrap();
+        assert_eq!(
+            store
+                .next_pending_text_projection("one")
+                .unwrap()
+                .as_deref(),
+            Some("send-102")
+        );
+        assert_eq!(
+            store
+                .next_pending_text_projection("one")
+                .unwrap()
+                .as_deref(),
+            Some("send-000")
+        );
+        assert_eq!(store.send("one", "send-000").unwrap().state, "accepted");
+        store
+            .put_runtime("one", "send-projected:send-001", b"synthetic-local-id")
+            .unwrap();
+        assert_eq!(
+            store
+                .next_pending_text_projection("one")
+                .unwrap()
+                .as_deref(),
+            Some("send-002")
+        );
+    }
+    #[test]
+    fn later_continuation_invalidates_a_prior_caught_up_fence() {
+        let (_temp, store) = fixture();
+        store
+            .stage_native_ingress("one", batch("terminal", true, vec![]))
+            .unwrap();
+        let existing = store
+            .activate_native_consumer("one", "existing", "self", "generation-one")
+            .unwrap();
+        store
+            .stage_native_ingress(
+                "one",
+                batch("continuation", false, vec![item("71", "ready")]),
+            )
+            .unwrap();
+        assert!(store
+            .activate_native_consumer("one", "new", "self", "generation-one")
+            .is_err());
+        assert_eq!(
+            store
+                .activate_native_consumer("one", "existing", "self", "generation-one")
+                .unwrap()["checkpoint"],
+            existing["checkpoint"]
+        );
+        store
+            .stage_native_ingress("one", batch("next-terminal", true, vec![]))
+            .unwrap();
+        assert_eq!(
+            store
+                .activate_native_consumer("one", "new", "self", "generation-one")
+                .unwrap()["checkpoint"]["receivedBoundary"],
+            "3"
+        );
+    }
+    #[test]
+    fn repeated_native_identity_preserves_first_seal_sequence_and_conflicts_are_visible() {
+        let (temp, store) = fixture();
+        store
+            .stage_native_ingress("one", batch("first", true, vec![item("71", "ready")]))
+            .unwrap();
+        let original = store.native_ingress_record("one", "71").unwrap();
+        store
+            .stage_native_ingress("one", batch("duplicate", true, vec![item("71", "ready")]))
+            .unwrap();
+        assert_eq!(store.events("one", 0, 100).unwrap().len(), 1);
+        let mut changed = item("71", "ready");
+        changed.identity_fingerprint = "c".repeat(64);
+        changed.sealed_snapshot = b"different snapshot".to_vec();
+        store
+            .stage_native_ingress("one", batch("conflict", true, vec![changed]))
+            .unwrap();
+        drop(store);
+        let store = Store::open_existing(&temp.path().join("data")).unwrap();
+        let actual = store.native_ingress_record("one", "71").unwrap();
+        assert_eq!(
+            actual.first_received_sequence,
+            original.first_received_sequence
+        );
+        assert_eq!(actual.sealed_snapshot, original.sealed_snapshot);
+        assert_eq!(
+            actual.reason.as_deref(),
+            Some("native_message_identity_conflict")
+        );
+        let events = store.events("one", 0, 100).unwrap();
+        assert_eq!(events.len(), 2);
+        assert_eq!(events[1].data["firstReceivedSequence"], "1");
+    }
+    #[test]
+    fn recall_marker_and_quarantine_commit_before_any_profile_write() {
+        let (_temp, store) = fixture();
+        let mut incoming = batch("with-recall", true, vec![item("71", "ready")]);
+        incoming.recalls.push(NativeIngressRecallInput {
+            thread_id: "room@chatroom".into(),
+            server_id: "71".into(),
+            recalled_at: Some(100),
+            control_receipt: "projected:with-recall:1".into(),
+            sealed_control: b"sealed control".to_vec(),
+        });
+        store.stage_native_ingress("one", incoming).unwrap();
+        assert!(store
+            .recall_marker("one", "room@chatroom", "71")
+            .unwrap()
+            .is_some());
+        assert_eq!(
+            store
+                .native_ingress_record("one", "71")
+                .unwrap()
+                .reason
+                .as_deref(),
+            Some("message_recalled")
+        );
+        assert_eq!(store.pending_sync_count("one").unwrap(), 1);
+    }

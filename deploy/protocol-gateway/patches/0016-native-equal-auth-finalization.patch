+struct InvalidEqualReply(Arc<EqualNative>);
+impl crate::upstream::Upstream for InvalidEqualReply {
+    fn kind(&self) -> crate::upstream::UpstreamKind {
+        crate::upstream::UpstreamKind::Native
+    }
+    fn send_quote_raw(
+        &self,
+        state: &mut AccountState,
+        destination: &str,
+        client_id: &str,
+        created_at: u32,
+        content: &str,
+    ) -> Result<Vec<u8>> {
+        let _ = self
+            .0
+            .send_quote_raw(state, destination, client_id, created_at, content)?;
+        // Valid status alone is insufficient: destination/client/server missing.
+        Ok(wechat_protocol::protobuf::bytes(
+            1,
+            &wechat_protocol::protobuf::int32(1, 0),
+        ))
+    }
+}

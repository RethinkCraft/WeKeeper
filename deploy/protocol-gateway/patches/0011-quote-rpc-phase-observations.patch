+fn rpc_stage(phase: wechat_protocol::rpc_observation::Phase) -> Stage {
+    use wechat_protocol::rpc_observation::Phase;
+    match phase {
+        Phase::QuoteRequestPrepare => Stage::QuoteRequestPrepare,
+        Phase::SessionConnect => Stage::RpcSessionConnect,
+        Phase::DnsTcpConnect => Stage::RpcDnsTcpConnect,
+        Phase::MmtlsHandshake => Stage::RpcMmtlsHandshake,
+        Phase::AuthenticatedPacketPrepare => Stage::RpcAuthenticatedPacketPrepare,
+        Phase::ShortPacketPrepare => Stage::RpcShortPacketPrepare,
+        Phase::HttpClientPrepare => Stage::RpcHttpClientPrepare,
+        Phase::ShortHttp => Stage::RpcShortHttp,
+        Phase::MmtlsReplyDecode => Stage::RpcMmtlsReplyDecode,
+        Phase::AuthenticatedReplyDecode => Stage::RpcAuthenticatedReplyDecode,
+    }
+}
+
+impl wechat_protocol::rpc_observation::Observer for Trace {
+    fn begin(&self, phase: wechat_protocol::rpc_observation::Phase) {
+        self.emit(rpc_stage(phase), Edge::Begin, None, None);
+    }
+    fn end(
+        &self,
+        phase: wechat_protocol::rpc_observation::Phase,
+        duration: std::time::Duration,
+        outcome: wechat_protocol::rpc_observation::Outcome,
+    ) {
+        use wechat_protocol::rpc_observation::Outcome as RpcOutcome;
+        let outcome = match outcome {
+            RpcOutcome::Ok => Outcome::Ok,
+            RpcOutcome::Error => Outcome::Error,
+            RpcOutcome::Incomplete => Outcome::Incomplete,
+        };
+        self.emit(
+            rpc_stage(phase),
+            Edge::End,
+            Some(micros(duration)),
+            Some(outcome),
+        );
+    }
+}

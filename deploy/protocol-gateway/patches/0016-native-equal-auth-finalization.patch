@@ -0,0 +1,562 @@
+use super::*;
+include!("post_rpc_fixture.rs");
+
+#[tokio::test]
+async fn complete_equal_native_quote_coalesces_standalone_authorization_commit() {
+    let f = equal_fixture(false);
+    let old = f
+        .core
+        .store
+        .runtime("one", "account-state")
+        .unwrap()
+        .unwrap();
+    let (sent, rows) = perform_equal_fixture(&f, "equal-coalesced").await;
+    assert_eq!(sent.state, "accepted");
+    assert_eq!(sent.server_id.as_deref(), Some("99"));
+    assert_eq!(f.native.calls.load(Ordering::SeqCst), 1);
+    assert!(f
+        .core
+        .store
+        .runtime("one", &format!("quote-receipt:{}", sent.id))
+        .unwrap()
+        .is_some());
+    let current = f
+        .core
+        .store
+        .runtime("one", "account-state")
+        .unwrap()
+        .unwrap();
+    assert_ne!(
+        old, current,
+        "equal plaintext still rotates the Push CAS generation"
+    );
+    assert_eq!(
+        serde_json::to_vec(&f.core.account_state("one").unwrap()).unwrap(),
+        serde_json::to_vec(&f.state).unwrap()
+    );
+    let authorizations = rows
+        .iter()
+        .filter(|row| row["stage"] == "authorization_persist" && row["edge"] == "begin")
+        .count();
+    assert_eq!(
+        authorizations, 0,
+        "complete equal-state quote should not use a standalone auth FULL"
+    );
+}
+
+fn auth_begins(rows: &[Value]) -> usize {
+    rows.iter()
+        .filter(|row| row["stage"] == "authorization_persist" && row["edge"] == "begin")
+        .count()
+}
+fn synthetic_control(core: &Core) -> rusqlite::Connection {
+    rusqlite::Connection::open(core.store.root.join("accounts/one/agent/control.sqlite")).unwrap()
+}
+
+#[tokio::test]
+async fn changed_cookie_retains_the_original_authorization_and_profile_path() {
+    let f = equal_fixture(true);
+    let (sent, rows) = perform_equal_fixture(&f, "changed-cookie").await;
+    assert_eq!(sent.state, "accepted");
+    assert_eq!(auth_begins(&rows), 1);
+    assert_eq!(f.core.account_state("one").unwrap().cookie, vec![8; 15]);
+    assert!(f
+        .core
+        .store
+        .runtime("one", "network-blocked-state")
+        .unwrap()
+        .is_none());
+    assert!(!rows.iter().any(|row| row["stage"] == "equal_state_final"));
+    assert_eq!(f.native.calls.load(Ordering::SeqCst), 1);
+}
+
+#[tokio::test]
+async fn preexisting_projection_work_uses_the_original_authorization_path() {
+    let f = equal_fixture(false);
+    f.core
+        .store
+        .put_runtime("one", "saved-login-projection-needed", b"preexisting")
+        .unwrap();
+    let (sent, rows) = perform_equal_fixture(&f, "prior-projection").await;
+    assert_eq!(sent.state, "accepted");
+    assert_eq!(auth_begins(&rows), 1);
+    assert!(!rows.iter().any(|row| row["stage"] == "equal_state_final"));
+    assert!(f
+        .core
+        .store
+        .runtime("one", "network-blocked-state")
+        .unwrap()
+        .is_none());
+}
+
+#[tokio::test]
+async fn optional_raw_metadata_failure_keeps_the_receipt_and_fenced_old_path() {
+    let f = equal_fixture(false);
+    synthetic_control(&f.core).execute_batch("CREATE TRIGGER reject_equal_block BEFORE INSERT ON runtime WHEN NEW.key='network-blocked-state' BEGIN SELECT RAISE(ABORT,'synthetic block metadata failure'); END;").unwrap();
+    let (sent, rows) = perform_equal_fixture(&f, "metadata-failure").await;
+    assert_eq!(sent.state, "accepted");
+    assert_eq!(auth_begins(&rows), 1);
+    assert!(f
+        .core
+        .store
+        .runtime("one", &format!("quote-receipt:{}", sent.id))
+        .unwrap()
+        .is_some());
+    assert!(f
+        .core
+        .store
+        .runtime("one", "network-blocked-state")
+        .unwrap()
+        .is_none());
+    assert_eq!(f.native.calls.load(Ordering::SeqCst), 1);
+}
+
+#[tokio::test]
+async fn failed_final_auth_keeps_old_push_blocked_then_manual_disconnected_repairs_locally() {
+    let f = equal_fixture(false);
+    let old = f
+        .core
+        .store
+        .runtime("one", "account-state")
+        .unwrap()
+        .unwrap();
+    synthetic_control(&f.core).execute_batch("CREATE TRIGGER reject_equal_auth BEFORE UPDATE ON runtime WHEN NEW.key='account-state' BEGIN SELECT RAISE(ABORT,'synthetic auth metadata failure'); END;").unwrap();
+    let (sent, rows) = perform_equal_fixture(&f, "final-auth-failure").await;
+    assert_eq!(sent.state, "accepted");
+    assert_eq!(
+        f.core
+            .store
+            .runtime("one", "account-state")
+            .unwrap()
+            .unwrap(),
+        old
+    );
+    assert!(rows.iter().any(|row| row["stage"] == "equal_state_final"
+        && row["edge"] == "end"
+        && row["outcome"] == "skipped"));
+    assert!(f
+        .core
+        .store
+        .runtime("one", "network-blocked-state")
+        .unwrap()
+        .is_some());
+    assert!(f
+        .core
+        .store
+        .save_network_authorization("one", b"stale push result", &old, None, Some(b"connected"))
+        .is_err());
+    synthetic_control(&f.core)
+        .execute_batch("DROP TRIGGER reject_equal_auth")
+        .unwrap();
+    f.core
+        .store
+        .put_runtime("one", "desired", b"disconnected")
+        .unwrap();
+    let owner = f.core.store.runtime("one", "validated-generation").unwrap();
+    let calls = f.native.calls.load(Ordering::SeqCst);
+    f.core
+        .session_request("one", "manual-test", |_fence| async { Ok(()) })
+        .await
+        .unwrap();
+    assert_eq!(
+        f.native.calls.load(Ordering::SeqCst),
+        calls,
+        "local repair must not send an RPC"
+    );
+    let fresh = f
+        .core
+        .store
+        .runtime("one", "account-state")
+        .unwrap()
+        .unwrap();
+    assert_ne!(fresh, old);
+    assert!(f
+        .core
+        .store
+        .runtime("one", "network-blocked-state")
+        .unwrap()
+        .is_none());
+    assert!(f
+        .core
+        .store
+        .runtime("one", "saved-login-projection-needed")
+        .unwrap()
+        .is_none());
+    assert_eq!(
+        f.core.store.runtime("one", "desired").unwrap().as_deref(),
+        Some(b"disconnected".as_slice())
+    );
+    assert_eq!(
+        f.core.store.runtime("one", "validated-generation").unwrap(),
+        owner
+    );
+    assert!(f
+        .core
+        .store
+        .save_network_authorization(
+            "one",
+            b"stale push result",
+            &old,
+            None,
+            Some(b"disconnected")
+        )
+        .is_err());
+}
+
+#[tokio::test]
+async fn startup_rotates_blocked_state_before_finishing_its_pending_profile_verification() {
+    let f = equal_fixture(false);
+    let old = f
+        .core
+        .store
+        .runtime("one", "account-state")
+        .unwrap()
+        .unwrap();
+    let old_owner = f.core.store.runtime("one", "validated-generation").unwrap();
+    f.core
+        .store
+        .put_runtime(
+            "one",
+            "network-blocked-state",
+            format!("{:x}", Sha256::digest(&old)).as_bytes(),
+        )
+        .unwrap();
+    f.core
+        .store
+        .put_runtime(
+            "one",
+            "saved-login-projection-needed",
+            b"equal-send:synthetic-interruption",
+        )
+        .unwrap();
+    let store = f.core.store.clone();
+    let native = f.native.clone();
+    drop(f.core);
+    let restarted = Core::with_upstream(store.clone(), None, native.clone()).unwrap();
+    assert_ne!(
+        restarted.ownership_generation.as_bytes(),
+        old_owner.as_deref().unwrap()
+    );
+    assert_eq!(
+        store.runtime("one", "validated-generation").unwrap(),
+        old_owner,
+        "local repair does not activate a new owner"
+    );
+    assert_ne!(store.runtime("one", "account-state").unwrap().unwrap(), old);
+    assert!(store
+        .runtime("one", "network-blocked-state")
+        .unwrap()
+        .is_none());
+    assert!(store
+        .runtime("one", "saved-login-projection-needed")
+        .unwrap()
+        .is_none());
+    assert_eq!(native.calls.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn owner_superseded_at_raw_retention_preserves_new_owner_and_send_facts() {

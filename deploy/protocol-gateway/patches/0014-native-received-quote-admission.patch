+//! Local custody for sealed received-message quotes, fenced at the insert.
+//! Official profile validation and all network work remain in the send worker.
+use crate::*;
+use rusqlite::{OptionalExtension, Transaction};
+
+pub enum NativeSendDecision<T> {
+    Accepted(T),
+    Rejected(&'static str),
+}
+pub struct NativeQuoteSource<'a> {
+    pub received_id: &'a str,
+    pub thread_id: &'a str,
+    pub server_id: &'a str,
+    pub source_sha256: &'a str,
+}
+pub struct NativeSendSnapshot {
+    pub state_cipher: Vec<u8>,
+    pub logout_epoch: Option<Vec<u8>>,
+    pub source: NativeIngressRecord,
+}
+pub struct NativeSendInsert<'a> {
+    pub key: &'a str,
+    pub destination: &'a str,
+    pub hash: &'a str,
+    pub encrypted: &'a [u8],
+    pub client_id: &'a str,
+}
+pub struct NativeSendFence<'a> {
+    pub owner: &'a str,
+    pub logout_epoch: Option<&'a [u8]>,
+    pub source: NativeQuoteSource<'a>,
+    pub sealed_snapshot: &'a [u8],
+}
+
+fn value(tx: &Transaction<'_>, key: &str) -> Result<Option<Vec<u8>>> {
+    Ok(tx
+        .query_row("SELECT value FROM runtime WHERE key=?1", [key], |r| {
+            r.get(0)
+        })
+        .optional()?)
+}
+fn accepted_state(tx: &Transaction<'_>, owner: &str) -> Result<Option<Vec<u8>>> {
+    let Some(cipher) = value(tx, "account-state")? else {
+        return Ok(None);
+    };
+    let generation = format!("{:x}", Sha256::digest(&cipher));
+    if value(tx, "logged-out")?.is_some()
+        || value(tx, "desired")?.as_deref() != Some(b"connected")
+        || value(tx, "validated-generation")?.as_deref() != Some(owner.as_bytes())
+        || value(tx, "saved-login-accepted-state-generation")?.as_deref()
+            != Some(generation.as_bytes())
+    {
+        return Ok(None);
+    }
+    Ok(Some(cipher))
+}
+fn source_record(
+    tx: &Transaction<'_>,
+    source: &NativeQuoteSource<'_>,
+) -> Result<Option<NativeIngressRecord>> {
+    Ok(tx.query_row(
+        "SELECT received_id,first_received_sequence,disposition,reason,source_sha256,sealed_snapshot FROM native_ingress_messages WHERE received_id=?1 AND thread_id=?2 AND server_id=?3 AND source_sha256=?4 AND disposition='ready'",
+        params![source.received_id,source.thread_id,source.server_id,source.source_sha256],
+        |r| Ok(NativeIngressRecord {received_id:r.get(0)?,first_received_sequence:r.get::<_,i64>(1)?.to_string(),disposition:r.get(2)?,reason:r.get(3)?,source_sha256:r.get(4)?,sealed_snapshot:r.get(5)?})
+    ).optional()?)
+}
+fn recalled(tx: &Transaction<'_>, source: &NativeQuoteSource<'_>) -> Result<bool> {
+    Ok(tx.query_row(
+        "SELECT EXISTS(SELECT 1 FROM message_recalls WHERE thread_id=?1 AND server_id=?2)",
+        params![source.thread_id, source.server_id],
+        |r| r.get(0),
+    )?)
+}
+
+impl Store {
+    /// The snapshot is local accepted identity, not proof that profile files are
+    /// currently readable. The original worker must still make that proof.
+    pub fn native_send_admission_snapshot(
+        &self,
+        account: &str,
+        owner: &str,
+        source: NativeQuoteSource<'_>,
+    ) -> Result<NativeSendDecision<NativeSendSnapshot>> {
+        self.control(account, |db| {
+            let tx = db.transaction()?;
+            let Some(state_cipher) = accepted_state(&tx, owner)? else {
+                return Ok(NativeSendDecision::Rejected("auth_required"));
+            };
+            let Some(record) = source_record(&tx, &source)? else {
+                return Ok(NativeSendDecision::Rejected("quote_target_unavailable"));
+            };
+            if recalled(&tx, &source)? {
+                return Ok(NativeSendDecision::Rejected("message_recalled"));
+            }
+            let logout_epoch = value(&tx, "logout-epoch")?;
+            Ok(NativeSendDecision::Accepted(NativeSendSnapshot {
+                state_cipher,
+                logout_epoch,
+                source: record,
+            }))
+        })
+    }
+
+    /// `same_identity` only decrypts and compares the current accepted identity;
+    /// it must not access Store, the profile, or a network. Cookie rotation is
+    /// permitted. Expected fence denials stay Ok inside control to retain its
+    /// admitted writer. Real integrity/SQL/family errors still fail normally.
+    pub fn create_native_received_send(
+        &self,
+        account: &str,
+        send: NativeSendInsert<'_>,
+        fence: NativeSendFence<'_>,
+        same_identity: impl FnOnce(&[u8]) -> Result<bool>,
+    ) -> Result<NativeSendDecision<(SendIntent, bool)>> {
+        self.control(account, |db| {
+            if send.key.is_empty()
+                || send.key.len() > 200
+                || send.destination.is_empty()
+                || send.destination.len() > 256
+            {
+                bail!("invalid send intent");
+            }
+            let tx = db.transaction()?;
+            let media_conflict: bool = tx.query_row(
+                "SELECT EXISTS(SELECT 1 FROM media_jobs WHERE idempotency_key=?1)",
+                [format!("send:{}", send.key)],
+                |r| r.get(0),
+            )?;
+            if media_conflict {
+                bail!("idempotency_conflict");
+            }
+            let existing: Option<(String, String)> = tx
+                .query_row(
+                    "SELECT id,payload_hash FROM outbox WHERE idempotency_key=?1",
+                    [send.key],
+                    |r| Ok((r.get(0)?, r.get(1)?)),
+                )
+                .optional()?;
+            // Replay precedes every fresh-admission fence, including logout.
+            if let Some((id, hash)) = existing {
+                if hash != send.hash {
+                    bail!("idempotency_conflict");
+                }
+                return Ok(NativeSendDecision::Accepted((
+                    crate::read_send(&tx, account, &id)?,
+                    false,
+                )));
+            }
+            let Some(cipher) = accepted_state(&tx, fence.owner)? else {
+                return Ok(NativeSendDecision::Rejected(
+                    "authorization_generation_changed",
+                ));
+            };
+            if value(&tx, "logout-epoch")?.as_deref() != fence.logout_epoch
+                || !same_identity(&cipher)?
+            {
+                return Ok(NativeSendDecision::Rejected(
+                    "authorization_generation_changed",
+                ));
+            }
+            if send.destination != fence.source.thread_id {
+                return Ok(NativeSendDecision::Rejected("quote_target_mismatch"));
+            }
+            let Some(source) = source_record(&tx, &fence.source)? else {
+                return Ok(NativeSendDecision::Rejected("quote_target_unavailable"));
+            };
+            if source.sealed_snapshot != fence.sealed_snapshot {
+                return Ok(NativeSendDecision::Rejected("quote_target_mismatch"));
+            }
+            if recalled(&tx, &fence.source)? {
+                return Ok(NativeSendDecision::Rejected("message_recalled"));
+            }
+            crate::client_ids::check_client_id(&tx, send.key, send.client_id)?;
+            let id = uuid::Uuid::new_v4().to_string();
+            let now = chrono::Utc::now().to_rfc3339();
+            tx.execute(
+                "INSERT INTO outbox VALUES(?1,?2,?3,?4,?5,'queued',?6,NULL,NULL,?7)",
+                params![
+                    id,
+                    send.key,
+                    send.hash,
+                    send.destination,
+                    send.encrypted,
+                    send.client_id,
+                    now
+                ],
+            )?;
+            let intent = crate::read_send(&tx, account, &id)?;
+            tx.execute(
+                "INSERT INTO events(kind,data_json,created_at)VALUES('send.updated',?1,?2)",
+                params![
+                    serde_json::to_string(&intent)?,
+                    chrono::Utc::now().to_rfc3339()
+                ],
+            )?;
+            crate::event_consumers::prune_events(&tx, tx.last_insert_rowid())?;
+            tx.commit()?;
+            Ok(NativeSendDecision::Accepted((intent, true)))
+        })
+    }
+}

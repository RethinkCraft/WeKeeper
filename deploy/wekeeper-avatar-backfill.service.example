[Unit]
Description=WeKeeper missing group avatar backfill
After=network-online.target wekeeper-sync.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/WeKeeper
ExecStart=%h/Desktop/WeKeeper/.venv/bin/python -m chatlog_keeper.dashboard.cli --archive-state %h/Desktop/wechat-linux-poc/state avatar-backfill
Restart=on-failure
RestartSec=30
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target

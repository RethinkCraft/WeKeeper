+pub const QUOTE_RECEIPT_SCHEMA_UNVERIFIED: &str = "quote_receipt_schema_unverified";
+
+/// Decode only the shared BaseResponse rejection until the supported Linux
+/// quoted-send response has independent field/presence evidence. A successful
+/// file receipt is not evidence for a quoted-send receipt, even on CGI222.
+/// Callers must retain authenticated bytes before calling this function.
+/// An error is an uncertain submitted send, never permission to resend.
+pub fn decode_quote_send(input: &[u8]) -> Result<MediaSendResult> {
+    let fields = p::decode(input)?;
+    let base = p::decode(p::data(&fields, 1)?)?;
+    let raw_code = p::scalar(&base, 1)?;
+    let code = raw_code as i32;
+    ensure!(
+        raw_code == code as i64 as u64,
+        "invalid_quote_response_status"
+    );
+    if code != 0 {
+        return Ok(MediaSendResult {
+            status: SendStatus::Rejected,
+            service_code: code,
+            server_message_id: None,
+            client_id_matches: None,
+        });
+    }
+    bail!(QUOTE_RECEIPT_SCHEMA_UNVERIFIED)
+}
 

+#[test]
+fn writer_child() {
+    let Some(root) = std::env::var_os("WX_CONTROL_TEST_ROOT") else {
+        return;
+    };
+    let root = PathBuf::from(root);
+    let stage = std::env::var("WX_CONTROL_TEST_STAGE").unwrap();
+    let store = Arc::new(Store::open(&root).unwrap());
+    store.create_account("one").unwrap();
+    drop(store.read_snapshot("one").unwrap());
+    store.put_runtime("one", "value", b"committed").unwrap();
+    let value = if stage == "poison" {
+        store
+            .control("one", |db| {
+                std::mem::forget(db.prepare("SELECT 1")?);
+                Ok(())
+            })
+            .unwrap();
+        assert!(store
+            .remove_account("one")
+            .unwrap_err()
+            .to_string()
+            .contains("process restart required"));
+        drop(store);
+        assert!(
+            Store::open_existing(&root).is_err(),
+            "poisoned handle released ownership"
+        );
+        serde_json::json!({"poisoned_lease_retained":true})
+    } else {
+        if stage == "accepted" {
+            for index in 0..12 {
+                store
+                    .put_runtime("one", "cross-checkpoint", &vec![index; 1024 * 1024])
+                    .unwrap();
+            }
+        }
+        store.put_runtime("one", "desired", b"connected").unwrap();
+        assert_eq!(store.reserve_client_id("one", "fixed-key", 7).unwrap(), 7);
+        let (intent, _) = store
+            .create_send(
+                "one",
+                "fixed-key",
+                "synthetic-peer",
+                "fixed-hash",
+                b"sealed",
+                "7",
+            )
+            .unwrap();
+        assert!(store.claim_send("one", &intent.id).unwrap());
+        store
+            .put_runtime(
+                "one",
+                &format!("quote-receipt:{}", intent.id),
+                b"sealed retained receipt",
+            )
+            .unwrap();
+        if stage == "accepted" {
+            store
+                .update_send("one", &intent.id, "accepted", Some("701"), None)
+                .unwrap();
+        }
+        store
+            .stage_native_ingress(
+                "one",
+                NativeIngressBatch {
+                    batch_id: "batch-one".into(),
+                    payload: Some(b"sealed ingress".to_vec()),
+                    cursor: Some(b"native cursor".to_vec()),
+                    ownership_generation: "generation-one".into(),
+                    historical: false,
+                    caught_up: true,
+                    origin: "push".into(),
+                    messages: vec![],
+                    recalls: vec![],
+                },
+            )
+            .unwrap();
+        store.register_required_consumer("one", "bot", 0).unwrap();
+        let (events, _) = store.consumer_events("one", "bot", None, 200).unwrap();
+        let ack = events.last().unwrap().cursor.clone();
+        store
+            .acknowledge("one", "bot", ack.parse().unwrap())
+            .unwrap();
+        serde_json::json!({"id":intent.id,"server_id":store.server_id,"ack":ack})
+    };
+    let path = root.parent().unwrap().join("result.json");
+    private_write(&path, &serde_json::to_vec(&value).unwrap());
+    // Deliberately bypass every Rust/SQLite destructor, as abrupt termination
+    // does. Each preceding API return must already represent a FULL commit.
+    std::process::exit(0);
+}

+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn add(from: &str, to: &str, kind: u64, content: &[u8], source: Option<&[u8]>) -> Vec<u8> {
+        let mut fields = vec![
+            p::uint(1, 1),
+            p::bytes(2, &p::bytes(1, from.as_bytes())),
+            p::bytes(3, &p::bytes(1, to.as_bytes())),
+            p::uint(4, kind),
+            p::bytes(5, &p::bytes(1, content)),
+            p::uint(6, 0),
+            p::uint(7, 0),
+            p::bytes(8, &p::buffer(b"")),
+            p::uint(9, 1700000000),
+            p::uint(12, u64::MAX),
+        ];
+        if let Some(source) = source {
+            fields.push(p::bytes(10, source));
+        }
+        p::message(&fields).unwrap()
+    }
+    const SOURCE: &[u8] = b"<msgsource><atuserlist>self,other</atuserlist></msgsource>";
+    fn normalized(raw: &[u8]) -> ReceivedMessageSnapshot {
+        normalize_received_message("account", "self", raw)
+    }
+
+    #[test]
+    fn native_group_text_is_complete_without_profile_sequence_or_metadata() {
+        let raw = add(
+            "room@chatroom",
+            "self",
+            1,
+            "member:\n原始正文\n第二行".as_bytes(),
+            Some(SOURCE),
+        );
+        let value = normalized(&raw);
+        assert_eq!(value.disposition, ReceivedDisposition::Ready);
+        assert_eq!(value.sender_id.as_deref(), Some("member"));
+        assert_eq!(value.body.as_deref(), Some("原始正文\n第二行"));
+        assert_eq!(
+            value.server_id.as_deref(),
+            Some(u64::MAX.to_string().as_str())
+        );
+        assert_eq!(value.mentions["self"], true);
+        let quote = value.quote_reference.as_ref().unwrap();
+        assert_eq!(quote.from_user, "room@chatroom");
+        assert_eq!(quote.chat_user, "member");
+        assert_eq!(quote.content, "原始正文\n第二行");
+        assert_eq!(STANDARD.decode(&value.raw_payload_base64).unwrap(), raw);
+        assert_eq!(value.to_public("received-id", "15")["quoteEligible"], true);
+        assert_eq!(
+            value.to_public("received-id", "15")["createdAt"],
+            "2023-11-14T22:13:20+00:00"
+        );
+    }
+
+    #[test]
+    fn received_identity_aliases_and_spoofed_room_routes_are_quarantined() {
+        for raw in [
+            add(
+                "room@chatroom",
+                "other-account",
+                1,
+                b"member:\nhello",
+                Some(SOURCE),
+            ),
+            add(
+                "room@chatroom",
+                "self",
+                1,
+                b"member space:\nhello",
+                Some(SOURCE),
+            ),
+            add(
+                "room@chatroom",
+                "self",
+                1,
+                b"other@chatroom:\nhello",
+                Some(SOURCE),
+            ),
+            add(
+                "room@chatroom",
+                "self",
+                1,
+                b"hello without sender",
+                Some(SOURCE),
+            ),
+            add("member", "self", (1u64 << 32) + 1, b"hello", Some(SOURCE)),
+            p::message(&[
+                add("member", "self", 1, b"hello", Some(SOURCE)),
+                p::uint(12, 123),
+            ])
+            .unwrap(),
+        ] {
+            let value = normalized(&raw);
+            assert_eq!(value.disposition, ReceivedDisposition::Quarantined);
+            assert!(value.reason.is_some());
+            assert!(value.quote_reference.is_none());
+        }
+    }
+
+    #[test]
+    fn source_mentions_are_exact_and_unknown_never_becomes_not_mentioned() {
+        for source in [None,Some(b"<invalid/>".as_slice()),
+            Some(b"<msgsource><atuserlist>self</atuserlist><atuserlist>other</atuserlist></msgsource>".as_slice()),
+            Some(b"<msgsource><atuserlist>member space</atuserlist></msgsource>".as_slice()),
+            Some(b"<msgsource xmlns:x='urn:other'><x:atuserlist>self</x:atuserlist></msgsource>".as_slice())] {
+            let value=normalized(&add("room@chatroom","self",1,b"member:\n@self text is not metadata",source));
+            assert_eq!(value.disposition,ReceivedDisposition::Quarantined);
+            assert!(value.quote_reference.is_none());
+        }
+        let nested = normalized(&add(
+            "member",
+            "self",
+            1,
+            b"@self",
+            Some(b"<msgsource><quote><atuserlist>self</atuserlist></quote></msgsource>"),
+        ));
+        assert_eq!(nested.mentions["self"], false);
+        let exact = normalized(&add(
+            "member",
+            "self",
+            1,
+            b"hello",
+            Some(b"<msgsource><atuserlist>self-other</atuserlist></msgsource>"),
+        ));
+        assert_eq!(exact.mentions["self"], false);
+        let direct = normalized(&add("member", "self", 1, b"direct message", None));
+        assert_eq!(direct.disposition, ReceivedDisposition::Ready);
+        assert_eq!(direct.mentions["state"], "unknown");
+        assert_eq!(direct.mentions["self"], Value::Null);
+        assert!(direct.quote_reference.is_some());
+    }
+
+    #[test]
+    fn app_quote_retains_immediate_text_and_exact_embedded_target() {
+        let content=b"member:\n<msg><appmsg><type>57</type><title>reply</title><refermsg><svrid>9007199254740993</svrid><type>1</type><fromusr>original</fromusr><content>original question</content></refermsg></appmsg></msg>";
+        let value = normalized(&add("room@chatroom", "self", 49, content, Some(SOURCE)));
+        assert_eq!(value.disposition, ReceivedDisposition::Ready);
+        assert_eq!(value.body.as_deref(), Some("reply"));
+        assert_eq!(
+            value.quote.as_ref().unwrap()["serverId"],
+            "9007199254740993"
+        );
+        assert_eq!(
+            value.quote.as_ref().unwrap()["embeddedText"],
+            "original question"
+        );
+        let reference = value.quote_reference.unwrap();
+        assert!(reference.content.contains("<title>reply</title>"));
+        assert!(!reference.content.contains("refermsg"));
+    }
+
+    #[test]
+    fn unsupported_apps_unknown_controls_and_missing_quote_content_remain_visible() {
+        for (kind,content) in [(49,b"<msg><appmsg><type>6</type><title>file name is not file content</title></appmsg></msg>".as_slice()),
+            (49,b"<msg><appmsg><type>57</type><title>reply</title><refermsg><svrid>2</svrid><type>1</type></refermsg></appmsg></msg>".as_slice()),
+            (10002,b"<sysmsg type='unknown'/>".as_slice())] {
+            let raw=add("member","self",kind,content,Some(SOURCE));
+            let value=normalized(&raw);
+            assert_eq!(value.disposition,ReceivedDisposition::Quarantined);
+            assert_eq!(STANDARD.decode(&value.raw_payload_base64).unwrap(),raw);
+            assert_eq!(value.to_public("received-id","1")["quoteEligible"],false);
+        }
+        let system = normalized(&add("member", "self", 10000, b"system notice", None));
+        assert_eq!(system.disposition, ReceivedDisposition::System);
+        let own = normalized(&add("room@chatroom", "self", 1, b"self:\nmy copy", None));
+        assert_eq!(own.disposition, ReceivedDisposition::Outgoing);
+        assert!(own.quote_reference.is_none());
+    }
+
+    #[test]
+    fn duplicate_transport_counters_do_not_change_identity_but_content_does() {
+        let raw = add("member", "self", 1, b"first", Some(SOURCE));
+        let transport = p::message(&[raw.clone(), p::uint(13, 99)]).unwrap();
+        let first = normalized(&raw);
+        let other = normalized(&transport);
+        assert_eq!(first.identity_fingerprint(), other.identity_fingerprint());
+        assert_ne!(first.source_sha256, other.source_sha256);
+        let changed = normalized(&add("member", "self", 1, b"changed", Some(SOURCE)));
+        assert_ne!(first.identity_fingerprint(), changed.identity_fingerprint());
+    }
+}

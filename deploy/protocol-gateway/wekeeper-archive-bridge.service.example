[Unit]
Description=WeKeeper protocol snapshot archive bridge
After=wekeeper-protocol-gate1.service

[Service]
Type=exec
WorkingDirectory=@PROJECT_ROOT@
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@PYTHON@ @PROJECT_ROOT@/scripts/run_archive_bridge.py   --archive-state @ARCHIVE_STATE_DIR@ --state-dir @BRIDGE_STATE_DIR@   --journal @BRIDGE_JOURNAL_FILE@ --token-file @GATEWAY_TOKEN_FILE@   --server http://127.0.0.1:@GATEWAY_PORT@ --account @GATEWAY_ACCOUNT@   --bot-status @BOT_STATUS_FILE@ --catchup-floor @CATCHUP_SINCE@ --limit 5 --pace 1 --run
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=default.target

+#[test]
+fn expected_lookup_misses_keep_the_native_send_sequence_on_one_wal_writer() {
+    let (directory, store) = wal_store();
+    let path = control_path(&store, "one");
+    store
+        .put_runtime("one", "account-state", b"synthetic protected state")
+        .unwrap();
+    store.put_runtime("one", "desired", b"connected").unwrap();
+    store.control("one", |db| {
+        db.execute_batch("CREATE TEMP TABLE send_sequence_canary(value); INSERT INTO send_sequence_canary VALUES(11)")?;
+        Ok(())
+    }).unwrap();
+    let mut salts = BTreeSet::new();
+    let mut max_wal = 0;
+    for index in 0..12 {
+        let key = format!("native-send-{index}");
+        let error = store.send_by_key("one", &key).unwrap_err();
+        assert!(matches!(
+            error.downcast_ref::<rusqlite::Error>(),
+            Some(rusqlite::Error::QueryReturnedNoRows)
+        ));
+        assert_eq!(store.admitted.lock().unwrap().cached_writers(), 1);
+        assert_eq!(
+            store.runtime("one", "account-state").unwrap().unwrap(),
+            b"synthetic protected state"
+        );
+        let error = store
+            .media_job_by_key("one", &format!("send:{key}"))
+            .err()
+            .expect("missing media job");
+        assert!(matches!(
+            error.downcast_ref::<rusqlite::Error>(),
+            Some(rusqlite::Error::QueryReturnedNoRows)
+        ));
+        assert_eq!(store.admitted.lock().unwrap().cached_writers(), 1);
+        store
+            .control("one", |db| {
+                assert_eq!(
+                    db.query_row("SELECT value FROM send_sequence_canary", [], |r| r
+                        .get::<_, i64>(0))?,
+                    11
+                );
+                Ok(())
+            })
+            .unwrap();
+        let client_id = store.reserve_client_id("one", &key, index + 7).unwrap();
+        let (intent, created) = store
+            .create_send(
+                "one",
+                &key,
+                "synthetic-peer",
+                "fixed-hash",
+                b"sealed",
+                &client_id.to_string(),
+            )
+            .unwrap();
+        assert!(created && store.claim_send("one", &intent.id).unwrap());
+        store
+            .put_runtime(
+                "one",
+                &format!("quote-receipt:{}", intent.id),
+                b"retained raw receipt",
+            )
+            .unwrap();
+        store
+            .update_send(
+                "one",
+                &intent.id,
+                "accepted",
+                Some(&(700 + index).to_string()),
+                None,
+            )
+            .unwrap();
+        store
+            .put_runtime("one", "cross-checkpoint", &vec![index as u8; 1024 * 1024])
+            .unwrap();
+        let wal = fs::read(member(&path, "-wal")).unwrap();
+        salts.insert(wal[16..24].to_vec());
+        max_wal = max_wal.max(wal.len());
+    }
+    assert!(salts.len() >= 2);
+    assert!(max_wal < 6 * 1024 * 1024);
+    drop(store);
+    let reopened = Store::open_existing(&directory.path().join("data")).unwrap();
+    assert_eq!(
+        reopened
+            .send_by_key("one", "native-send-11")
+            .unwrap()
+            .server_id
+            .as_deref(),
+        Some("711")
+    );
+}

+        let temp = tempfile::tempdir().unwrap();
+        let store = Store::open(&temp.path().join("data")).unwrap();
+        store.create_account("one").unwrap();
+        (temp, store)
+    }
+
+    fn publish(store: &Store, count: i64) {
+        store.control("one", |db| {
+            let tx = db.transaction()?;
+            for _ in 0..count {
+                tx.execute("INSERT INTO events(kind,data_json,created_at) VALUES('message.committed','{}','synthetic')", [])?;
+                prune_events(&tx, tx.last_insert_rowid())?;
+            }
+            tx.commit()?;
+            Ok(())
+        }).unwrap();
+    }
+
+    fn count(store: &Store) -> i64 {
+        store
+            .control("one", |db| {
+                Ok(db.query_row("SELECT COUNT(*) FROM events", [], |r| r.get(0))?)
+            })
+            .unwrap()
+    }
+
+    #[test]
+    fn legacy_consumers_keep_the_window_and_expired_registration_does_not_skip() {
+        let (_temp, store) = fixture();
+        store.acknowledge("one", "legacy", 0).unwrap();
+        publish(&store, 10_020);
+        assert_eq!(count(&store), 10_000);
+        assert_eq!(
+            store.events("one", 0, 1).unwrap_err().to_string(),
+            "event_cursor_expired"
+        );
+        assert_eq!(
+            store
+                .register_required_consumer("one", "required", 0)
+                .unwrap_err()
+                .to_string(),
+            "event_cursor_expired"
+        );
+        assert!(store.required_consumer("one", "required").is_err());
+        assert!(store
+            .register_required_consumer("one", "future", 10_021)
+            .is_err());
+        let state = store
+            .register_required_consumer("one", "required", 10_020)
+            .unwrap();
+        assert_eq!(state.acknowledged_cursor, "10020");
+        assert_eq!(
+            store
+                .register_required_consumer("one", "required", 20)
+                .unwrap_err()
+                .to_string(),
+            "consumer_registration_conflict"
+        );
+    }
+
+    #[test]
+    fn slowest_required_ack_protects_events_across_producers_and_restart() {
+        let (temp, store) = fixture();
+        store.register_required_consumer("one", "slow", 0).unwrap();
+        store.register_required_consumer("one", "fast", 0).unwrap();
+        publish(&store, 10_020);
+        store
+            .append_event("one", "sync.committed", &json!({}))
+            .unwrap();

+//! Immutable authenticated AddMsg facts, independent of official profile writes.
+//! A quarantined observation is retained work, never a silently completed item.
+use anyhow::{bail, ensure, Context, Result};
+use base64::{engine::general_purpose::STANDARD, Engine};
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use wechat_protocol::{protobuf as p, quote_send::QuoteReference};
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum ReceivedDisposition {
+    Ready,
+    Outgoing,
+    System,
+    Quarantined,
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) struct ReceivedMessageSnapshot {
+    pub schema_version: u8,
+    pub account_id: String,
+    pub own_username: String,
+    pub source_sha256: String,
+    pub raw_payload_base64: String,
+    pub thread_id: Option<String>,
+    pub sender_id: Option<String>,
+    pub server_id: Option<String>,
+    pub direction: Option<String>,
+    pub message_type: Option<i32>,
+    pub app_message_type: Option<i32>,
+    pub created_at: Option<u32>,
+    pub body: Option<String>,
+    pub mentions: Value,
+    pub quote: Option<Value>,
+    pub disposition: ReceivedDisposition,
+    pub reason: Option<String>,
+    pub raw_content_base64: String,
+    pub raw_msgsource_base64: Option<String>,
+    pub quote_reference: Option<QuoteReference>,
+}
+
+impl ReceivedMessageSnapshot {
+    /// Stable message facts, excluding receive time, batch, session and raw
+    /// transport counters. Duplicate observations never replace the first seal.
+    pub(crate) fn identity_fingerprint(&self) -> String {
+        let facts = json!({"account":self.account_id,"own":self.own_username,
+            "thread":self.thread_id,"sender":self.sender_id,"server":self.server_id,
+            "direction":self.direction,"type":self.message_type,"subtype":self.app_message_type,
+            "createdAt":self.created_at,"rawContent":self.raw_content_base64,
+            "rawMsgsource":self.raw_msgsource_base64});
+        format!(
+            "{:x}",
+            Sha256::digest(serde_json::to_vec(&facts).expect("JSON facts"))
+        )
+    }
+
+    pub(crate) fn to_public(&self, received_id: &str, first_received_sequence: &str) -> Value {
+        json!({"receivedId":received_id,"firstReceivedSequence":first_received_sequence,
+            "accountId":self.account_id,"ownUsername":self.own_username,"sourceSha256":self.source_sha256,
+            "disposition":self.disposition,"reason":self.reason,"threadId":self.thread_id,
+            "serverId":self.server_id,"senderId":self.sender_id,"direction":self.direction,
+            "type":self.message_type,"appMessageType":self.app_message_type,
+            "createdAt":self.created_at.and_then(|n|chrono::DateTime::from_timestamp(i64::from(n),0)).map(|t|t.to_rfc3339()),
+            "body":self.body,"mentions":self.mentions,"quote":self.quote,
+            "quoteEligible":self.disposition==ReceivedDisposition::Ready && self.quote_reference.is_some()})
+    }
+}
+
+fn received_mentions(source: Option<&str>, own: &str) -> Result<Value> {
+    let source = source.context("received_mentions_unknown")?;
+    ensure!(
+        source.len() <= 256 * 1024
+            && !source.to_ascii_uppercase().contains("<!DOCTYPE")
+            && !source.to_ascii_uppercase().contains("<!ENTITY"),
+        "received_mentions_unknown"
+    );
+    let document = roxmltree::Document::parse_with_options(
+        source,
+        roxmltree::ParsingOptions {
+            allow_dtd: false,
+            nodes_limit: 4096,
+            ..Default::default()
+        },
+    )
+    .map_err(|_| anyhow::anyhow!("received_mentions_unknown"))?;
+    let root = document.root_element();
+    ensure!(
+        root.tag_name().name() == "msgsource"
+            && root.tag_name().namespace().is_none()
+            && document
+                .descendants()
+                .all(|n| n.ancestors().take(65).count() <= 64),
+        "received_mentions_unknown"
+    );
+    let lists: Vec<_> = root
+        .children()
+        .filter(|n| n.is_element() && n.tag_name().name() == "atuserlist")
+        .collect();
+    ensure!(
+        lists.len() <= 1 && lists.iter().all(|n| n.tag_name().namespace().is_none()),
+        "received_mentions_unknown"
+    );
+    let raw = lists
+        .first()
+        .map(|n| crate::quotes::leaf(*n).context("received_mentions_unknown"))
+        .transpose()?
+        .unwrap_or_default();
+    let ids: Vec<_> = raw
+        .split(',')
+        .map(str::trim)
+        .filter(|s| !s.is_empty())
+        .collect();
+    ensure!(
+        ids.len() <= 128 && ids.iter().all(|s| identity(s)),
+        "received_mentions_unknown"
+    );
+    let all = ids.contains(&"notify@all");
+    let users: Vec<_> = ids.into_iter().filter(|id| *id != "notify@all").collect();
+    Ok(
+        json!({"state":"known","userIds":users,"self":users.contains(&own),"all":all,"source":"msgsource.atuserlist"}),
+    )
+}
+
+fn identity(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 256
+        && !value.chars().any(|c| c.is_control() || c.is_whitespace())
+}
+
+pub(crate) fn normalize_received_message(
+    account: &str,
+    own: &str,
+    raw: &[u8],
+) -> ReceivedMessageSnapshot {
+    let mut snapshot = ReceivedMessageSnapshot {
+        schema_version: 1,
+        account_id: account.into(),
+        own_username: own.into(),
+        source_sha256: format!("{:x}", Sha256::digest(raw)),
+        raw_payload_base64: STANDARD.encode(raw),
+        thread_id: None,
+        sender_id: None,
+        server_id: None,
+        direction: None,
+        message_type: None,
+        app_message_type: None,
+        created_at: None,
+        body: None,
+        mentions: crate::profile::mentions(None, Some(own)),
+        quote: None,
+        disposition: ReceivedDisposition::Quarantined,
+        reason: None,
+        raw_content_base64: String::new(),
+        raw_msgsource_base64: None,
+        quote_reference: None,
+    };
+    if let Err(error) = normalize(&mut snapshot, raw) {
+        snapshot.disposition = ReceivedDisposition::Quarantined;
+        snapshot.quote_reference = None;
+        snapshot.reason = Some(
+            match error.to_string().as_str() {
+                "unsupported_received_type" => "unsupported_received_type",
+                "unsupported_received_app_subtype" => "unsupported_received_app_subtype",
+                "received_mentions_unknown" => "received_mentions_unknown",
+                "received_group_sender_invalid" => "received_group_sender_invalid",
+                "received_account_mismatch" => "received_account_mismatch",
+                "received_identity_invalid" => "received_identity_invalid",
+                "received_source_unavailable" => "received_source_unavailable",
+                _ => "received_message_malformed",
+            }
+            .into(),
+        );
+    }
+    snapshot
+}
+
+fn normalize(snapshot: &mut ReceivedMessageSnapshot, raw: &[u8]) -> Result<()> {
+    // This wrapper tightens the general decoder's legacy scalar casts and room
+    // routing allowance. These are identity gates, not profile metadata gates.
+    let fields = p::decode(raw)?;
+    let mut seen = std::collections::BTreeSet::new();
+    for field in &fields {
+        ensure!(seen.insert(field.number), "ambiguous_received_field");
+    }
+    let message_type = i32::try_from(p::scalar(&fields, 4)?)?;
+    ensure!(message_type > 0, "received_identity_invalid");
+    let message = wechat_protocol::wire::decode_add_message(raw, &snapshot.own_username)?;
+    snapshot.message_type = Some(message_type);
+    snapshot.thread_id = Some(message.peer.clone());
+    snapshot.server_id = message.server_message_id.clone();
+    snapshot.created_at = Some(message.created_at);
+    snapshot.raw_content_base64 = STANDARD.encode(&message.content);
+    snapshot.raw_msgsource_base64 = message.msgsource.as_ref().map(|v| STANDARD.encode(v));
+    ensure!(
+        identity(&snapshot.own_username)
+            && identity(&message.from)
+            && identity(&message.to)
+            && identity(&message.peer),
+        "received_identity_invalid"
+    );
+    ensure!(
+        message.from == snapshot.own_username || message.to == snapshot.own_username,
+        "received_account_mismatch"
+    );
+    ensure!(
+        message
+            .server_message_id
+            .as_deref()
+            .is_some_and(|s| s.parse::<u64>().is_ok_and(|n| n > 0 && n.to_string() == s))
+            && message.created_at > 0
+            && message.created_at <= i32::MAX as u32,
+        "received_identity_invalid"
+    );
+    if matches!(message_type, 10000 | 10002) {
+        // 10002 includes controls such as recalls. Its semantic disposition is
+        // owned by ingress control handling; unrecognized controls stay pending.
+        if message_type == 10002 {
+            bail!("unsupported_received_type");
+        }
+        snapshot.disposition = ReceivedDisposition::System;
+        snapshot.body = String::from_utf8(message.content).ok();
+        return Ok(());
+    }
+    let group_incoming =
+        message.from.ends_with("@chatroom") && message.from != snapshot.own_username;
+    let (sender, content) = if group_incoming {
+        ensure!(
+            message.to == snapshot.own_username,
+            "received_account_mismatch"
+        );
+        let end = message
+            .content
+            .windows(2)
+            .take(257)
+            .position(|bytes| bytes == b":\n")
+            .context("received_group_sender_invalid")?;
+        let sender = std::str::from_utf8(&message.content[..end])?;
+        ensure!(
+            identity(sender) && !sender.ends_with("@chatroom"),
+            "received_group_sender_invalid"
+        );
+        (sender, &message.content[end + 2..])
+    } else {
+        (message.from.as_str(), message.content.as_slice())
+    };
+    let outgoing = sender == snapshot.own_username;
+    snapshot.sender_id = Some(sender.into());
+    snapshot.direction = Some(if outgoing { "outgoing" } else { "incoming" }.into());
+    let source = message
+        .msgsource
+        .as_deref()
+        .map(std::str::from_utf8)
+        .transpose()?;
+    snapshot.mentions = crate::profile::mentions(source, Some(&snapshot.own_username));
+    if outgoing {
+        snapshot.disposition = ReceivedDisposition::Outgoing;
+        return Ok(());
+    }
+    if source.is_some() || message.peer.ends_with("@chatroom") {
+        snapshot.mentions = received_mentions(source, &snapshot.own_username)?;
+    }
+    ensure!(
+        !source.is_some_and(|s| s.contains("announcement@all")),
+        "received_source_unavailable"
+    );
+    // An absent or malformed source is not proof of absence of @mentions.
+    // A direct chat does not need @metadata to identify its recipient. Preserve
+    // absent metadata as unknown for policy; never manufacture self=false.
+    ensure!(
+        snapshot.mentions["state"] == "known" || !message.peer.ends_with("@chatroom"),
+        "received_mentions_unknown"
+    );
+    ensure!(
+        snapshot.mentions["userIds"]
+            .as_array()
+            .is_some_and(|ids| ids.iter().all(|id| id.as_str().is_some_and(identity))),
+        "received_mentions_unknown"
+    );
+    let content = std::str::from_utf8(content)?;
+    ensure!(
+        !content.is_empty() && content.len() <= 128 * 1024 && !content.contains('\0'),
+        "received_source_unavailable"
+    );
+    let quote_content = match message_type {
+        1 => {
+            snapshot.body = Some(content.into());
+            content.to_owned()
+        }
+        49 => normalize_app(snapshot, content)?,
+        _ => bail!("unsupported_received_type"),
+    };
+    let reference = QuoteReference {
+        message_type,
+        server_id: snapshot.server_id.clone().unwrap(),
+        from_user: if group_incoming {
+            message.peer.clone()
+        } else {
+            sender.into()
+        },
+        chat_user: sender.into(),
+        display_name: sender.into(),
+        content: quote_content,
+        created_at: message.created_at,
+        msg_source: source.filter(|s| !s.is_empty()).map(str::to_owned),
+    };
+    reference.validate()?;
+    snapshot.quote_reference = Some(reference);
+    snapshot.disposition = ReceivedDisposition::Ready;
+    Ok(())
+}
+
+fn normalize_app(snapshot: &mut ReceivedMessageSnapshot, content: &str) -> Result<String> {
+    // The existing bounded parser is shared with profile reads. Its result is
+    // now derived directly from the retained AddMsg, never a profile row/title.
+    let app = crate::quotes::app_message(content).context("received_source_unavailable")?;
+    snapshot.app_message_type = Some(app.subtype);
+    snapshot.quote = crate::quotes::embedded_quote(&app, Some(&snapshot.own_username));
+    match app.subtype {
+        1 | 87 => {
+            snapshot.body = app.text.filter(|s| !s.is_empty());
+            ensure!(snapshot.body.is_some(), "received_source_unavailable");
+            Ok(content.into())
+        }
+        5 | 51 => {
+            snapshot.body = app.link.as_ref().map(|link| link.card.body());
+            ensure!(
+                snapshot.body.as_deref().is_some_and(|s| !s.is_empty()),
+                "received_source_unavailable"
+            );
+            Ok(content.into())
+        }
+        57 => {
+            ensure!(
+                app.reference.is_some() && snapshot.quote.is_some(),
+                "received_source_unavailable"
+            );
+            ensure!(
+                snapshot
+                    .quote
+                    .as_ref()
+                    .is_some_and(|quote| quote["state"] == "embedded"
+                        && quote["embeddedText"]
+                            .as_str()
+                            .is_some_and(|text| !text.is_empty())),
+                "received_source_unavailable"
+            );
+            let title = app
+                .title
+                .filter(|s| !s.is_empty())
+                .context("received_source_unavailable")?;
+            snapshot.body = Some(title.clone());
+            // Quote the immediate parent comment, as the existing resolver does;
+            // do not recursively include the parent's own quoted payload.
+            let escaped = title
+                .replace('&', "&amp;")
+                .replace('<', "&lt;")
+                .replace('>', "&gt;")
+                .replace('"', "&quot;")
+                .replace('\'', "&apos;");
+            Ok(format!(
+                "<msg><appmsg><title>{escaped}</title><type>57</type></appmsg></msg>"
+            ))
+        }
+        // A file/forward/card title alone is not its full business content.
+        _ => bail!("unsupported_received_app_subtype"),
+    }
+}

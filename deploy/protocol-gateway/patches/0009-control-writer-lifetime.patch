+#[test]
+fn eviction_read_snapshots_and_account_removal_keep_ownership_and_fences() {
+    let (directory, store) = wal_store();
+    store.put_runtime("one", "value", b"old").unwrap();
+    let old = store.read_snapshot("one").unwrap();
+    for index in 0..9 {
+        let account = format!("account-{index}");
+        store.create_account(&account).unwrap();
+        drop(store.read_snapshot(&account).unwrap());
+        store.put_runtime(&account, "value", b"other").unwrap();
+        assert!(store.admitted.lock().unwrap().cached_writers() <= 8);
+    }
+    store.put_runtime("one", "value", b"new").unwrap();
+    assert_eq!(old.runtime("one", "value").unwrap().unwrap(), b"old");
+    assert_eq!(store.runtime("one", "value").unwrap().unwrap(), b"new");
+    store.remove_account("account-8").unwrap();
+    assert!(store.account("account-8").is_err());
+    assert!(store.put_runtime("account-8", "no", b"no").is_err());
+    assert!(store.create_account("account-8").is_err());
+    drop(store);
+    assert!(Store::open_existing(&directory.path().join("data")).is_err());
+    assert_eq!(old.runtime("one", "value").unwrap().unwrap(), b"old");
+    drop(old);
+    let reopened = Store::open_existing(&directory.path().join("data")).unwrap();
+    assert_eq!(reopened.runtime("one", "value").unwrap().unwrap(), b"new");
+}

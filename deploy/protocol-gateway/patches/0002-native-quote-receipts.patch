+//! Pending send evidence, not another copy of settled message history.
+//! Native quote responses are sealed before parsing and never fetched again.
+use super::*;
+use anyhow::ensure;
+use base64::{engine::general_purpose::STANDARD, Engine};
+use wechat_protocol::media_send::{MediaSendResult, SendStatus};
+use zeroize::{Zeroize, Zeroizing};
+
+const RECEIPT_PREFIX: &str = "quote-receipt:";
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct QuoteReceipt {
+    version: u8,
+    sender: String,
+    payload_sha256: String,
+    response_base64: String,
+}
+
+impl Drop for QuoteReceipt {
+    fn drop(&mut self) {
+        self.sender.zeroize();
+        self.response_base64.zeroize();
+    }
+}
+
+fn payload_hash(payload: &SendPayload) -> Result<String> {
+    let bytes = Zeroizing::new(serde_json::to_vec(payload)?);
+    Ok(format!("{:x}", Sha256::digest(bytes.as_slice())))
+}
+
+fn decoded_receipt(result: MediaSendResult) -> Result<SendReceipt> {
+    match result.status {
+        SendStatus::Rejected if result.service_code != 0 => Ok(SendReceipt {
+            accepted: false,
+            correlated: false,
+            server_message_id: None,
+        }),
+        SendStatus::ServerAccepted
+            if result.service_code == 0
+                && result.client_id_matches == Some(true)
+                && result.server_message_id.as_deref().is_some_and(|id| {
+                    id.parse::<u64>()
+                        .is_ok_and(|value| value > 0 && value.to_string() == id)
+                }) =>
+        {
+            Ok(SendReceipt {
+                accepted: true,
+                correlated: true,
+                server_message_id: result.server_message_id,
+            })
+        }
+        // An uncorrelated reply is not an explicit service rejection.
+        _ => bail!("quote_receipt_unverified"),
+    }
+}
+
+pub(super) fn error_code(error: &anyhow::Error) -> &'static str {
+    let message = error.to_string();
+    match message.as_str() {
+        wechat_protocol::quote_send::QUOTE_RECEIPT_SCHEMA_UNVERIFIED => {
+            wechat_protocol::quote_send::QUOTE_RECEIPT_SCHEMA_UNVERIFIED
+        }
+        "quote_receipt_invalid" => "quote_receipt_invalid",
+        "quote_receipt_unverified" => "quote_receipt_unverified",
+        "quote_receipt_persistence_failed" => "quote_receipt_persistence_failed",
+        "quote_receipt_integrity_failed" => "quote_receipt_integrity_failed",
+        _ => "submission_outcome_unknown",
+    }
+}
+
+impl Core {
+    pub(super) fn send_quote_with_receipt(
+        &self,
+        account: &str,
+        id: &str,
+        state: &mut AccountState,
+        payload: &SendPayload,
+    ) -> Result<SendReceipt> {
+        let quote = payload.quote.as_ref().context("missing_quote_intent")?;
+        if self.upstream_kind() == crate::upstream::UpstreamKind::Simulator {
+            // Simulator decoded results remain marked simulator. They do not
+            // create native wire evidence or validate a native receipt schema.
+            return decoded_receipt(self.upstream.send_quote(
+                state,
+                &payload.thread_id,
+                &payload.client_id.to_string(),
+                payload.created_at,
+                &quote.xml,
+            )?);
+        }
+        let sender = state.own_username.clone();
+        let raw = Zeroizing::new(self.upstream.send_quote_raw(
+            state,
+            &payload.thread_id,
+            &payload.client_id.to_string(),
+            payload.created_at,
+            &quote.xml,
+        )?);
+        self.retain_quote_receipt(account, id, payload, &sender, &raw)
+            .map_err(|_| anyhow::anyhow!("quote_receipt_persistence_failed"))?;
+        self.decode_retained_quote_receipt(account, id, payload)
+    }
+
+    fn retain_quote_receipt(
+        &self,
+        account: &str,
+        id: &str,
+        payload: &SendPayload,
+        sender: &str,
+        raw: &[u8],
+    ) -> Result<()> {
+        ensure!(
+            payload.quote.is_some() && raw.len() <= wechat_protocol::MAX_MESSAGE_BYTES,
+            "invalid_quote_receipt"
+        );
+        let purpose = format!("{RECEIPT_PREFIX}{id}");
+        // A second response must not replace the original attempt's evidence.
+        ensure!(
+            self.store.runtime(account, &purpose)?.is_none(),
+            "quote_receipt_already_retained"
+        );
+        let receipt = QuoteReceipt {
+            version: 1,
+            sender: sender.into(),
+            payload_sha256: payload_hash(payload)?,
+            response_base64: STANDARD.encode(raw),
+        };
+        let bytes = Zeroizing::new(serde_json::to_vec(&receipt)?);
+        let sealed = self.vault.seal(account, &purpose, &bytes)?;
+        self.store.put_runtime(account, &purpose, &sealed)
+    }
+
+    fn decode_retained_quote_receipt(
+        &self,
+        account: &str,
+        id: &str,
+        payload: &SendPayload,
+    ) -> Result<SendReceipt> {
+        let load = || -> Result<Zeroizing<Vec<u8>>> {
+            let purpose = format!("{RECEIPT_PREFIX}{id}");
+            let sealed = self
+                .store
+                .runtime(account, &purpose)?
+                .context("missing_quote_receipt")?;
+            let receipt: QuoteReceipt =
+                serde_json::from_slice(&self.vault.open_record(account, &purpose, &sealed)?)?;
+            ensure!(
+                receipt.version == 1
+                    && payload.quote.is_some()
+                    && receipt.payload_sha256 == payload_hash(payload)?,
+                "quote_receipt_intent_mismatch"
+            );
+            let raw = Zeroizing::new(STANDARD.decode(&receipt.response_base64)?);
+            ensure!(
+                raw.len() <= wechat_protocol::MAX_MESSAGE_BYTES,
+                "invalid_quote_receipt"
+            );
+            Ok(raw)
+        };
+        let raw = load().map_err(|_| anyhow::anyhow!("quote_receipt_integrity_failed"))?;
+        let result = wechat_protocol::quote_send::decode_quote_send(&raw).map_err(|error| {
+            if error.to_string() == wechat_protocol::quote_send::QUOTE_RECEIPT_SCHEMA_UNVERIFIED {
+                error
+            } else {
+                anyhow::anyhow!("quote_receipt_invalid")
+            }
+        })?;
+        decoded_receipt(result)
+    }
+
+    pub(super) fn recover_quote_receipts(&self, account: &str) -> Result<usize> {
+        // Read only pending IDs; each protected response is opened separately.
+        // Unlike replaying a send, this works without credentials or a network.
+        let ids = self
+            .store
+            .pending_send_receipt_ids(account, RECEIPT_PREFIX)?;
+        let mut changed = 0;
+        for id in ids {
+            let old = self.store.send(account, &id)?;
+            let outcome = (|| -> Result<SendReceipt> {
+                let sealed = self.store.send_payload(account, &id)?;
+                let payload: SendPayload = serde_json::from_slice(&self.vault.open_record(
+                    account,
+                    "send-payload",
+                    &sealed,
+                )?)?;
+                self.decode_retained_quote_receipt(account, &id, &payload)
+            })();
+            let (state, server_id, error) = match outcome {
+                Ok(receipt) if receipt.accepted => ("accepted", receipt.server_message_id, None),
+                Ok(_) => ("failed", None, Some("service_rejected")),
+                Err(error) => ("needs_review", None, Some(error_code(&error))),
+            };
+            if old.state != state
+                || server_id
+                    .as_ref()
+                    .is_some_and(|server| old.server_id.as_ref() != Some(server))
+                || old.error_code.as_deref() != error
+            {
+                self.store
+                    .update_send(account, &id, state, server_id.as_deref(), error)?;
+                changed += 1;
+            }
+        }
+        Ok(changed)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::upstream::{Upstream, UpstreamKind};
+    use std::sync::atomic::AtomicUsize;
+    use wechat_protocol::protobuf as p;
+
+    struct RawReply {
+        calls: AtomicUsize,
+        response: Vec<u8>,
+    }
+
+    impl Upstream for RawReply {
+        fn kind(&self) -> UpstreamKind {
+            UpstreamKind::Native
+        }
+
+        fn send_quote_raw(
+            &self,
+            _state: &mut AccountState,
+            _destination: &str,
+            _client_id: &str,
+            _created_at: u32,
+            _content: &str,
+        ) -> Result<Vec<u8>> {
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            Ok(self.response.clone())
+        }
+    }
+
+    struct Fixture {
+        _directory: tempfile::TempDir,
+        core: Arc<Core>,
+        store: Arc<Store>,
+        upstream: Arc<RawReply>,
+    }
+
+    fn fixture(raw: Vec<u8>) -> Fixture {
+        let directory = tempfile::tempdir().unwrap();
+        let store = Arc::new(Store::open(&directory.path().join("store")).unwrap());
+        store.create_account("one").unwrap();
+        store.create_account("two").unwrap();
+        let upstream = Arc::new(RawReply {
+            calls: AtomicUsize::new(0),
+            response: raw,
+        });
+        let core = Core::with_upstream(store.clone(), None, upstream.clone()).unwrap();
+        Fixture {
+            _directory: directory,
+            core,
+            store,
+            upstream,
+        }
+    }
+
+    fn intent(core: &Core, key: &str) -> (SendIntent, SendPayload) {
+        let payload = SendPayload {
+            thread_id: "synthetic-room@chatroom".into(),
+            text: "synthetic reply".into(),
+            created_at: 1234,
+            client_id: wechat_protocol::wire::client_message_id(key.as_bytes()).max(1),
+            share: None,
+            mentions: None,
+            quote: Some(crate::quote_send::ResolvedQuote {
+                target: crate::QuoteSendReference {
+                    message_id: "synthetic-source".into(),
+                    server_id: "999".into(),
+                },
+                xml: "<appmsg><type>57</type><refermsg><svrid>999</svrid></refermsg></appmsg>"
+                    .into(),
+            }),
+        };
+        let sealed = core
+            .vault
+            .seal(
+                "one",
+                "send-payload",
+                &serde_json::to_vec(&payload).unwrap(),
+            )
+            .unwrap();
+        let (intent, _) = core
+            .store
+            .create_send(
+                "one",
+                key,
+                &payload.thread_id,
+                &payload_hash(&payload).unwrap(),
+                &sealed,
+                &payload.client_id.to_string(),
+            )
+            .unwrap();
+        core.store
+            .put_runtime("one", "desired", b"connected")
+            .unwrap();
+        assert!(core.store.claim_send("one", &intent.id).unwrap());
+        (intent, payload)
+    }
+
+    #[test]
+    fn native_quote_response_is_retained_before_parse_and_reopened_without_resending() {
+        // Not a validated quote receipt: even this empty success envelope is
+        // retained, but must not create an accepted outgoing history row.
+        let raw = p::bytes(1, &p::int32(1, 0));
+        let Fixture {
+            _directory,
+            core,
+            store,
+            upstream,
+        } = fixture(raw.clone());
+        let (send, payload) = intent(&core, "restart-quote");
+        let error = core
+            .send_quote_with_receipt("one", &send.id, &mut super::super::tests::state(), &payload)
+            .err()
+            .unwrap();
+        assert_eq!(
+            error_code(&error),
+            wechat_protocol::quote_send::QUOTE_RECEIPT_SCHEMA_UNVERIFIED
+        );
+        let purpose = format!("{RECEIPT_PREFIX}{}", send.id);
+        let sealed = store.runtime("one", &purpose).unwrap().unwrap();
+        let receipt: QuoteReceipt =
+            serde_json::from_slice(&core.vault.open_record("one", &purpose, &sealed).unwrap())
+                .unwrap();
+        assert_eq!(STANDARD.decode(&receipt.response_base64).unwrap(), raw);
+        assert_eq!(receipt.payload_sha256, payload_hash(&payload).unwrap());
+        assert_eq!(store.send("one", &send.id).unwrap().state, "submitting");
+        drop(core);
+
+        let reopened = Core::with_upstream(store.clone(), None, upstream.clone()).unwrap();
+        let recovered = store.send("one", &send.id).unwrap();
+        assert_eq!(recovered.state, "needs_review");
+        assert_eq!(
+            recovered.error_code.as_deref(),
+            Some(wechat_protocol::quote_send::QUOTE_RECEIPT_SCHEMA_UNVERIFIED)
+        );
+        assert_eq!(recovered.server_id, None);
+        assert_eq!(recovered.local_message_id, None);
+        assert_eq!(upstream.calls.load(Ordering::SeqCst), 1);
+        assert_eq!(store.runtime("one", &purpose).unwrap().unwrap(), sealed);
+        assert_eq!(reopened.recover_quote_receipts("one").unwrap(), 0);
+        assert_eq!(upstream.calls.load(Ordering::SeqCst), 1);
+    }
+
+    #[test]
+    fn retained_quote_response_is_bound_to_account_send_and_payload() {
+        let f = fixture(vec![]);
+        let (first, payload) = intent(&f.core, "first");
+        let (other, _) = intent(&f.core, "other");
+        f.core
+            .retain_quote_receipt(
+                "one",
+                &first.id,
+                &payload,
+                "synthetic_self",
+                b"private response",
+            )
+            .unwrap();
+        let first_key = format!("{RECEIPT_PREFIX}{}", first.id);
+        let sealed = f.store.runtime("one", &first_key).unwrap().unwrap();
+        assert!(!sealed
+            .windows(b"private response".len())
+            .any(|v| v == b"private response"));
+        assert!(f
+            .core
+            .retain_quote_receipt("one", &first.id, &payload, "synthetic_self", b"replacement")
+            .is_err());
+        let other_key = format!("{RECEIPT_PREFIX}{}", other.id);
+        f.store.put_runtime("one", &other_key, &sealed).unwrap();
+        f.store.put_runtime("two", &first_key, &sealed).unwrap();
+        for (account, id) in [("one", other.id.as_str()), ("two", first.id.as_str())] {
+            let error = f
+                .core
+                .decode_retained_quote_receipt(account, id, &payload)
+                .err()
+                .unwrap();
+            assert_eq!(error_code(&error), "quote_receipt_integrity_failed");
+        }
+        let mut changed_payload = payload;
+        changed_payload.quote.as_mut().unwrap().target.server_id = "1000".into();
+        assert_eq!(
+            error_code(
+                &f.core
+                    .decode_retained_quote_receipt("one", &first.id, &changed_payload)
+                    .err()
+                    .unwrap()
+            ),
+            "quote_receipt_integrity_failed"
+        );
+        assert_eq!(f.upstream.calls.load(Ordering::SeqCst), 0);
+    }
+
+    #[test]
+    fn malformed_native_reply_is_retained_and_store_failure_is_never_acceptance() {
+        let f = fixture(vec![10, 3, 8]);
+        let (first, payload) = intent(&f.core, "malformed");
+        let error = f
+            .core
+            .send_quote_with_receipt(
+                "one",
+                &first.id,
+                &mut super::super::tests::state(),
+                &payload,
+            )
+            .err()
+            .unwrap();
+        assert_eq!(error_code(&error), "quote_receipt_invalid");
+        assert!(f
+            .store
+            .runtime("one", &format!("{RECEIPT_PREFIX}{}", first.id))
+            .unwrap()
+            .is_some());
+
+        let (second, payload) = intent(&f.core, "persistence-failure");
+        let db = rusqlite::Connection::open(f.store.root.join("accounts/one/agent/control.sqlite"))
+            .unwrap();
+        db.execute_batch("CREATE TRIGGER reject_quote_receipt BEFORE INSERT ON runtime WHEN NEW.key LIKE 'quote-receipt:%' BEGIN SELECT RAISE(ABORT,'synthetic storage failure'); END;").unwrap();
+        drop(db);
+        let error = f
+            .core
+            .send_quote_with_receipt(
+                "one",
+                &second.id,
+                &mut super::super::tests::state(),
+                &payload,
+            )
+            .err()
+            .unwrap();
+        assert_eq!(error_code(&error), "quote_receipt_persistence_failed");
+        assert!(f
+            .store
+            .runtime("one", &format!("{RECEIPT_PREFIX}{}", second.id))
+            .unwrap()
+            .is_none());
+        assert_eq!(f.store.send("one", &second.id).unwrap().state, "submitting");
+        assert_eq!(f.upstream.calls.load(Ordering::SeqCst), 2);
+    }
+
+    #[test]
+    fn local_recovery_preserves_an_explicit_rejection_and_unknown_without_network() {
+        let f = fixture(vec![]);
+        let (send, payload) = intent(&f.core, "rejected");
+        f.core
+            .retain_quote_receipt(
+                "one",
+                &send.id,
+                &payload,
+                "synthetic_self",
+                &p::bytes(1, &p::int32(1, -13)),
+            )
+            .unwrap();
+        f.store.recover_uncertain_sends("one").unwrap();
+        assert_eq!(f.core.recover_quote_receipts("one").unwrap(), 1);
+        let rejected = f.store.send("one", &send.id).unwrap();
+        assert_eq!(rejected.state, "failed");
+        assert_eq!(rejected.error_code.as_deref(), Some("service_rejected"));
+        assert_eq!(f.core.recover_quote_receipts("one").unwrap(), 0);
+        let uncertain = MediaSendResult {
+            status: SendStatus::NeedsReview,
+            service_code: 0,
+            server_message_id: Some("123".into()),
+            client_id_matches: Some(false),
+        };
+        assert_eq!(
+            error_code(&decoded_receipt(uncertain).err().unwrap()),
+            "quote_receipt_unverified"
+        );
+        assert_eq!(f.upstream.calls.load(Ordering::SeqCst), 0);
+    }
+
+    #[test]
+    fn decoded_success_requires_correlation_and_exact_positive_server_identity() {
+        for (code, correlated, server) in [
+            (0, true, None),
+            (0, true, Some("0")),
+            (0, true, Some("+123")),
+            (0, true, Some("0123")),
+            (0, true, Some("18446744073709551616")),
+            (0, false, Some("123")),
+            (-13, true, Some("123")),
+        ] {
+            let result = MediaSendResult {
+                status: SendStatus::ServerAccepted,
+                service_code: code,
+                server_message_id: server.map(str::to_owned),
+                client_id_matches: Some(correlated),
+            };
+            assert!(decoded_receipt(result).is_err());
+        }
+        assert!(decoded_receipt(MediaSendResult {
+            status: SendStatus::Rejected,
+            service_code: 0,
+            server_message_id: None,
+            client_id_matches: None,
+        })
+        .is_err());
+    }
+}

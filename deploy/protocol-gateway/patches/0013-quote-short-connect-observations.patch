+#[derive(Clone)]
+struct OwnedRecorder(Sender<Event>);
+impl Observer for OwnedRecorder {
+    fn begin(&self, phase: Phase) {
+        self.0.send(Event::Begin(phase)).unwrap();
+    }
+    fn end(&self, phase: Phase, _: Duration, outcome: Outcome) {
+        self.0.send(Event::End(phase, outcome)).unwrap();
+    }
+    fn owned(&self) -> Option<Arc<dyn Observer>> {
+        Some(Arc::new(self.clone()))
+    }
+}
+
+#[test]
+fn short_http_connect_observation_ends_before_the_server_releases_headers() {
+    let listener = TcpListener::bind(("127.0.0.1", 0)).unwrap();
+    let url = format!("http://{}/synthetic", listener.local_addr().unwrap());
+    let (seen, request_seen) = mpsc::channel();
+    let (headers, allow_headers) = mpsc::channel();
+    let server = thread::spawn(move || {
+        let (mut socket, _) = listener.accept().unwrap();
+        request(&mut socket);
+        seen.send(()).unwrap();
+        allow_headers.recv_timeout(Duration::from_secs(3)).unwrap();
+        socket
+            .write_all(
+                b"HTTP/1.1 200 OK\r\nContent-Length: 9\r\nConnection: close\r\n\r\nsynthetic",
+            )
+            .unwrap();
+    });
+    let (sender, events) = mpsc::channel();
+    let worker = thread::spawn(move || {
+        let observer = OwnedRecorder(sender);
+        let builder = reqwest::blocking::Client::builder()
+            .timeout(Duration::from_secs(3))
+            .no_proxy()
+            .redirect(reqwest::redirect::Policy::none());
+        let client = crate::short_http_connect::observed(builder, Some(&observer))
+            .build()
+            .unwrap();
+        short_http_observed(Some(&observer), || {
+            Ok(client.post(url).body(Vec::new()).send()?)
+        })
+    });
+    assert_eq!(next(&events), Event::Begin(Phase::ShortHttp));
+    assert_eq!(next(&events), Event::Begin(Phase::ShortHttpHeaders));
+    assert_eq!(next(&events), Event::Begin(Phase::ShortHttpConnect));
+    assert_eq!(
+        next(&events),
+        Event::End(Phase::ShortHttpConnect, Outcome::Ok)
+    );
+    request_seen.recv_timeout(Duration::from_secs(3)).unwrap();
+    // The actual reqwest connector is ready, but the response headers have not
+    // been sent. No timer or sleep is used to guess this boundary.
+    assert!(matches!(events.try_recv(), Err(mpsc::TryRecvError::Empty)));
+    headers.send(()).unwrap();
+    assert_eq!(
+        next(&events),
+        Event::End(Phase::ShortHttpHeaders, Outcome::Ok)
+    );
+    assert_eq!(next(&events), Event::Begin(Phase::ShortHttpBody));
+    assert_eq!(next(&events), Event::End(Phase::ShortHttpBody, Outcome::Ok));
+    assert_eq!(next(&events), Event::End(Phase::ShortHttp, Outcome::Ok));
+    assert_eq!(worker.join().unwrap().unwrap(), b"synthetic");
+    server.join().unwrap();
+}

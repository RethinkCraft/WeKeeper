+struct ControlledResolver(bool);
+impl reqwest::dns::Resolve for ControlledResolver {
+    fn resolve(&self, _: reqwest::dns::Name) -> reqwest::dns::Resolving {
+        if self.0 {
+            Box::pin(async { Err(std::io::Error::other("synthetic resolver error").into()) })
+        } else {
+            Box::pin(std::future::pending())
+        }
+    }
+}
+
+#[test]
+fn short_http_connect_observation_preserves_resolver_failure() {
+    let (sender, events) = mpsc::channel();
+    let observer = OwnedRecorder(sender);
+    let builder = reqwest::blocking::Client::builder()
+        .timeout(Duration::from_secs(1))
+        .no_proxy()
+        .dns_resolver(Arc::new(ControlledResolver(true)));
+    let client = crate::short_http_connect::observed(builder, Some(&observer))
+        .build()
+        .unwrap();
+    let result = short_http_observed(Some(&observer), || {
+        Ok(client
+            .post("http://synthetic.invalid/synthetic")
+            .body(Vec::new())
+            .send()?)
+    });
+    assert!(result
+        .unwrap_err()
+        .downcast_ref::<reqwest::Error>()
+        .unwrap()
+        .is_connect());
+    assert_eq!(
+        events.try_iter().collect::<Vec<_>>(),
+        [
+            Event::Begin(Phase::ShortHttp),
+            Event::Begin(Phase::ShortHttpHeaders),
+            Event::Begin(Phase::ShortHttpConnect),
+            Event::End(Phase::ShortHttpConnect, Outcome::Error),
+            Event::End(Phase::ShortHttpHeaders, Outcome::Error),
+            Event::End(Phase::ShortHttp, Outcome::Error)
+        ]
+    );
+}
+
+#[test]
+fn short_http_connect_observation_keeps_connect_timeout_and_cancellation() {
+    for enabled in [false, true] {
+        let (sender, events) = mpsc::channel();
+        let observer = OwnedRecorder(sender);
+        let builder = reqwest::blocking::Client::builder()
+            .timeout(Duration::from_secs(1))
+            .connect_timeout(Duration::from_millis(50))
+            .no_proxy()
+            .dns_resolver(Arc::new(ControlledResolver(false)));
+        let client = crate::short_http_connect::observed(
+            builder,
+            enabled.then_some(&observer as &dyn Observer),
+        )
+        .build()
+        .unwrap();
+        let result = short_http_observed(Some(&observer), || {
+            Ok(client
+                .post("http://synthetic.invalid/synthetic")
+                .body(Vec::new())
+                .send()?)
+        });
+        let error = result.unwrap_err();
+        let error = error.downcast_ref::<reqwest::Error>().unwrap();
+        assert!(error.is_timeout() && error.is_connect());
+        let rows = events.try_iter().collect::<Vec<_>>();
+        let mut expected = vec![
+            Event::Begin(Phase::ShortHttp),
+            Event::Begin(Phase::ShortHttpHeaders),
+        ];
+        if enabled {
+            expected.extend([
+                Event::Begin(Phase::ShortHttpConnect),
+                Event::End(Phase::ShortHttpConnect, Outcome::Incomplete),
+            ]);
+        }
+        expected.extend([
+            Event::End(Phase::ShortHttpHeaders, Outcome::Error),
+            Event::End(Phase::ShortHttp, Outcome::Error),
+        ]);
+        assert_eq!(rows, expected);
+    }
+}
+
+#[test]
+fn short_http_connect_observation_legacy_borrowed_sink_has_no_owned_context() {
+    let (sender, events) = mpsc::channel();
+    let observer = Recorder(sender);

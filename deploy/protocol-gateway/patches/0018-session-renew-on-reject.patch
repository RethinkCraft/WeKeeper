+    async fn try_renew_rejected_session(
+        &self,
+        account: &str,
+        fence: &SessionFence,
+        source: &str,
+    ) -> Result<bool> {
+        let (state, expected) = {
+            let _guard = self.lock_account(account).await?;
+            if self.store.runtime(account, "desired")?.as_deref() != Some(b"connected")
+                || self.store.runtime(account, "logged-out")?.is_some()
+                || self.session_fence(account).ok().as_ref() != Some(fence)
+            {
+                return Ok(false);
+            }
+            let state = self.account_state(account)?;
+            let expected = match self.store.runtime(account, "account-state")? {
+                Some(value) => value,
+                None => return Ok(false),
+            };
+            (state, expected)
+        };
+        let prior = authorization(&state)?;
+        let upstream = self.upstream.clone();
+        let renewed = match blocking(move || upstream.renew_session(&state, "agent-wechat")).await {
+            Ok(state) => state,
+            Err(_) => return Ok(false),
+        };
+        // Unchanged credentials are not a renewal (simulator no-op included).
+        if authorization(&renewed)? == prior {
+            return Ok(false);
+        }
+        let _guard = self.lock_account(account).await?;
+        if self.store.runtime(account, "desired")?.as_deref() != Some(b"connected")
+            || self.store.runtime(account, "logged-out")?.is_some()
+            || self.session_fence(account).ok().as_ref() != Some(fence)
+        {
+            return Ok(false);
+        }
+        self.save_network_state(account, &renewed, &expected, fence, Some(b"connected"))?;
+        self.store.append_event(
+            account,
+            "account.connection",
+            &json!({
+                "state": "renewed",
+                "source": source,
+                "serviceCode": -13,
+                "authentication": "renewed"
+            }),
+        )?;
+        Ok(true)
+    }

--- /dev/null
+++ b/packages/native-client-rust/crates/wechat-protocol/src/http_observation_tests.rs
@@ -0,0 +1,198 @@
+use super::*;
+use crate::rpc_observation::{Observer, Outcome, Phase};
+use std::{
+    io::{Read, Write},
+    net::{TcpListener, TcpStream},
+    sync::{
+        atomic::{AtomicUsize, Ordering},
+        mpsc::{self, Receiver, Sender},
+    },
+    thread,
+};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Event {
+    Begin(Phase),
+    End(Phase, Outcome),
+}
+
+struct Recorder(Sender<Event>);
+impl Observer for Recorder {
+    fn begin(&self, phase: Phase) {
+        self.0.send(Event::Begin(phase)).unwrap();
+    }
+    fn end(&self, phase: Phase, _: Duration, outcome: Outcome) {
+        self.0.send(Event::End(phase, outcome)).unwrap();
+    }
+}
+
+fn next(events: &Receiver<Event>) -> Event {
+    events.recv_timeout(Duration::from_secs(3)).unwrap()
+}
+
+fn request(socket: &mut TcpStream) {
+    socket
+        .set_read_timeout(Some(Duration::from_secs(3)))
+        .unwrap();
+    let mut header = Vec::new();
+    while !header.ends_with(b"\r\n\r\n") {
+        let mut byte = [0; 1];
+        socket.read_exact(&mut byte).unwrap();
+        header.push(byte[0]);
+        assert!(header.len() < 16 * 1024);
+    }
+    assert!(header.starts_with(b"POST /synthetic HTTP/1.1\r\n"));
+}
+
+fn client() -> reqwest::blocking::Client {
+    reqwest::blocking::Client::builder()
+        .timeout(Duration::from_secs(3))
+        .redirect(reqwest::redirect::Policy::none())
+        .no_proxy()
+        .build()
+        .unwrap()
+}
+
+#[test]
+fn short_http_observation_separates_headers_from_a_paused_body() {
+    let listener = TcpListener::bind(("127.0.0.1", 0)).unwrap();
+    let url = format!("http://{}/synthetic", listener.local_addr().unwrap());
+    let (seen, request_seen) = mpsc::channel();
+    let (headers, allow_headers) = mpsc::channel();
+    let (body, allow_body) = mpsc::channel();
+    let server = thread::spawn(move || {
+        let (mut socket, _) = listener.accept().unwrap();
+        request(&mut socket);
+        seen.send(()).unwrap();
+        allow_headers.recv_timeout(Duration::from_secs(3)).unwrap();
+        socket
+            .write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 9\r\nConnection: close\r\n\r\n")
+            .unwrap();
+        socket.flush().unwrap();
+        allow_body.recv_timeout(Duration::from_secs(3)).unwrap();
+        socket.write_all(b"synthetic").unwrap();
+    });
+    let (sender, events) = mpsc::channel();
+    let worker = thread::spawn(move || {
+        let observer = Recorder(sender);
+        let client = client();
+        short_http_observed(Some(&observer), || {
+            Ok(client.post(url).body(Vec::new()).send()?)
+        })
+    });
+    assert_eq!(next(&events), Event::Begin(Phase::ShortHttp));
+    assert_eq!(next(&events), Event::Begin(Phase::ShortHttpHeaders));
+    request_seen.recv_timeout(Duration::from_secs(3)).unwrap();
+    assert!(matches!(events.try_recv(), Err(mpsc::TryRecvError::Empty)));
+    headers.send(()).unwrap();
+    assert_eq!(
+        next(&events),
+        Event::End(Phase::ShortHttpHeaders, Outcome::Ok)
+    );
+    assert_eq!(next(&events), Event::Begin(Phase::ShortHttpBody));
+    assert!(matches!(events.try_recv(), Err(mpsc::TryRecvError::Empty)));
+    body.send(()).unwrap();
+    assert_eq!(next(&events), Event::End(Phase::ShortHttpBody, Outcome::Ok));
+    assert_eq!(next(&events), Event::End(Phase::ShortHttp, Outcome::Ok));
+    assert_eq!(worker.join().unwrap().unwrap(), b"synthetic");
+    assert!(events.try_recv().is_err());
+    server.join().unwrap();
+}
+
+#[test]
+fn short_http_observation_keeps_a_send_error_and_calls_the_action_once() {
+    let (sender, events) = mpsc::channel();
+    let observer = Recorder(sender);
+    let count = AtomicUsize::new(0);
+    let result = short_http_observed(Some(&observer), || {
+        count.fetch_add(1, Ordering::SeqCst);
+        anyhow::bail!("private synthetic send failure")
+    });
+    assert_eq!(count.load(Ordering::SeqCst), 1);
+    assert_eq!(
+        result.unwrap_err().to_string(),
+        "private synthetic send failure"
+    );
+    let rows: Vec<_> = events.try_iter().collect();
+    assert_eq!(
+        rows,
+        [
+            Event::Begin(Phase::ShortHttp),
+            Event::Begin(Phase::ShortHttpHeaders),
+            Event::End(Phase::ShortHttpHeaders, Outcome::Error),
+            Event::End(Phase::ShortHttp, Outcome::Error)
+        ]
+    );
+    assert!(!format!("{rows:?}").contains("private synthetic send failure"));
+}
+
+fn static_response(wire: &'static [u8], observer: Option<&dyn Observer>) -> Result<Vec<u8>> {
+    let listener = TcpListener::bind(("127.0.0.1", 0)).unwrap();
+    let url = format!("http://{}/synthetic", listener.local_addr().unwrap());
+    let server = thread::spawn(move || {
+        let (mut socket, _) = listener.accept().unwrap();
+        request(&mut socket);
+        socket.write_all(wire).unwrap();
+    });
+    let client = client();
+    let result = short_http_observed(observer, || Ok(client.post(url).body(Vec::new()).send()?));
+    server.join().unwrap();
+    result
+}
+
+#[test]
+fn short_http_observation_does_not_start_the_body_for_a_rejected_status() {
+    let (sender, events) = mpsc::channel();
+    let observer = Recorder(sender);
+    let result = static_response(
+        b"HTTP/1.1 503 Unavailable\r\nContent-Length: 0\r\nConnection: close\r\n\r\n",
+        Some(&observer),
+    );
+    assert_eq!(
+        result.unwrap_err().to_string(),
+        "Native shortlink HTTP status 503"
+    );
+    assert_eq!(
+        events.try_iter().collect::<Vec<_>>(),
+        [
+            Event::Begin(Phase::ShortHttp),
+            Event::Begin(Phase::ShortHttpHeaders),
+            Event::End(Phase::ShortHttpHeaders, Outcome::Error),
+            Event::End(Phase::ShortHttp, Outcome::Error)
+        ]
+    );
+}
+
+#[test]
+fn short_http_observation_preserves_body_read_failure_and_pairs_both_spans() {
+    let (sender, events) = mpsc::channel();
+    let observer = Recorder(sender);
+    let result = static_response(
+        b"HTTP/1.1 200 OK\r\nContent-Length: 9\r\nConnection: close\r\n\r\nshort",
+        Some(&observer),
+    );
+    assert!(result.is_err());
+    assert_eq!(
+        events.try_iter().collect::<Vec<_>>(),
+        [
+            Event::Begin(Phase::ShortHttp),
+            Event::Begin(Phase::ShortHttpHeaders),
+            Event::End(Phase::ShortHttpHeaders, Outcome::Ok),
+            Event::Begin(Phase::ShortHttpBody),
+            Event::End(Phase::ShortHttpBody, Outcome::Error),
+            Event::End(Phase::ShortHttp, Outcome::Error)
+        ]
+    );
+}
+
+#[test]
+fn short_http_observation_disabled_keeps_the_complete_response() {
+    assert_eq!(
+        static_response(
+            b"HTTP/1.1 200 OK\r\nContent-Length: 9\r\nConnection: close\r\n\r\nsynthetic",
+            None
+        )
+        .unwrap(),
+        b"synthetic"
+    );
+}

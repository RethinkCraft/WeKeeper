# Dedicated listener; existing sites and their ports remain in place.
server {
    listen __HTTPS_PORT__ ssl;
    server_name __PUBLIC_IP__;
    ssl_certificate __CERTIFICATE_PATH__/fullchain.pem;
    ssl_certificate_key __CERTIFICATE_PATH__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 16m;
    add_header Strict-Transport-Security "max-age=86400" always;
    location / {
        proxy_pass http://127.0.0.1:18880;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 75s;
    }
}

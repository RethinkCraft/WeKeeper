+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn clean_wal_database(path: &Path) -> Result<()> {
+        wechat_platform::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(path)?;
+        let db = Connection::open(path)?;
+        db.execute_batch(
+            "PRAGMA journal_mode=WAL; CREATE TABLE fixture(value TEXT NOT NULL); \
+             INSERT INTO fixture VALUES('synthetic preserved value');",
+        )?;
+        db.close().map_err(|(_, error)| error)?;
+        for suffix in ["-wal", "-shm", "-journal"] {
+            assert!(!member_path(path, suffix)?.exists());
+        }
+        Ok(())
+    }
+
+    fn family_bytes(path: &Path) -> Result<BTreeMap<&'static str, Vec<u8>>> {
+        SUFFIXES
+            .into_iter()
+            .filter_map(|suffix| {
+                let member = member_path(path, suffix).unwrap();
+                member.exists().then(|| {
+                    fs::read(member)
+                        .map(|bytes| (suffix, bytes))
+                        .map_err(Into::into)
+                })
+            })
+            .collect()
+    }
+
+    #[test]
+    fn readonly_wal_reader_creating_companions_is_refused_without_source_changes() -> Result<()> {
+        let temp = tempfile::tempdir()?;
+        let path = temp.path().join("control.sqlite");
+        clean_wal_database(&path)?;
+        let main_before = fs::read(&path)?;
+        let family = Family::read(&path)?;
+
+        // This is intentionally after admission captured the family. SQLite's
+        // READ_ONLY flag still permits creating its WAL/index companions.
+        let reader = Connection::open_with_flags(
+            &path,
+            OpenFlags::SQLITE_OPEN_READ_ONLY
+                | OpenFlags::SQLITE_OPEN_NO_MUTEX
+                | OpenFlags::SQLITE_OPEN_NOFOLLOW,
+        )?;
+        assert_eq!(
+            reader.query_row("SELECT value FROM fixture", [], |row| row
+                .get::<_, String>(0))?,
+            "synthetic preserved value"
+        );
+        let before_copy = family_bytes(&path)?;
+        assert!(before_copy.contains_key("-wal"));
+        assert!(before_copy.contains_key("-shm"));
+        assert_eq!(before_copy[""], main_before);
+
+        let error = family
+            .copy_to(&path, &temp.path().join("copy.sqlite"))
+            .unwrap_err()
+            .to_string();
+        assert_eq!(
+            error,
+            "database family changed during validation \
+             [database=account_control, phase=copy_complete, members=-wal,-shm]"
+        );
+        assert!(!error.contains(temp.path().to_str().unwrap()));
+        assert!(!error.contains("synthetic preserved value"));
+        assert_eq!(family_bytes(&path)?, before_copy);
+        assert_eq!(
+            reader.query_row("SELECT value FROM fixture", [], |row| row
+                .get::<_, String>(0))?,
+            "synthetic preserved value"
+        );
+        Ok(())
+    }
+
+    #[test]
+    fn uncontended_clean_wal_family_is_admitted_without_changing_data() -> Result<()> {
+        let temp = tempfile::tempdir()?;
+        let path = temp.path().join("control.sqlite");
+        clean_wal_database(&path)?;
+        let before = family_bytes(&path)?;
+        let (db, value) = open_prepared(&path, None, |db| {
+            Ok(db.query_row("SELECT value FROM fixture", [], |row| {
+                row.get::<_, String>(0)
+            })?)
+        })?;
+        assert_eq!(value, "synthetic preserved value");
+        db.close().map_err(|(_, error)| error)?;
+        assert_eq!(family_bytes(&path)?, before);
+        Ok(())
+    }
+}

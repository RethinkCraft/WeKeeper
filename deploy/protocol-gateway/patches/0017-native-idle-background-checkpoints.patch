+#[test]
+fn control_burst_defers_checkpoint_without_hiding_pending_age_or_health_observation() {
+    let (_tmp, store, ticket) = enabled();
+    store.create_account("two").unwrap();
+    let before_sql = arm(&ticket.gates.before_sql);
+    let completed = ticket.state.lock().unwrap().completed;
+    // Publish due while a real foreground is active so the worker cannot win
+    // the request-to-first-control race before this fixture begins its burst.
+    store
+        .control("one", |_| {
+            request(&ticket);
+            Ok(())
+        })
+        .unwrap();
+    let first_due = ticket.state.lock().unwrap().pending_since.unwrap();
+    for _ in 0..6 {
+        std::thread::sleep(Duration::from_millis(20));
+        store.runtime("one", "idle-burst-read").unwrap();
+        let state = ticket.state.lock().unwrap();
+        assert_eq!(state.pending_since, Some(first_due));
+        assert_eq!(state.completed, completed);
+        assert!(!before_sql.state.lock().unwrap().0);
+    }
+    let last_activity = ticket.state.lock().unwrap().last_foreground_activity;
+    let health = store.checkpoint_health("one").unwrap();
+    assert!(health["pendingAgeMs"].as_u64().unwrap() >= 100);
+    assert_eq!(
+        ticket.state.lock().unwrap().last_foreground_activity,
+        last_activity
+    );
+    // Another account's control activity is outside this ticket's quiet clock.
+    store
+        .put_runtime("two", "other-account", b"independent")
+        .unwrap();
+    assert_eq!(
+        ticket.state.lock().unwrap().last_foreground_activity,
+        last_activity
+    );
+    before_sql.entered();
+    assert!(last_activity.elapsed() >= IDLE_DELAY);
+    assert_eq!(ticket.state.lock().unwrap().pending_since, Some(first_due));
+    before_sql.release();
+    until(|| ticket.state.lock().unwrap().completed > completed);
+}
+
+#[test]
+fn original_pressure_caps_bypass_idle_delay_but_keep_real_passive_sql() {
+    for pressure in 0..3 {
+        let (_tmp, store, ticket) = enabled();
+        // Join only the asynchronous runner to call the same admission/SQLite
+        // path deterministically. The admitted maintenance handle stays open.
+        store.join_checkpoint_worker();
+        store
+            .control("one", |_| {
+                request(&ticket);
+                Ok(())
+            })
+            .unwrap();
+        let completed = {
+            let mut state = ticket.state.lock().unwrap();
+            match pressure {
+                0 => {
+                    state.checkpointed_frames = 0;
+                    ticket.frames.store(MAX_FRAMES, Ordering::Release);
+                }
+                1 => state.free_bytes = Some(MIN_FREE - 1),
+                _ => state.pending_since = Some(Instant::now() - MAX_AGE),
+            }
+            assert!(state.last_foreground_activity.elapsed() < IDLE_DELAY);
+            state.completed
+        };
+        ticket.run_due();
+        let state = ticket.state.lock().unwrap();
+        assert_eq!(state.completed, completed + 1);
+        assert_eq!(state.last_rc, rusqlite::ffi::SQLITE_OK);
+        assert_eq!(state.phase as u8, Phase::Idle as u8);
+    }
+}

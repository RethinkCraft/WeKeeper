+                panic!("closing must not execute the callback")
+            })
+            .unwrap_err();
+        assert!(error.is::<MaintenanceBusy>());
+        assert_eq!(connections.cached_writers(), count);
+        assert!(Arc::ptr_eq(
+            &connections.resident_ticket(&ticket.path).unwrap(),
+            &ticket
+        ));
+    }
+    assert!(!ticket.poisoned());
+    store
+        .put_runtime("two", "while-one-closes", b"allowed")
+        .unwrap();
+    assert_eq!(calls.load(Ordering::Acquire), 0);
+    let waited = Arc::new(AtomicBool::new(false));
+    let finished = waited.clone();
+    let waiting = store.clone();
+    let public_wait = std::thread::spawn(move || {
+        waiting.wait_checkpoint_retirement("one")?;
+        finished.store(true, Ordering::Release);
+        Ok::<_, anyhow::Error>(())
+    });
+    assert!(!waited.load(Ordering::Acquire));
+    before_close.release();
+    foreground.join().unwrap().unwrap();
+    public_wait.join().unwrap().unwrap();
+    assert_eq!(calls.load(Ordering::Acquire), 1);
+    assert!(waited.load(Ordering::Acquire));
+    assert!(!ticket.poisoned());
+    assert_eq!(
+        store.runtime("one", "after-close-race").unwrap().unwrap(),
+        b"1"
+    );
+    assert_eq!(store.checkpoint_health("one").unwrap()["blocked"], false);
+    assert_ne!(resident(&store).generation, ticket.generation);
+}

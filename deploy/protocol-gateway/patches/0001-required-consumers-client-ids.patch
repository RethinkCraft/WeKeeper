+//! Reserve the existing wire-format u32 ID before sealing an outgoing intent.
+use super::*;
+use rusqlite::OptionalExtension;
+
+pub(crate) fn check_client_id(db: &Connection, key: &str, client_id: &str) -> Result<()> {
+    let conflict: bool = db.query_row(
+        "SELECT EXISTS(SELECT 1 FROM outbox WHERE client_id=?1 AND idempotency_key<>?2)",
+        params![client_id, key],
+        |r| r.get(0),
+    )?;
+    anyhow::ensure!(!conflict, "client_id_conflict");
+    // Also protect a reservation that has not reached outbox insertion yet.
+    let conflict: bool = db.query_row(
+        "SELECT EXISTS(SELECT 1 FROM client_id_reservations WHERE client_id=?1 AND idempotency_key<>?2) OR EXISTS(SELECT 1 FROM client_id_reservations WHERE idempotency_key=?2 AND client_id<>?1)",
+        params![client_id, key], |r| r.get(0),
+    )?;
+    anyhow::ensure!(!conflict, "client_id_conflict");
+    Ok(())
+}
+
+impl Store {
+    pub fn reserve_client_id(&self, account: &str, key: &str, preferred: u32) -> Result<u32> {
+        anyhow::ensure!(!key.is_empty() && key.len() <= 200, "invalid send intent");
+        self.control(account, |db| {
+            let tx = db.transaction()?;
+            if let Some(id) = tx.query_row("SELECT client_id FROM outbox WHERE idempotency_key=?1", [key], |r| r.get::<_, String>(0)).optional()? {
+                let id: u32 = id.parse().context("invalid saved client ID")?;
+                anyhow::ensure!(id != 0, "invalid saved client ID");
+                check_client_id(&tx, key, &id.to_string())?;
+                return Ok(id);
+            }
+            if let Some(id) = tx.query_row("SELECT client_id FROM client_id_reservations WHERE idempotency_key=?1", [key], |r| r.get::<_, u32>(0)).optional()? {
+                return Ok(id);
+            }
+            let mut candidate = preferred.max(1);
+            // A bounded search fails explicitly, never reuses an existing ID.
+            for _ in 0..1024 {
+                let occupied: bool = tx.query_row(
+                    "SELECT EXISTS(SELECT 1 FROM client_id_reservations WHERE client_id=?1) OR EXISTS(SELECT 1 FROM outbox WHERE client_id=?2)",
+                    params![candidate, candidate.to_string()], |r| r.get(0),
+                )?;
+                if !occupied {
+                    tx.execute("INSERT INTO client_id_reservations VALUES(?1,?2)", params![key, candidate])?;
+                    tx.commit()?;
+                    return Ok(candidate);
+                }
+                candidate = candidate.checked_add(1).unwrap_or(1);
+            }
+            bail!("client_id_allocation_exhausted")
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn collisions_have_distinct_persisted_ids_and_key_replay_is_stable() {
+        let temp = tempfile::tempdir().unwrap();
+        let store = Store::open(&temp.path().join("data")).unwrap();
+        store.create_account("one").unwrap();
+        assert_eq!(store.reserve_client_id("one", "first", 7).unwrap(), 7);
+        assert_eq!(store.reserve_client_id("one", "second", 7).unwrap(), 8);
+        assert_eq!(store.reserve_client_id("one", "first", 99).unwrap(), 7);
+        store
+            .create_send("one", "first", "peer", "hash", b"sealed", "7")
+            .unwrap();
+        assert_eq!(
+            store
+                .create_send("one", "third", "peer", "hash", b"sealed", "7")
+                .unwrap_err()
+                .to_string(),
+            "client_id_conflict"
+        );
+        assert_eq!(
+            store
+                .create_send("one", "second", "peer", "hash", b"sealed", "9")
+                .unwrap_err()
+                .to_string(),
+            "client_id_conflict"
+        );
+        assert_eq!(
+            store
+                .create_send("one", "third", "peer", "hash", b"sealed", "8")
+                .unwrap_err()
+                .to_string(),
+            "client_id_conflict"
+        );
+        drop(store);
+        let store = Store::open(&temp.path().join("data")).unwrap();
+        assert_eq!(store.reserve_client_id("one", "first", 99).unwrap(), 7);
+        assert_eq!(store.reserve_client_id("one", "second", 99).unwrap(), 8);
+        assert_eq!(store.reserve_client_id("one", "third", 7).unwrap(), 9);
+    }
+
+    #[test]
+    fn existing_outbox_ids_and_wraparound_are_not_reused() {
+        let temp = tempfile::tempdir().unwrap();
+        let store = Store::open(&temp.path().join("data")).unwrap();
+        store.create_account("one").unwrap();
+        store
+            .create_send("one", "legacy", "peer", "hash", b"sealed", "4294967295")
+            .unwrap();
+        assert_eq!(store.reserve_client_id("one", "new", u32::MAX).unwrap(), 1);
+        assert_eq!(store.reserve_client_id("one", "next", 0).unwrap(), 2);
+        store
+            .control("one", |db| {
+                db.execute(
+                    "UPDATE outbox SET client_id='1' WHERE idempotency_key='legacy'",
+                    [],
+                )?;
+                Ok(())
+            })
+            .unwrap();
+        assert_eq!(
+            store
+                .reserve_client_id("one", "legacy", 5)
+                .unwrap_err()
+                .to_string(),
+            "client_id_conflict"
+        );
+    }
+
+    #[test]
+    fn concurrent_reservations_cannot_share_a_client_id() {
+        let temp = tempfile::tempdir().unwrap();
+        let store = Arc::new(Store::open(&temp.path().join("data")).unwrap());
+        store.create_account("one").unwrap();
+        let handles: Vec<_> = (0..12)
+            .map(|index| {
+                let store = store.clone();
+                std::thread::spawn(move || {
+                    store
+                        .reserve_client_id("one", &format!("request-{index}"), 23)
+                        .unwrap()
+                })
+            })
+            .collect();
+        let ids: std::collections::BTreeSet<_> = handles
+            .into_iter()
+            .map(|thread| thread.join().unwrap())
+            .collect();
+        assert_eq!(ids.len(), 12);
+    }
+
+    #[test]
+    fn legacy_collisions_cannot_be_claimed_after_restart() {
+        let temp = tempfile::tempdir().unwrap();
+        let store = Store::open(&temp.path().join("data")).unwrap();
+        store.create_account("one").unwrap();
+        store.put_runtime("one", "desired", b"connected").unwrap();
+        let (first, _) = store
+            .create_send("one", "first", "peer", "hash", b"sealed", "7")
+            .unwrap();
+        let (second, _) = store
+            .create_send("one", "second", "peer", "hash", b"sealed", "8")
+            .unwrap();
+        store
+            .control("one", |db| {
+                db.execute(
+                    "UPDATE outbox SET client_id='7' WHERE idempotency_key='second'",
+                    [],
+                )?;
+                Ok(())
+            })
+            .unwrap();
+        drop(store);
+        let store = Store::open(&temp.path().join("data")).unwrap();
+        for id in [&first.id, &second.id] {
+            assert_eq!(
+                store.claim_send("one", id).unwrap_err().to_string(),
+                "client_id_conflict"
+            );
+            assert_eq!(store.send("one", id).unwrap().state, "queued");
+        }
+        assert_eq!(store.events("one", 0, 100).unwrap().len(), 2);
+    }
+}

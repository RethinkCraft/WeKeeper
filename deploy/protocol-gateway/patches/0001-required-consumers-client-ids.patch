+        assert_eq!(page.first().unwrap().cursor, "1");
+        assert_eq!(page.last().unwrap().cursor, "10");
+        assert_eq!(
+            store
+                .acknowledge("one", "slow", 11)
+                .unwrap_err()
+                .to_string(),

+    pub fn submitting_sends(&self, account: &str) -> Result<Vec<String>> {
+        self.control(account, |db| {
+            let mut q = db.prepare(
+                "SELECT id FROM outbox WHERE state='submitting' ORDER BY created_at,id LIMIT 100",
+            )?;
+            let rows = q.query_map([], |r| r.get(0))?;
+            Ok(rows.collect::<rusqlite::Result<_>>()?)
+        })
+    }
+    /// True when any required consumer still has delivered-but-unacked events.
+    pub fn required_consumers_unacked(&self, account: &str) -> Result<bool> {
+        self.control(account, |db| {
+            Ok(db.query_row(
+                "SELECT EXISTS(SELECT 1 FROM required_event_consumers WHERE delivered_sequence>acknowledged_sequence)",
+                [],
+                |r| r.get(0),
+            )?)
+        })
+    }
+    /// Age in seconds of the oldest non-projected message apply intent, if any.
+    pub fn oldest_pending_projection_age_secs(&self, account: &str) -> Result<Option<i64>> {
+        self.control(account, |db| {
+            let created: Option<String> = db.query_row(
+                "SELECT created_at FROM apply_intents WHERE stream='message' AND state!='projected' ORDER BY rowid LIMIT 1",
+                [],
+                |r| r.get(0),
+            ).optional()?;
+            let Some(created) = created else {
+                return Ok(None);
+            };
+            let Some(when) = chrono::DateTime::parse_from_rfc3339(&created)
+                .ok()
+                .map(|value| value.with_timezone(&chrono::Utc))
+            else {
+                return Ok(Some(0));
+            };
+            Ok(Some((chrono::Utc::now() - when).num_seconds().max(0)))
+        })
+    }
+    pub fn recent_event_activity_secs(&self, account: &str) -> Result<Option<i64>> {
+        self.control(account, |db| {
+            let created: Option<String> = db.query_row(
+                "SELECT created_at FROM events ORDER BY sequence DESC LIMIT 1",
+                [],
+                |r| r.get(0),
+            ).optional()?;
+            let Some(created) = created else {
+                return Ok(None);
+            };
+            let Some(when) = chrono::DateTime::parse_from_rfc3339(&created)
+                .ok()
+                .map(|value| value.with_timezone(&chrono::Utc))
+            else {
+                return Ok(None);
+            };
+            Ok(Some((chrono::Utc::now() - when).num_seconds().max(0)))
+        })
+    }

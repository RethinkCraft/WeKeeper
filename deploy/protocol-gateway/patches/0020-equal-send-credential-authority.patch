 const FRESH: &[u8] = b"fresh-protected-equal-full-auth";
 const RAW: &[u8] = b"original-protected-correlated-receipt";
 
+fn preserve(
+    store: &Store,
+    intent: &SendIntent,
+    staged: &EqualSendStage,
+) -> Result<EqualSendFinalResult> {
+    store.finalize_equal_send_with_authority(
+        "one",
+        SendFinalUpdate {
+            id: &intent.id,
+            state: "accepted",
+            server_id: Some("17"),
+            error: None,
+        },
+        staged,
+        EqualSendAuthority::Preserve {
+            fresh_fallback: FRESH,
+        },
+    )
+}
+
+#[test]
+fn preserve_accepted_keeps_exact_cipher_and_generations_in_original_full_final() {
+    let (_dir, store, intent, snapshot) = setup();
+    let counter = Commits::new(&store);
+    let staged = stage(&store, &intent, &snapshot);
+    assert_eq!(counter.count.load(Ordering::SeqCst), 1);
+    store.control("one", |db| {
+        db.execute_batch("CREATE TRIGGER reject_auth_insert BEFORE INSERT ON runtime WHEN NEW.key IN ('account-state','saved-login-accepted-state-generation','saved-login-projected-state-generation','saved-login-projected-generation') BEGIN SELECT RAISE(ABORT,'unexpected authority write'); END;
+            CREATE TRIGGER reject_auth_update BEFORE UPDATE ON runtime WHEN NEW.key IN ('account-state','saved-login-accepted-state-generation','saved-login-projected-state-generation','saved-login-projected-generation') BEGIN SELECT RAISE(ABORT,'unexpected authority write'); END;")?;
+        Ok(())
+    }).unwrap();
+    let result = preserve(&store, &intent, &staged).unwrap();
+    assert!(!result.authorization_installed);
+    assert_eq!(result.intent.state, "accepted");
+    assert_eq!(counter.count.load(Ordering::SeqCst), 2);
+    assert_eq!(
+        store.runtime("one", "account-state").unwrap().as_deref(),
+        Some(OLD)
+    );
+    assert_eq!(
+        store
+            .runtime("one", "saved-login-accepted-state-generation")
+            .unwrap(),
+        Some(cipher_generation(OLD))
+    );
+    assert_eq!(
+        store
+            .runtime("one", "saved-login-projected-state-generation")
+            .unwrap(),
+        Some(cipher_generation(OLD))
+    );
+    assert_eq!(
+        store
+            .runtime("one", "saved-login-projected-generation")
+            .unwrap()
+            .as_deref(),
+        Some("a".repeat(64).as_bytes())
+    );
+    assert!(store
+        .runtime("one", NETWORK_BLOCKED_STATE)
+        .unwrap()
+        .is_none());
+    assert!(store
+        .runtime("one", "saved-login-projection-needed")
+        .unwrap()
+        .is_none());
+    assert_raw(&store, &intent);
+    canary(&store);
+}

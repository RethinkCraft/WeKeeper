+#[derive(Clone, Copy, Default, Debug)]
+pub struct SnapshotCopyStats {
+    pub snapshots: u64,
+    pub copied_bytes: u64,
+    pub verified_bytes: u64,
+}
+thread_local! {
+    static COPY_STATS: std::cell::Cell<SnapshotCopyStats> = const { std::cell::Cell::new(SnapshotCopyStats { snapshots: 0, copied_bytes: 0, verified_bytes: 0 }) };
+}
+/// Counters on the calling thread, for diagnosing expensive profile copies.
+/// They contain no account, file, key or message values.
+#[doc(hidden)]
+pub fn thread_snapshot_copy_stats() -> SnapshotCopyStats {
+    COPY_STATS.get()
+}
+struct CopyObservation {
+    started: std::time::Instant,
+    number: u64,
+    enabled: bool,
+    files: usize,
+    copied: u64,
+    verified: u64,
+    completed: bool,
+}
+impl CopyObservation {
+    fn start() -> Self {
+        use std::sync::atomic::{AtomicU64, Ordering};
+        static NEXT: AtomicU64 = AtomicU64::new(1);
+        let mut stats = COPY_STATS.get();
+        stats.snapshots += 1;
+        COPY_STATS.set(stats);
+        let value = Self {
+            started: std::time::Instant::now(),
+            number: NEXT.fetch_add(1, Ordering::Relaxed),
+            enabled: std::env::var_os("WX_PROFILE_TIMINGS").is_some_and(|value| value == "1"),
+            files: 0,
+            copied: 0,
+            verified: 0,
+            completed: false,
+        };
+        if value.enabled {
+            eprintln!(
+                "{}",
+                serde_json::json!({"diagnostic":"profile_read","stage":"snapshot_copy","phase":"start","sequence":value.number})
+            );
+        }
+        value
+    }
+    fn copied(&mut self, bytes: u64) {
+        self.copied += bytes;
+        self.files += 1;
+        let mut stats = COPY_STATS.get();
+        stats.copied_bytes += bytes;
+        COPY_STATS.set(stats);
+    }
+    fn verified(&mut self, bytes: u64) {
+        self.verified += bytes;
+        let mut stats = COPY_STATS.get();
+        stats.verified_bytes += bytes;
+        COPY_STATS.set(stats);
+    }
+}
+impl Drop for CopyObservation {
+    fn drop(&mut self) {
+        if self.enabled {
+            eprintln!(
+                "{}",
+                serde_json::json!({"diagnostic":"profile_read","stage":"snapshot_copy","phase":"end","sequence":self.number,"elapsed_ms":self.started.elapsed().as_secs_f64()*1000.0,"files":self.files,"copied_bytes":self.copied,"verified_bytes":self.verified,"completed":self.completed})
+            );
+        }
+    }
+}

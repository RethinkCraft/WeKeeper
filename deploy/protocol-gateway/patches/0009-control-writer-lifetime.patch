@@ -0,0 +1,470 @@
+use super::*;
+use std::collections::{BTreeMap, BTreeSet};
+
+fn control_path(store: &Store, account: &str) -> PathBuf {
+    store
+        .account_dir(account)
+        .unwrap()
+        .join("agent/control.sqlite")
+}
+
+fn member(path: &Path, suffix: &str) -> PathBuf {
+    path.with_file_name(format!(
+        "{}{}",
+        path.file_name().unwrap().to_str().unwrap(),
+        suffix
+    ))
+}
+
+fn family(path: &Path) -> BTreeMap<String, Vec<u8>> {
+    ["", "-wal", "-shm", "-journal"]
+        .into_iter()
+        .filter_map(|suffix| {
+            let path = member(path, suffix);
+            path.exists()
+                .then(|| (suffix.into(), fs::read(path).unwrap()))
+        })
+        .collect()
+}
+
+fn private_write(path: &Path, bytes: &[u8]) {
+    use std::io::Write;
+    let mut file = wechat_platform::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(path)
+        .unwrap();
+    file.write_all(bytes).unwrap();
+}
+
+fn wal_store() -> (tempfile::TempDir, Arc<Store>) {
+    let directory = tempfile::tempdir().unwrap();
+    let store = Arc::new(Store::open(&directory.path().join("data")).unwrap());
+    store.create_account("one").unwrap();
+    drop(store.read_snapshot("one").unwrap());
+    (directory, store)
+}
+
+#[test]
+fn wal_control_operations_reuse_the_owned_connection() {
+    let (_directory, store) = wal_store();
+    store
+        .control("one", |db| {
+            db.execute_batch("CREATE TEMP TABLE connection_canary(value); INSERT INTO connection_canary VALUES(7)")?;
+            Ok(())
+        })
+        .unwrap();
+    let value = store
+        .control("one", |db| {
+            Ok(
+                db.query_row("SELECT value FROM connection_canary", [], |row| {
+                    row.get::<_, i64>(0)
+                })?,
+            )
+        })
+        .unwrap();
+    assert_eq!(value, 7);
+}
+
+#[test]
+fn unfinished_control_transaction_is_not_reported_successful() {
+    let (_directory, store) = wal_store();
+    let result = store.control("one", |db| {
+        db.execute_batch("BEGIN; INSERT INTO runtime VALUES('unfinished',x'01')")?;
+        Ok(())
+    });
+    assert!(result.is_err());
+    assert_eq!(store.runtime("one", "unfinished").unwrap(), None);
+    store.put_runtime("one", "after", b"committed").unwrap();
+    assert_eq!(
+        store.runtime("one", "after").unwrap().unwrap(),
+        b"committed"
+    );
+}
+
+#[test]
+fn wal_reuses_checkpointed_log_and_survives_cold_store_reopen() {
+    let (directory, store) = wal_store();
+    let path = control_path(&store, "one");
+    let mut salts = BTreeSet::new();
+    let mut max_wal = 0;
+    for index in 0..12 {
+        store
+            .put_runtime("one", "large", &vec![index; 1024 * 1024])
+            .unwrap();
+        let wal = fs::read(member(&path, "-wal")).unwrap();
+        salts.insert(wal[16..24].to_vec());
+        max_wal = max_wal.max(wal.len());
+    }
+    store
+        .put_runtime("one", "tail", b"last committed value")
+        .unwrap();
+    assert!(salts.len() >= 2, "checkpointed WAL was not reused");
+    assert!(max_wal < 6 * 1024 * 1024, "unpinned WAL kept growing");
+    assert_eq!(store.admitted.lock().unwrap().cached_writers(), 1);
+    store
+        .control("one", |db| {
+            assert_eq!(
+                db.pragma_query_value(None, "synchronous", |r| r.get::<_, i64>(0))?,
+                2
+            );
+            assert_eq!(
+                db.pragma_query_value(None, "wal_autocheckpoint", |r| r.get::<_, i64>(0))?,
+                1000
+            );
+            Ok(())
+        })
+        .unwrap();
+    drop(store);
+    let reopened = Store::open_existing(&directory.path().join("data")).unwrap();
+    assert_eq!(
+        reopened.runtime("one", "large").unwrap().unwrap(),
+        vec![11; 1024 * 1024]
+    );
+    assert_eq!(
+        reopened.runtime("one", "tail").unwrap().unwrap(),
+        b"last committed value"
+    );
+}
+
+#[test]
+fn callback_error_rolls_back_but_committed_error_reconciles_by_original_key() {
+    let (_directory, store) = wal_store();
+    let error = store.control("one", |db| -> Result<()> {
+        let tx = db.transaction()?;
+        tx.execute("INSERT INTO runtime VALUES('rolled-back',x'01')", [])?;
+        bail!("synthetic callback failure");
+    });
+    assert!(error.is_err());
+    assert_eq!(store.admitted.lock().unwrap().cached_writers(), 0);
+    assert_eq!(store.runtime("one", "rolled-back").unwrap(), None);
+    let error = store.control("one", |db| -> Result<()> {
+        db.execute(
+            "INSERT INTO runtime VALUES('committed-before-error',x'02')",
+            [],
+        )?;
+        bail!("synthetic error after commit");
+    });
+    assert!(error.is_err());
+    assert_eq!(
+        store.runtime("one", "committed-before-error").unwrap(),
+        Some(vec![2])
+    );
+}
+
+#[test]
+fn external_bad_wal_is_not_checkpointed_or_changed_by_cached_close() {
+    let (_directory, store) = wal_store();
+    store.put_runtime("one", "durable", b"old").unwrap();
+    let path = control_path(&store, "one");
+    let wal_path = member(&path, "-wal");
+    let mut bytes = fs::read(&wal_path).unwrap();
+    bytes[32 + 24] ^= 1;
+    fs::write(&wal_path, bytes).unwrap();
+    let before = family(&path);
+    assert!(store.put_runtime("one", "must-not-write", b"no").is_err());
+    assert_eq!(family(&path), before);
+    assert_eq!(store.admitted.lock().unwrap().cached_writers(), 0);
+    drop(store);
+    assert_eq!(family(&path), before);

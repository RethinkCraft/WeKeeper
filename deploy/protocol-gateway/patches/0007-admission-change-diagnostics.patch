+fn database_class(path: &Path) -> &'static str {
+    match path.file_name().and_then(|name| name.to_str()) {
+        Some("registry.sqlite") => "registry",
+        Some("control.sqlite") => "account_control",
+        Some("database.sqlite") => "validation_copy",
+        _ => "other",
+    }
+}
+fn change_context(path: &Path, phase: &str, members: &[&str]) -> String {

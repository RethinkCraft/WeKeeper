+#[test]
+fn abrupt_child_exit_retains_receipts_send_identity_and_consumer_ack() {
+    for stage in ["receipt", "accepted", "poison"] {
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().join("data");
+        let status = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "control_writer_tests::writer_child",
+                "--nocapture",
+            ])
+            .env("WX_CONTROL_TEST_ROOT", &root)
+            .env("WX_CONTROL_TEST_STAGE", stage)
+            .stdout(std::process::Stdio::null())
+            .stderr(std::process::Stdio::null())
+            .status()
+            .unwrap();
+        assert!(status.success());
+        let expected: serde_json::Value =
+            serde_json::from_slice(&fs::read(directory.path().join("result.json")).unwrap())
+                .unwrap();
+        let store = Store::open_existing(&root).unwrap();
+        if stage == "poison" {
+            assert_eq!(
+                store.runtime("one", "value").unwrap().unwrap(),
+                b"committed"
+            );
+            continue;
+        }
+        assert_eq!(store.server_id, expected["server_id"].as_str().unwrap());
+        let id = expected["id"].as_str().unwrap();
+        let state = if stage == "accepted" {
+            "accepted"
+        } else {
+            "submitting"
+        };
+        let intent = store.send("one", id).unwrap();
+        assert_eq!(intent.state, state);
+        assert_eq!(intent.client_id, "7");
+        assert_eq!(store.reserve_client_id("one", "fixed-key", 99).unwrap(), 7);
+        let (same, created) = store
+            .create_send(
+                "one",
+                "fixed-key",
+                "synthetic-peer",
+                "fixed-hash",
+                b"sealed",
+                "7",
+            )
+            .unwrap();
+        assert!(!created);
+        assert_eq!(same.id, id);
+        assert_eq!(
+            store
+                .runtime("one", &format!("quote-receipt:{id}"))
+                .unwrap()
+                .unwrap(),
+            b"sealed retained receipt"
+        );
+        assert_eq!(
+            store.runtime("one", "received-cursor").unwrap().unwrap(),
+            b"native cursor"
+        );
+        assert_eq!(
+            store
+                .required_consumer("one", "bot")
+                .unwrap()
+                .acknowledged_cursor,
+            expected["ack"].as_str().unwrap()
+        );
+        assert!(store.queued_sends("one").unwrap().is_empty());
+        if stage == "accepted" {
+            assert_eq!(intent.server_id.as_deref(), Some("701"));
+            assert_eq!(store.recover_uncertain_sends("one").unwrap(), 0);
+        } else {
+            assert_eq!(store.recover_uncertain_sends("one").unwrap(), 1);
+            assert_eq!(store.send("one", id).unwrap().state, "needs_review");
+            assert_eq!(
+                store
+                    .pending_send_receipt_ids("one", "quote-receipt:")
+                    .unwrap(),
+                [id]
+            );
+        }
+    }
+}

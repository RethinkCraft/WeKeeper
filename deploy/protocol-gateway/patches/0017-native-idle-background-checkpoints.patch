+//! Same-owner WAL maintenance. Successful FULL commits never depend on this job.
+use crate::*;
+use std::sync::{
+    atomic::{AtomicBool, AtomicI64, AtomicU64, Ordering},
+    Condvar, Weak,
+};
+use std::time::{Duration, Instant};
+
+pub(crate) const FRAME_THRESHOLD: i64 = 1000;
+const MAX_FRAMES: i64 = 32768;
+const MIN_FREE: u64 = 64 * 1024 * 1024;
+const MAX_AGE: Duration = Duration::from_secs(60);
+const RETRY: Duration = Duration::from_millis(250);
+const IDLE_DELAY: Duration = Duration::from_millis(100);
+
+fn checkpoint_pressure(backlog: i64, free: Option<u64>, age: Option<Duration>) -> bool {
+    backlog >= MAX_FRAMES
+        || free.is_some_and(|bytes| bytes < MIN_FREE)
+        || age.is_some_and(|age| age >= MAX_AGE)
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Phase {
+    Idle,
+    Running,
+    Finishing,
+    Poisoned,
+    Retired,
+}
+
+struct State {
+    phase: Phase,
+    foreground: usize,
+    approved: admission::Family,
+    latest_foreground: admission::Family,
+    transfer: bool,
+    epoch: u64,
+    retiring: bool,
+    closing: bool,
+    closed: bool,
+    retry_at: Instant,
+    last_foreground_activity: Instant,
+    pending_since: Option<Instant>,
+    error: Option<&'static str>,
+    log_frames: i64,
+    checkpointed_frames: i64,
+    completed: u64,
+    free_bytes: Option<u64>,
+    checkpoint_generation: u64,
+    wal_salt: Option<[u8; 8]>,
+    space_error: bool,
+    last_rc: i32,
+    last_outcome: &'static str,
+}
+
+pub(crate) struct Ticket {
+    path: PathBuf,
+    generation: u64,
+    lease: Arc<Lease>,
+    shared: Weak<Shared>,
+    state: Mutex<State>,
+    connection: Mutex<Option<Connection>>,
+    requested: AtomicBool,
+    frames: AtomicI64,
+    signals: AtomicU64,
+    wal_generation: AtomicU64,
+    #[cfg(test)]
+    gates: TestGates,
+}
+
+#[cfg(test)]
+#[derive(Default)]
+struct TestGates {
+    before_admission: Mutex<Option<Arc<TestGate>>>,
+    before_sql: Mutex<Option<Arc<TestGate>>>,
+    after_sql: Mutex<Option<Arc<TestGate>>>,
+    before_retirement: Mutex<Option<Arc<TestGate>>>,
+    before_close: Mutex<Option<Arc<TestGate>>>,
+    before_revalidation_close: Mutex<Option<Arc<TestGate>>>,
+    forced_rc: std::sync::atomic::AtomicI32,
+}
+
+#[cfg(test)]
+#[derive(Default)]
+struct TestGate {
+    state: Mutex<(bool, bool)>,
+    wake: Condvar,
+}
+
+#[cfg(test)]
+impl TestGate {
+    fn pause(&self) {
+        let mut state = self.state.lock().unwrap();
+        state.0 = true;
+        self.wake.notify_all();
+        let deadline = Instant::now() + Duration::from_secs(5);
+        while !state.1 && Instant::now() < deadline {
+            state = self
+                .wake
+                .wait_timeout(state, Duration::from_millis(20))
+                .unwrap()
+                .0;
+        }
+    }
+    fn entered(&self) {
+        let mut state = self.state.lock().unwrap();
+        let deadline = Instant::now() + Duration::from_secs(5);
+        while !state.0 && Instant::now() < deadline {
+            state = self
+                .wake
+                .wait_timeout(state, Duration::from_millis(20))
+                .unwrap()
+                .0;
+        }
+        assert!(state.0, "checkpoint test gate was not reached");
+    }
+    fn release(&self) {
+        self.state.lock().unwrap().1 = true;
+        self.wake.notify_all();
+    }
+}
+
+#[cfg(test)]
+fn test_pause(slot: &Mutex<Option<Arc<TestGate>>>) {
+    let gate = slot.lock().unwrap().clone();
+    if let Some(gate) = gate {
+        gate.pause();
+    }
+}
+
+pub(crate) struct Hook(pub(crate) Arc<Ticket>);
+
+#[derive(Debug)]
+pub(crate) struct MaintenanceBusy;
+impl std::fmt::Display for MaintenanceBusy {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("operation_in_progress")
+    }
+}
+impl std::error::Error for MaintenanceBusy {}
+
+// SQLite calls this after the FULL commit has completed. It cannot acquire a
+// Rust mutex, inspect a path, allocate a task, report failure or run checkpoint.
+pub(crate) unsafe extern "C" fn notify(
+    data: *mut std::ffi::c_void,
+    _db: *mut rusqlite::ffi::sqlite3,
+    name: *const std::ffi::c_char,
+    frames: std::ffi::c_int,
+) -> std::ffi::c_int {
+    if data.is_null() || name.is_null() || frames < 0 {
+        return rusqlite::ffi::SQLITE_OK;
+    }
+    // SAFETY: SQLite owns the static database-name argument for this callback;
+    // the writer retains Hook until unregister, including quarantine.
+    let main = unsafe { std::ffi::CStr::from_ptr(name).to_bytes() == b"main" };
+    if main {
+        // SAFETY: register_hook supplies a live stable Box<Hook> pointer.
+        let hook = unsafe { &*(data.cast::<Hook>()) };
+        hook.0.frames.store(i64::from(frames), Ordering::Release);
+        if i64::from(frames) >= FRAME_THRESHOLD {
+            hook.0.signals.fetch_add(1, Ordering::AcqRel);
+            hook.0.requested.store(true, Ordering::Release);
+            hook.0.wake();
+        }
+    }
+    rusqlite::ffi::SQLITE_OK
+}
+
+pub(crate) fn register_hook(db: &Connection, ticket: Arc<Ticket>) -> Box<Hook> {
+    let mut hook = Box::new(Hook(ticket));
+    // SAFETY: db is the exclusively checked-out foreground connection. Hook's
+    // Box is retained alongside it and removed only before a proven safe close.
+    unsafe {
+        rusqlite::ffi::sqlite3_wal_hook(
+            db.handle(),
+            Some(notify),
+            (&mut *hook as *mut Hook).cast(),
+        );
+    }
+    hook
+}
+
+pub(crate) fn unregister_hook(db: &Connection) {
+    // SAFETY: the writer is exclusively owned here and has no active callback.
+    unsafe {
+        rusqlite::ffi::sqlite3_wal_hook(db.handle(), None, std::ptr::null_mut());
+    }
+}
+
+pub(crate) fn verify_hook(db: &Connection, hook: &Hook) -> Result<()> {
+    let pointer = (hook as *const Hook).cast_mut().cast::<std::ffi::c_void>();
+    // SAFETY: only this checked-out writer uses the handle. Reinstalling its
+    // exact hook returns the previous userdata without invoking a callback.
+    let previous = unsafe { rusqlite::ffi::sqlite3_wal_hook(db.handle(), Some(notify), pointer) };
+    anyhow::ensure!(previous == pointer, "account checkpoint hook changed");
+    Ok(())
+}
+
+fn preserve_connection(db: Connection, lease: &Arc<Lease>) {
+    std::mem::forget(db);
+    std::mem::forget(lease.clone());
+}
+
+fn close_connection(db: Connection, lease: &Arc<Lease>) -> Result<()> {
+    let protected = db.set_db_config(
+        rusqlite::config::DbConfig::SQLITE_DBCONFIG_NO_CKPT_ON_CLOSE,
+        true,
+    );
+    if !matches!(protected, Ok(true)) || !db.is_autocommit() {
+        preserve_connection(db, lease);
+        bail!("checkpoint connection unavailable; process restart required");
+    }
+    match db.close() {
+        Ok(()) => Ok(()),
+        Err((db, error)) => {
+            preserve_connection(db, lease);
+            Err(error.into())
+        }
+    }
+}
+
+impl Ticket {
+    fn frames_and_backlog(&self, state: &State) -> (i64, i64) {
+        let observed = self.frames.load(Ordering::Acquire);
+        let frames = if observed > 0 {
+            observed
+        } else {
+            state.log_frames.max(0)
+        };
+        let backlog = if self.wal_generation.load(Ordering::Acquire) == state.checkpoint_generation
+        {
+            (frames - state.checkpointed_frames.max(0)).max(0)
+        } else {
+            frames
+        };
+        (frames, backlog)
+    }
+
+    fn record_foreground_finish(&self, state: &mut State) {
+        let now = Instant::now();
+        state.last_foreground_activity = now;
+        if self.requested.load(Ordering::Acquire) {
+            // Start at the first due commit, not when idle later permits SQL.
+            // Continued control traffic must not hide the existing age cap.
+            state.pending_since.get_or_insert(now);
+        }
+    }
+
+    fn wake(&self) {
+        if let Some(shared) = self.shared.upgrade() {
+            shared.wake.notify_one();
+        }
+    }
+
+    pub(crate) fn generation(&self) -> u64 {
+        self.generation
+    }
+
+    pub(crate) fn active(&self) -> bool {
+        self.state
+            .lock()
+            .map(|s| s.foreground > 0 || matches!(s.phase, Phase::Running | Phase::Finishing))
+            .unwrap_or(true)
+    }
+
+    pub(crate) fn poisoned(&self) -> bool {
+        self.state
+            .lock()
+            .map(|s| s.phase == Phase::Poisoned)
+            .unwrap_or(true)
+    }
+
+    pub(crate) fn poison(&self, code: &'static str) {
+        if let Ok(mut state) = self.state.lock() {
+            state.phase = Phase::Poisoned;
+            state.error = Some(code);
+        }
+        self.requested.store(false, Ordering::Release);
+        self.wake();
+    }
+
+    pub(crate) fn begin(
+        self: &Arc<Self>,
+        cache: &mut admission::AdmissionCache,
+    ) -> Result<Option<Foreground>> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| anyhow::anyhow!("checkpoint state unavailable"))?;
+        anyhow::ensure!(
+            state.phase != Phase::Poisoned,
+            "account connection unavailable; process restart required"
+        );
+        if state.closing {
+            return Err(MaintenanceBusy.into());
+        }
+        if state.phase == Phase::Retired {
+            return Ok(None);
+        }
+        if state.retiring {
+            if state.foreground > 0 || matches!(state.phase, Phase::Running | Phase::Finishing) {
+                return Err(MaintenanceBusy.into());
+            }
+            state.phase = Phase::Retired;
+            return Ok(None);
+        }
+        let valid = match state.phase {
+            Phase::Idle => state.approved.exact(&self.path),
+            Phase::Running => state.latest_foreground.checkpoint_overlap(&self.path),
+            Phase::Finishing => bail!("checkpoint finishing without its foreground owner"),
+            Phase::Poisoned => bail!("account connection unavailable; process restart required"),
+            Phase::Retired => bail!("account maintenance retired"),
+        };
+        if !matches!(valid, Ok(true)) {
+            if state.phase == Phase::Idle {
+                state.phase = Phase::Retired;
+                state.retiring = true;
+                self.requested.store(false, Ordering::Release);
+                return Ok(None);
+            }
+            state.phase = Phase::Poisoned;
+            state.error = Some("checkpoint_family_changed");
+            valid?;
+            bail!("account database family changed; existing files preserved");
+        }
+        if state.transfer && state.phase == Phase::Idle {
+            // The full seal must still exactly match now. It is not a permanent
+            // exemption for metadata changes after the controlled CP epoch.
+            cache.insert(self.path.clone(), state.approved.try_clone()?);
+            state.transfer = false;
+        }
+        state.last_foreground_activity = Instant::now();
+        state.foreground += 1;
+        Ok(Some(Foreground {
+            ticket: self.clone(),
+            epoch: state.epoch,
+            finished: false,
+        }))
+    }
+
+    pub(crate) fn finish_install(&self, cache: &mut admission::AdmissionCache) -> Result<()> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| anyhow::anyhow!("checkpoint state unavailable"))?;
+        anyhow::ensure!(
+            state.foreground == 1
+                && state.phase == Phase::Idle
+                && state.approved.exact(&self.path)?,
+            "checkpoint install family changed"
+        );
+        cache.insert(self.path.clone(), state.approved.try_clone()?);
+        state.foreground = 0;
+        self.record_foreground_finish(&mut state);
+        self.wake();
+        Ok(())
+    }
+
+    pub(crate) fn retire(&self) -> Result<()> {
+        {
+            let mut state = self
+                .state
+                .lock()
+                .map_err(|_| anyhow::anyhow!("checkpoint state unavailable"))?;
+            anyhow::ensure!(
+                state.phase != Phase::Poisoned,
+                "account connection unavailable; process restart required"
+            );
+            if state.closed {
+                return Ok(());
+            }
+            if state.closing
+                || state.foreground != 0
+                || matches!(state.phase, Phase::Running | Phase::Finishing)
+            {
+                return Err(MaintenanceBusy.into());
+            }
+            state.retiring = true;
+            state.closing = true;
+            state.phase = Phase::Retired;
+        }
+        self.requested.store(false, Ordering::Release);
+        #[cfg(test)]
+        test_pause(&self.gates.before_close);
+        let db = self
+            .connection
+            .lock()
+            .map_err(|_| anyhow::anyhow!("checkpoint connection unavailable"))?
+            .take();
+        let result = match db {
+            Some(db) => close_connection(db, &self.lease),
+            None => Err(anyhow::anyhow!("checkpoint retirement lost its handle")),
+        };
+        if let Ok(mut state) = self.state.lock() {
+            state.closing = false;
+            if result.is_ok() {
+                state.closed = true;
+            } else {
+                state.phase = Phase::Poisoned;
+                state.error = Some("checkpoint_close_failed");
+            }
+        }
+        if let Some(shared) = self.shared.upgrade() {
+            shared.wake.notify_all();
+        }
+        result
+    }
+
+    fn retirement_ready(&self) -> bool {
+        self.state
+            .lock()
+            .map(|state| {
+                state.retiring
+                    && state.foreground == 0
+                    && state.phase == Phase::Retired
+                    && !state.closing
+            })
+            .unwrap_or(false)
+    }
+
+    #[cfg(test)]
+    pub(crate) fn pause_revalidation_close(&self) {
+        test_pause(&self.gates.before_revalidation_close);
+    }
+
+    pub(crate) fn defer_retirement(&self) {
+        if let Ok(mut state) = self.state.lock() {
+            state.retiring = true;
+            if state.foreground == 0 && state.phase == Phase::Idle {
+                state.phase = Phase::Retired;
+            }
+        }
+        self.requested.store(false, Ordering::Release);
+        self.wake();
+    }
+
+    fn run_due(&self) {
+        if !self.requested.load(Ordering::Acquire) {
+            return;
+        }
+        #[cfg(test)]
+        test_pause(&self.gates.before_admission);
+        let generation;
+        {
+            let Ok(mut state) = self.state.lock() else {
+                return;
+            };
+            if state.phase != Phase::Idle
+                || state.foreground != 0
+                || state.retiring
+                || Instant::now() < state.retry_at
+            {
+                return;
+            }
+            let now = Instant::now();
+            let (_, backlog) = self.frames_and_backlog(&state);
+            let age = state
+                .pending_since
+                .map(|at| now.saturating_duration_since(at));
+            if now.saturating_duration_since(state.last_foreground_activity) < IDLE_DELAY
+                && !checkpoint_pressure(backlog, state.free_bytes, age)
+            {
+                return;
+            }
+            // C1: use the last approved complete Family, never bless a current
+            // snapshot immediately before attributing its changes to checkpoint.
+            if !matches!(state.approved.exact(&self.path), Ok(true)) {
+                // No maintenance SQL has started. Restore the original strong
+                // copy-admission path on the next foreground checkout.
+                state.phase = Phase::Retired;
+                state.retiring = true;
+                state.error = Some("checkpoint_idle_revalidation_required");
+                self.requested.store(false, Ordering::Release);
+                return;
+            }
+            state.phase = Phase::Running;
+            generation = self.wal_generation.load(Ordering::Acquire);
+            state.epoch = state.epoch.saturating_add(1);
+            state.pending_since.get_or_insert_with(Instant::now);
+        }
+        self.requested.store(false, Ordering::Release);
+        let signal = self.signals.load(Ordering::Acquire);
+        let db = self.connection.lock().ok().and_then(|mut slot| slot.take());
+        let Some(db) = db else {
+            self.poison("checkpoint_connection_missing");
+            return;
+        };
+        #[cfg(test)]
+        test_pause(&self.gates.before_sql);
+        // No registry, admission, account or ticket-state mutex spans SQLite IO.
+        let mut log = -1;
+        let mut backfilled = -1;
+        // SAFETY: the worker exclusively owns this admitted maintenance handle;
+        // main names its sole operational database. PASSIVE never resets WAL.
+        let mut actual = || unsafe {
+            rusqlite::ffi::sqlite3_wal_checkpoint_v2(
+                db.handle(),
+                c"main".as_ptr(),
+                rusqlite::ffi::SQLITE_CHECKPOINT_PASSIVE,
+                &mut log,
+                &mut backfilled,
+            )
+        };
+        #[cfg(test)]
+        let rc = match self.gates.forced_rc.load(Ordering::Acquire) {
+            0 => actual(),
+            forced => forced,
+        };
+        #[cfg(not(test))]
+        let rc = actual();
+        #[cfg(test)]
+        test_pause(&self.gates.after_sql);
+        let autocommit = db.is_autocommit();
+        let free = self
+            .path
+            .parent()
+            .and_then(|parent| fs2::available_space(parent).ok());
+        // Return the handle before publishing Finishing/Idle. A foreground may
+        // complete and immediately retire this ticket once that state is visible.
+        let returned = match self.connection.lock() {
+            Ok(mut slot) if slot.is_none() => {
+                *slot = Some(db);
+                true
+            }
+            _ => {
+                preserve_connection(db, &self.lease);
+                false
+            }
+        };
+        if !returned {
+            self.poison("checkpoint_connection_unavailable");
+            return;
+        }
+        let mut poisoned = false;
+        if let Ok(mut state) = self.state.lock() {
+            if state.phase == Phase::Poisoned || !autocommit {
+                state.phase = Phase::Poisoned;
+                state.error = Some("checkpoint_operation_unavailable");
+                poisoned = true;
+            } else {
+                state.phase = Phase::Finishing;
+                let progress = backfilled >= 0
+                    && (generation != state.checkpoint_generation
+                        || i64::from(backfilled) > state.checkpointed_frames);
+                if log >= 0 {
+                    state.log_frames = i64::from(log);
+                }
+                if backfilled >= 0 {
+                    state.checkpointed_frames = i64::from(backfilled);
+                    state.checkpoint_generation = generation;
+                }
+                state.free_bytes = free;
+                state.space_error = free.is_none();
+                state.completed = state.completed.saturating_add(1);
+                let base_rc = rc & 0xff;
+                state.last_rc = rc;
+                state.last_outcome = if base_rc == rusqlite::ffi::SQLITE_BUSY {
+                    "busy"
+                } else if rc != rusqlite::ffi::SQLITE_OK {
+                    if matches!(
+                        base_rc,
+                        rusqlite::ffi::SQLITE_IOERR | rusqlite::ffi::SQLITE_FULL
+                    ) {
+                        "io_error"
+                    } else {
+                        "error"
+                    }
+                } else if log < 0 || backfilled < log {
+                    "partial"
+                } else {
+                    "complete"
+                };
+                state.error =
+                    if rc == rusqlite::ffi::SQLITE_OK || base_rc == rusqlite::ffi::SQLITE_BUSY {
+                        if free.is_none() {
+                            Some("checkpoint_space_probe_failed")
+                        } else {
+                            None
+                        }
+                    } else {
+                        Some("checkpoint_io_error")
+                    };
+                let generation_changed = self.wal_generation.load(Ordering::Acquire) != generation;
+                let incomplete = rc != rusqlite::ffi::SQLITE_OK
+                    || log < 0
+                    || backfilled < log
+                    || generation_changed;
+                let newly_requested = self.signals.load(Ordering::Acquire) != signal
+                    || self.requested.load(Ordering::Acquire);
+                if incomplete || newly_requested {
+                    self.requested.store(true, Ordering::Release);
+                    state.retry_at = Instant::now() + RETRY;
+                    if progress {
+                        state.pending_since = Some(Instant::now());
+                    }
+                } else {
+                    state.pending_since = None;
+                    state.retry_at = Instant::now();
+                }
+                // C2/C3: a legitimate FG may still be writing WAL. Last FG
+                // postflight owns its final observation and seals the epoch.
+                if state.foreground == 0 {
+                    if !matches!(
+                        state.latest_foreground.checkpoint_overlap(&self.path),
+                        Ok(true)
+                    ) {
+                        state.phase = Phase::Poisoned;
+                        state.error = Some("checkpoint_completed_family_changed");
+                        poisoned = true;
+                    } else {
+                        match admission::pin_family(&self.path) {
+                            Ok(seal) => {
+                                state.approved = seal;
+                                state.transfer = true;
+                                state.phase = if state.retiring {
+                                    Phase::Retired
+                                } else {
+                                    Phase::Idle
+                                };
+                            }
+                            Err(_) => {
+                                state.phase = Phase::Poisoned;
+                                state.error = Some("checkpoint_completed_family_changed");
+                                poisoned = true;
+                            }
+                        }
+                    }
+                }
+                if base_rc == rusqlite::ffi::SQLITE_CORRUPT
+                    || base_rc == rusqlite::ffi::SQLITE_NOTADB
+                {
+                    state.phase = Phase::Poisoned;
+                    state.error = Some("checkpoint_database_invalid");
+                    poisoned = true;
+                }
+            }
+        } else {
+            poisoned = true;
+        }
+        if poisoned {
+            self.requested.store(false, Ordering::Release);
+            let db = self.connection.lock().ok().and_then(|mut slot| slot.take());
+            if let Some(db) = db {
+                preserve_connection(db, &self.lease);
+            }
+        }
+    }
+
+    fn stop_connection(&self) {
+        if !self.poisoned() && self.retire().is_ok() {
+            return;
+        }
+        self.poison("checkpoint_shutdown_unavailable");
+        let db = self.connection.lock().ok().and_then(|mut slot| slot.take());
+        if let Some(db) = db {
+            preserve_connection(db, &self.lease);
+        }
+    }
+
+    fn health(&self, enabled: bool, stopping: bool) -> serde_json::Value {
+        let Ok(state) = self.state.lock() else {
+            return serde_json::json!({"enabled":enabled,"stopping":stopping,"state":"unavailable","blocked":true});
+        };
+        let age = state.pending_since.map(|at| at.elapsed());
+        let (frames, backlog) = self.frames_and_backlog(&state);
+        let pressure = checkpoint_pressure(backlog, state.free_bytes, age);
+        let closing = state.retiring && !state.closed;
+        let status = if state.phase == Phase::Poisoned {
+            "unavailable"
+        } else if closing {
+            "closing"
+        } else if pressure {
+            "pressure"
+        } else if state.error.is_some() {
+            "fault"
+        } else if matches!(state.phase, Phase::Running | Phase::Finishing) {
+            "running"
+        } else if self.requested.load(Ordering::Acquire) {
+            "pending"
+        } else {
+            "ready"
+        };
+        serde_json::json!({"enabled":enabled,"stopping":stopping,"state":status,"blocked":stopping || closing || pressure || state.phase == Phase::Poisoned,"generation":self.generation,"epoch":state.epoch,"foreground":state.foreground,"pending":self.requested.load(Ordering::Acquire),"walFrames":frames,"uncheckpointedFrames":backlog,"checkpointedFrames":state.checkpointed_frames,"completed":state.completed,"lastRc":state.last_rc,"lastOutcome":state.last_outcome,"pendingAgeMs":age.map(|age| age.as_millis() as u64),"freeBytes":state.free_bytes,"spaceProbeError":state.space_error,"error":state.error})
+    }
+}
+
+pub(crate) struct Foreground {
+    ticket: Arc<Ticket>,
+    epoch: u64,
+    finished: bool,
+}
+
+impl Foreground {
+    pub(crate) fn finish(
+        mut self,
+        observed: admission::Family,
+        cache: &mut admission::AdmissionCache,
+    ) -> Result<()> {
+        let salt = observed.wal_generation(&self.ticket.path)?;
+        let mut state = self
+            .ticket
+            .state
+            .lock()
+            .map_err(|_| anyhow::anyhow!("checkpoint state unavailable"))?;
+        anyhow::ensure!(
+            state.phase != Phase::Poisoned && state.foreground == 1 && state.epoch == self.epoch,
+            "account checkpoint epoch unavailable"
+        );
+        anyhow::ensure!(
+            observed.exact_control_members()
+                && state.approved.control_identities(&self.ticket.path)?,
+            "account checkpoint family changed during operation"
+        );
+        state.latest_foreground = observed.try_clone()?;
+        if salt != state.wal_salt {
+            state.wal_salt = salt;
+            self.ticket.wal_generation.fetch_add(1, Ordering::AcqRel);
+            if state.phase == Phase::Finishing {
+                self.ticket.requested.store(true, Ordering::Release);
+                state.retry_at = Instant::now() + RETRY;
+                state.pending_since = Some(Instant::now());
+            }
+        }
+        cache.insert(self.ticket.path.clone(), observed.try_clone()?);
+        if matches!(state.phase, Phase::Idle | Phase::Finishing) {
+            state.approved = observed;
+            state.transfer = false;
+            state.phase = if state.retiring {
+                Phase::Retired
+            } else {
+                Phase::Idle
+            };
+        }
+        state.foreground = 0;
+        self.ticket.record_foreground_finish(&mut state);
+        self.finished = true;
+        self.ticket.wake();
+        Ok(())
+    }
+}
+
+impl Drop for Foreground {
+    fn drop(&mut self) {
+        if !self.finished {
+            if let Ok(mut state) = self.ticket.state.lock() {
+                state.foreground = state.foreground.saturating_sub(1);
+                state.phase = Phase::Poisoned;
+                state.error = Some("checkpoint_foreground_unfinished");
+            }
+            self.ticket.wake();
+        }
+    }
+}
+
+struct Shared {
+    tickets: Mutex<std::collections::BTreeMap<PathBuf, Arc<Ticket>>>,
+    wake_lock: Mutex<()>,
+    wake: Condvar,
+    stopping: AtomicBool,
+    generation: AtomicU64,
+    setup_failed: AtomicBool,
+}
+
+pub(crate) struct Manager {
+    shared: Arc<Shared>,
+    enabled: AtomicBool,
+    worker: Mutex<Option<std::thread::JoinHandle<()>>>,
+    lease: Arc<Lease>,
+}
+
+impl Manager {
+    pub(crate) fn new(lease: Arc<Lease>) -> Self {
+        Self {
+            shared: Arc::new(Shared {
+                tickets: Mutex::new(Default::default()),
+                wake_lock: Mutex::new(()),
+                wake: Condvar::new(),
+                stopping: AtomicBool::new(false),
+                generation: AtomicU64::new(1),
+                setup_failed: AtomicBool::new(false),
+            }),
+            enabled: AtomicBool::new(false),
+            worker: Mutex::new(None),
+            lease,
+        }
+    }
+
+    pub(crate) fn enabled(&self) -> bool {
+        self.enabled.load(Ordering::Acquire)
+    }
+
+    pub(crate) fn enable(&self) -> Result<()> {
+        anyhow::ensure!(
+            !self.shared.stopping.load(Ordering::Acquire),
+            "checkpoint maintenance stopped"
+        );
+        let mut worker = self
+            .worker
+            .lock()
+            .map_err(|_| anyhow::anyhow!("checkpoint worker unavailable"))?;
+        if worker.is_some() {
+            return Ok(());
+        }
+        let shared = self.shared.clone();
+        *worker = Some(
+            std::thread::Builder::new()
+                .name("control-checkpoint".into())
+                .spawn(move || {
+                    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                        while !shared.stopping.load(Ordering::Acquire) {
+                            let tickets = match shared.tickets.lock() {
+                                Ok(tickets) => tickets.values().cloned().collect::<Vec<_>>(),
+                                Err(_) => break,
+                            };
+                            for ticket in tickets {
+                                if shared.stopping.load(Ordering::Acquire) {
+                                    break;
+                                }
+                                ticket.run_due();
+                                if ticket.retirement_ready() {
+                                    #[cfg(test)]
+                                    test_pause(&ticket.gates.before_retirement);
+                                    match ticket.retire() {
+                                        Ok(()) => {
+                                            if let Ok(mut tickets) = shared.tickets.lock() {
+                                                if tickets.get(&ticket.path).is_some_and(
+                                                    |current| Arc::ptr_eq(current, &ticket),
+                                                ) {
+                                                    tickets.remove(&ticket.path);
+                                                }
+                                            }
+                                        }
+                                        Err(error) if error.is::<MaintenanceBusy>() => {}
+                                        Err(_) => ticket.poison("checkpoint_retirement_failed"),
+                                    }
+                                }
+                            }
+                            let Ok(guard) = shared.wake_lock.lock() else {
+                                break;
+                            };
+                            if shared.stopping.load(Ordering::Acquire) {
+                                break;
+                            }
+                            drop(shared.wake.wait_timeout(guard, Duration::from_millis(50)));
+                        }
+                    }));
+                    if result.is_err() || !shared.stopping.load(Ordering::Acquire) {
+                        shared.setup_failed.store(true, Ordering::Release);
+                    }
+                    // request_stop leaves idle handles untouched: in-flight FULL
+                    // result persistence may still use their approved family.
+                })?,
+        );
+        self.enabled.store(true, Ordering::Release);
+        Ok(())
+    }
+
+    pub(crate) fn create(&self, path: &Path) -> Result<Arc<Ticket>> {
+        anyhow::ensure!(
+            self.enabled() && !self.shared.stopping.load(Ordering::Acquire),
+            "checkpoint maintenance not running"
+        );
+        let approved = admission::pin_family(path)?;
+        anyhow::ensure!(
+            approved.exact_control_members(),
+            "checkpoint requires exact WAL family"
+        );
+        let db = admission::open_checkpoint(path, &approved, &self.lease)?;
+        let approved = admission::pin_family(path)?;
+        let frames = i64::from(approved.published_frames(path)?);
+        let salt = approved.wal_generation(path)?;
+        let ticket = Arc::new(Ticket {
+            path: path.into(),
+            generation: self.shared.generation.fetch_add(1, Ordering::AcqRel),
+            lease: self.lease.clone(),
+            shared: Arc::downgrade(&self.shared),
+            state: Mutex::new(State {
+                phase: Phase::Idle,
+                foreground: 1,
+                latest_foreground: approved.try_clone()?,
+                approved,
+                transfer: false,
+                epoch: 0,
+                retiring: false,
+                closing: false,
+                closed: false,
+                retry_at: Instant::now(),
+                last_foreground_activity: Instant::now(),
+                pending_since: None,
+                error: None,
+                log_frames: frames,
+                checkpointed_frames: 0,
+                completed: 0,
+                free_bytes: None,
+                checkpoint_generation: 0,
+                wal_salt: salt,
+                space_error: false,
+                last_rc: 0,
+                last_outcome: "not_run",
+            }),
+            connection: Mutex::new(Some(db)),
+            requested: AtomicBool::new(true),
+            frames: AtomicI64::new(frames),
+            signals: AtomicU64::new(0),
+            wal_generation: AtomicU64::new(0),
+            #[cfg(test)]
+            gates: TestGates::default(),
+        });
+        let mut tickets = self
+            .shared
+            .tickets
+            .lock()
+            .map_err(|_| anyhow::anyhow!("checkpoint tickets unavailable"))?;
+        anyhow::ensure!(
+            !tickets.contains_key(path),
+            "checkpoint ticket already exists"
+        );
+        tickets.insert(path.into(), ticket.clone());
+        Ok(ticket)
+    }
+
+    pub(crate) fn unavailable_ticket(&self, path: &Path) -> bool {
+        self.shared
+            .tickets
+            .lock()
+            .map(|tickets| tickets.contains_key(path))
+            .unwrap_or(true)
+    }
+
+    pub(crate) fn retire(&self, ticket: &Arc<Ticket>) -> Result<()> {
+        ticket.retire()?;
+        let mut tickets = self
+            .shared
+            .tickets
+            .lock()
+            .map_err(|_| anyhow::anyhow!("checkpoint tickets unavailable"))?;
+        if tickets
+            .get(&ticket.path)
+            .is_some_and(|current| Arc::ptr_eq(current, ticket))
+        {
+            tickets.remove(&ticket.path);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn wait_retirement(&self, path: &Path, deadline: Instant) -> Result<bool> {
+        let ticket = self
+            .shared
+            .tickets
+            .lock()
+            .map_err(|_| anyhow::anyhow!("checkpoint tickets unavailable"))?
+            .get(path)
+            .cloned();
+        let Some(ticket) = ticket else {
+            return Ok(false);
+        };
+        self.wait_ticket_retirement(&ticket, deadline)
+    }
+
+    pub(crate) fn wait_ticket_retirement(
+        &self,
+        ticket: &Arc<Ticket>,
+        deadline: Instant,
+    ) -> Result<bool> {
+        loop {
+            {
+                let state = ticket
+                    .state
+                    .lock()
+                    .map_err(|_| anyhow::anyhow!("checkpoint state unavailable"))?;
+                anyhow::ensure!(
+                    state.phase != Phase::Poisoned,
+                    "account connection unavailable; process restart required"
+                );
+                if state.closed {
+                    return Ok(true);
+                }
+                if !state.retiring && !state.closing {
+                    return Ok(false);
+                }
+            }
+            let remaining = deadline.saturating_duration_since(Instant::now());
+            if remaining.is_zero() {
+                return Err(MaintenanceBusy.into());
+            }
+            let guard = self
+                .shared
+                .wake_lock
+                .lock()
+                .map_err(|_| anyhow::anyhow!("checkpoint wait unavailable"))?;
+            // No Ticket, registry, admission or SQLite lock spans this wait.
+            // The short timeout also covers notification races and stopped workers.
+            drop(
+                self.shared
+                    .wake
+                    .wait_timeout(guard, remaining.min(Duration::from_millis(20)))
+                    .map_err(|_| anyhow::anyhow!("checkpoint wait unavailable"))?,
+            );
+        }
+    }
+
+    pub(crate) fn setup_fault(&self) {
+        self.shared.setup_failed.store(true, Ordering::Release);
+    }
+    pub(crate) fn setup_ok(&self) -> bool {
+        !self.shared.setup_failed.load(Ordering::Acquire)
+    }
+
+    pub(crate) fn request_stop(&self) {
+        self.shared.stopping.store(true, Ordering::Release);
+        self.shared.wake.notify_all();
+    }
+
+    pub(crate) fn stop_join(&self) {
+        self.request_stop();
+        // Hold only this handle-ownership lock until exit, so every concurrent
+        // caller returns after the worker has ended, not merely after take().
+        let mut worker = self.worker.lock().unwrap_or_else(|poison| {
+            self.setup_fault();
+            poison.into_inner()
+        });
+        if let Some(handle) = worker.take() {
+            if handle.join().is_err() {
+                self.setup_fault();
+            }
+        }
+    }
+
+    pub(crate) fn close_after_join(&self) {
+        let tickets = self
+            .shared
+            .tickets
+            .lock()
+            .map(|tickets| tickets.values().cloned().collect::<Vec<_>>())
+            .unwrap_or_default();
+        for ticket in tickets {
+            ticket.stop_connection();
+        }
+    }
+
+    pub(crate) fn health(&self, path: &Path) -> serde_json::Value {
+        let enabled = self.enabled();
+        let stopping = self.shared.stopping.load(Ordering::Acquire);
+        if !self.setup_ok() {
+            return serde_json::json!({"enabled":enabled,"stopping":stopping,"state":"setup_failed","blocked":true});
+        }
+        let ticket = self
+            .shared
+            .tickets
+            .lock()
+            .ok()
+            .and_then(|tickets| tickets.get(path).cloned());
+        match ticket {
+            Some(ticket) => ticket.health(enabled, stopping),
+            None => {
+                serde_json::json!({"enabled":enabled,"stopping":stopping,"state":if enabled { "waiting_for_wal" } else { "disabled" },"blocked":stopping})
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "background_checkpoint_tests.rs"]
+mod tests;
+
+impl Store {
+    /// Native Core enables this once; ordinary Stores preserve SQLite defaults.
+    pub fn enable_background_checkpoints(&self) -> Result<()> {
+        anyhow::ensure!(
+            self.snapshot.is_none(),
+            "read snapshot cannot enable maintenance"
+        );
+        let manager = self
+            .checkpoints
+            .as_ref()
+            .context("read snapshot cannot enable maintenance")?;
+        manager.enable()?;
+        self.admitted
+            .lock()
+            .map_err(|_| anyhow::anyhow!("database admission lock poisoned"))?
+            .manager = Some(manager.clone());
+        for account in self.accounts()? {
+            self.control(&account.id, |_| Ok(()))?;
+        }
+        anyhow::ensure!(manager.setup_ok(), "checkpoint maintenance setup failed");
+        Ok(())
+    }
+
+    pub fn checkpoint_health(&self, account: &str) -> Result<serde_json::Value> {
+        self.account(account)?;
+        if self.snapshot.is_some() {
+            return Ok(
+                serde_json::json!({"enabled":false,"stopping":false,"state":"disabled","blocked":false}),
+            );
+        }
+        Ok(self
+            .checkpoints
+            .as_ref()
+            .context("checkpoint manager unavailable")?
+            .health(&self.account_dir(account)?.join("agent/control.sqlite")))
+    }
+
+    /// Wait only for local handle retirement; no callback or remote send is replayed.
+    pub fn wait_checkpoint_retirement(&self, account: &str) -> Result<()> {
+        self.account(account)?;
+        if self.snapshot.is_none() {
+            if let Some(manager) = &self.checkpoints {
+                manager.wait_retirement(
+                    &self.account_dir(account)?.join("agent/control.sqlite"),
+                    Instant::now() + Duration::from_secs(2),
+                )?;
+            }
+        }
+        Ok(())
+    }
+
+    pub fn request_checkpoint_stop(&self) {
+        if let Some(manager) = &self.checkpoints {
+            if manager.enabled() {
+                manager.request_stop();
+            }
+        }
+    }
+
+    /// Finish only the maintenance worker. In-flight FULL writes keep their
+    /// SQLite handles; the owner Drop closes those after foreground users end.
+    pub fn join_checkpoint_worker(&self) {
+        if let Some(manager) = &self.checkpoints {
+            if manager.enabled() {
+                manager.stop_join();
+            }
+        }
+    }
+}

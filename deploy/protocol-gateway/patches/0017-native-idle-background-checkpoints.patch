@@ -0,0 +1,190 @@
+//! Local lifecycle coverage; no real upstream or checkpoint load.
+use super::*;
+use crate::upstream::{Upstream, UpstreamKind};
+use std::{fs, sync::atomic::AtomicUsize};
+
+struct LocalOnly {
+    kind: UpstreamKind,
+    network_calls: AtomicUsize,
+}
+impl LocalOnly {
+    fn new(kind: UpstreamKind) -> Arc<Self> {
+        Arc::new(Self {
+            kind,
+            network_calls: AtomicUsize::new(0),
+        })
+    }
+}
+impl Upstream for LocalOnly {
+    fn kind(&self) -> UpstreamKind {
+        self.kind
+    }
+    fn native(
+        &self,
+        _options: wechat_protocol::NativeOptions,
+    ) -> Result<wechat_protocol::NativeClient> {
+        self.network_calls.fetch_add(1, Ordering::SeqCst);
+        bail!("unexpected_network_operation")
+    }
+}
+
+#[test]
+fn standalone_and_simulator_keep_checkpoint_maintenance_disabled() {
+    let directory = tempfile::tempdir().unwrap();
+    let store = Arc::new(Store::open(&directory.path().join("data")).unwrap());
+    store.create_account("one").unwrap();
+    assert_eq!(store.checkpoint_health("one").unwrap()["enabled"], false);
+    fs::write(
+        store.root.join(crate::upstream::SIMULATOR_MARKER),
+        crate::upstream::SIMULATOR_MARKER_CONTENT,
+    )
+    .unwrap();
+    let upstream = LocalOnly::new(UpstreamKind::Simulator);
+    let core = Core::with_upstream(store, None, upstream.clone()).unwrap();
+    assert_eq!(
+        core.storage_maintenance_health("one").unwrap()["enabled"],
+        false
+    );
+    assert_eq!(
+        core.account_status("one").unwrap()["checkpointMaintenance"]["enabled"],
+        false
+    );
+    core.shutdown();
+    assert_eq!(upstream.network_calls.load(Ordering::SeqCst), 0);
+}
+
+#[test]
+fn native_snapshot_health_uses_live_manager_and_snapshot_drop_does_not_stop_it() {
+    let directory = tempfile::tempdir().unwrap();
+    let store = Arc::new(Store::open(&directory.path().join("data")).unwrap());
+    store.create_account("one").unwrap();
+    let upstream = LocalOnly::new(UpstreamKind::Native);
+    let core = Core::with_upstream(store.clone(), None, upstream.clone()).unwrap();
+    assert_eq!(
+        core.storage_maintenance_health("one").unwrap()["enabled"],
+        true
+    );
+    let snapshot = Arc::new(store.read_snapshot("one").unwrap());
+    assert_eq!(snapshot.checkpoint_health("one").unwrap()["enabled"], false);
+    let view = Core {
+        store: snapshot,
+        shared: core.shared.clone(),
+        snapshot_reader: None,
+        live_store: Some(store.clone()),
+    };
+    assert_eq!(
+        view.storage_maintenance_health("one").unwrap()["enabled"],
+        true
+    );
+    drop(view);
+    assert_eq!(
+        core.storage_maintenance_health("one").unwrap()["stopping"],
+        false
+    );
+    core.shutdown();
+    assert_eq!(
+        core.storage_maintenance_health("one").unwrap()["stopping"],
+        true
+    );
+    assert_eq!(upstream.network_calls.load(Ordering::SeqCst), 0);
+}
+
+#[test]
+fn native_startup_recovers_submitted_intent_locally_before_enabling_maintenance() {
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path().join("data");
+    let store = Arc::new(Store::open(&root).unwrap());
+    store.create_account("one").unwrap();
+    let original =
+        Core::with_upstream(store.clone(), None, LocalOnly::new(UpstreamKind::Native)).unwrap();
+    store.put_runtime("one", "desired", b"connected").unwrap();
+    let intent = store
+        .create_send("one", "pending", "room", "hash", b"frozen", "7")
+        .unwrap()
+        .0;
+    assert!(store.claim_send("one", &intent.id).unwrap());
+    drop(original);
+    drop(store);
+    let reopened = Arc::new(Store::open_existing(&root).unwrap());
+    assert_eq!(reopened.checkpoint_health("one").unwrap()["enabled"], false);
+    let upstream = LocalOnly::new(UpstreamKind::Native);
+    let core = Core::with_upstream(reopened.clone(), None, upstream.clone()).unwrap();
+    let recovered = reopened.send("one", &intent.id).unwrap();
+    assert_eq!(recovered.state, "needs_review");
+    assert_eq!(
+        recovered.error_code.as_deref(),
+        Some("restart_after_submission")
+    );
+    assert_eq!(
+        core.storage_maintenance_health("one").unwrap()["enabled"],
+        true
+    );
+    assert_eq!(upstream.network_calls.load(Ordering::SeqCst), 0);
+}
+
+#[test]
+fn health_and_shutdown_do_not_replay_accepted_send_when_profile_record_is_unreadable() {
+    let directory = tempfile::tempdir().unwrap();
+    let store = Arc::new(Store::open(&directory.path().join("data")).unwrap());
+    store.create_account("one").unwrap();
+    let upstream = LocalOnly::new(UpstreamKind::Native);
+    let core = Core::with_upstream(store.clone(), None, upstream.clone()).unwrap();
+    let intent = store
+        .create_send("one", "accepted", "room", "hash", b"frozen", "7")
+        .unwrap()
+        .0;
+    store
+        .update_send("one", &intent.id, "accepted", Some("17"), None)
+        .unwrap();
+    let before = serde_json::to_value(store.send("one", &intent.id).unwrap()).unwrap();
+    store
+        .put_runtime(
+            "one",
+            "profile-identity-binding",
+            b"invalid-protected-record",
+        )
+        .unwrap();
+    assert!(core.account_status("one").is_err());
+    assert_eq!(
+        core.storage_maintenance_health("one").unwrap()["enabled"],
+        true
+    );
+    core.shutdown();
+    assert_eq!(
+        core.storage_maintenance_health("one").unwrap()["stopping"],
+        true
+    );
+    store
+        .clear_runtime("one", "profile-identity-binding")
+        .unwrap();
+    assert_eq!(
+        serde_json::to_value(store.send("one", &intent.id).unwrap()).unwrap(),
+        before
+    );
+    assert_eq!(upstream.network_calls.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn stopped_storage_maintenance_blocks_new_session_before_upstream() {
+    let directory = tempfile::tempdir().unwrap();
+    let store = Arc::new(Store::open(&directory.path().join("data")).unwrap());
+    store.create_account("one").unwrap();
+    let upstream = LocalOnly::new(UpstreamKind::Native);
+    let core = Core::with_upstream(store.clone(), None, upstream.clone()).unwrap();
+    store.request_checkpoint_stop();
+    let entered = AtomicBool::new(false);
+    let error = core
+        .session_request("one", "checkpoint-test", |_| async {
+            entered.store(true, Ordering::SeqCst);
+            Ok(())
+        })
+        .await
+        .unwrap_err();
+    assert_eq!(error.to_string(), "storage_maintenance_blocked");
+    assert_eq!(
+        core.sync_operation("one").unwrap_err().to_string(),
+        "storage_maintenance_blocked"
+    );
+    assert!(!entered.load(Ordering::SeqCst));
+    assert_eq!(upstream.network_calls.load(Ordering::SeqCst), 0);
+}

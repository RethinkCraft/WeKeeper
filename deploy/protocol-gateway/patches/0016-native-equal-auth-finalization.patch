+            .blocked_authorization_snapshot("one")
+            .unwrap()
+            .unwrap();
+        match change {
+            "owner" => store
+                .put_runtime("one", "validated-generation", b"new")
+                .unwrap(),
+            "epoch" => store.put_runtime("one", "logout-epoch", b"new").unwrap(),
+            "desired" => store
+                .put_runtime("one", "desired", b"disconnected")
+                .unwrap(),
+            "logout" => store.put_runtime("one", "logged-out", b"new").unwrap(),
+            "cipher" => store
+                .save_accepted_authorization("one", b"other-auth")
+                .unwrap(),
+            _ => unreachable!(),
+        }
+        assert!(!store
+            .repair_blocked_authorization("one", &repair, FRESH)
+            .unwrap());
+        assert_raw(&store, &intent);
+        canary(&store);
+    }
+}

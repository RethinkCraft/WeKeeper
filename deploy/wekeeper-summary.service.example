[Unit]
Description=WeKeeper local ChatGPT plan summaries
After=network-online.target wekeeper-sync.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/WeKeeper
ExecStart=%h/Desktop/WeKeeper/.venv/bin/python -m chatlog_keeper.dashboard.cli --archive-state %h/Desktop/wechat-linux-poc/state summarize
EnvironmentFile=-%h/.config/wekeeper/environment
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target

+                "one",
+                "saved-login-projected-state-generation",
+                b"previous-cipher-hash",
+            )
+            .unwrap();
+        store
+            .put_runtime(
+                "one",
+                "quote-receipt:fixture",
+                b"sealed-authenticated-raw-receipt",
+            )
+            .unwrap();
+        let (intent, _) = store
+            .create_send("one", "key", "room", "payload-hash", b"sealed-payload", "7")
+            .unwrap();
+        assert!(store.claim_send("one", &intent.id).unwrap());
+        store
+            .control("one", |db| {
+                db.execute_batch("CREATE TEMP TABLE finalization_canary(value)")?;
+                Ok(())
+            })
+            .unwrap();
+        (directory, store, intent, generation)
+    }
+    // This calls the production baseline's exact adjacent Store operations. The
+    // old Core ignores the projection result and independently persists send final.
+    fn finalize(store: &Store, intent: &SendIntent, generation: &str) -> Result<SendIntent> {
+        let proof =
+            UnchangedSavedLoginCompletion::new(b"accepted-cipher", None, generation, "owner")?;
+        store.update_send_after_unchanged_projection(
+            "one",
+            SendFinalUpdate {
+                id: &intent.id,
+                state: "accepted",
+                server_id: Some("99"),
+                error: None,
+            },
+            &proof,
+        )
+    }
+
+    #[test]
+    fn unchanged_projection_and_accepted_send_should_need_one_full_commit() {
+        let (_directory, store, intent, generation) = setup();
+        let trace = Commits::new(&store);
+        let final_intent = finalize(&store, &intent, &generation).unwrap();
+        assert_eq!(final_intent.state, "accepted");
+        assert!(store
+            .runtime("one", "saved-login-projection-needed")
+            .unwrap()
+            .is_none());
+        assert_eq!(
+            store
+                .runtime("one", "quote-receipt:fixture")
+                .unwrap()
+                .unwrap(),
+            b"sealed-authenticated-raw-receipt"
+        );
+        eprintln!("UNCHANGED_FINAL_COMMIT_COUNT {}", trace.count());
+        assert_eq!(
+            trace.count(),
+            1,
+            "same-account unchanged completion and send final are still two FULL commits"
+        );
+    }
+    #[test]
+    fn failed_projection_metadata_does_not_discard_accepted_send_or_retained_receipt() {
+        let (_directory, store, intent, generation) = setup();
+        store.control("one",|db| {
+        db.execute_batch("CREATE TRIGGER reject_projection_metadata BEFORE UPDATE OF value ON runtime WHEN NEW.key='saved-login-projected-state-generation' BEGIN SELECT RAISE(FAIL,'synthetic projection metadata failure'); END")?;Ok(())
+    }).unwrap();
+        let accepted = finalize(&store, &intent, &generation).unwrap();
+        assert_eq!(accepted.state, "accepted");
+        assert_eq!(accepted.server_id.as_deref(), Some("99"));
+        assert_eq!(
+            store
+                .runtime("one", "quote-receipt:fixture")
+                .unwrap()
+                .unwrap(),
+            b"sealed-authenticated-raw-receipt"
+        );
+        assert!(store
+            .runtime("one", "saved-login-projection-needed")
+            .unwrap()
+            .is_some());
+    }
+    #[test]
+    fn superseded_projection_epoch_does_not_discard_accepted_send_evidence() {
+        let (_directory, store, intent, generation) = setup();
+        store
+            .put_runtime("one", "logout-epoch", b"new-epoch")
+            .unwrap();
+        let accepted = finalize(&store, &intent, &generation).unwrap();
+        assert_eq!(accepted.state, "accepted");
+        assert!(store
+            .runtime("one", "saved-login-projection-needed")
+            .unwrap()
+            .is_some());
+        assert_eq!(
+            store
+                .runtime("one", "quote-receipt:fixture")
+                .unwrap()
+                .unwrap(),
+            b"sealed-authenticated-raw-receipt"
+        );
+    }
+    fn canary(store: &Store) -> bool {
+        store.control("one",|db| Ok(db.query_row("SELECT EXISTS(SELECT 1 FROM sqlite_temp_master WHERE name='finalization_canary')",[],|r|r.get(0))?)).unwrap()
+    }
+    #[test]
+    fn expected_projection_fence_changes_keep_writer_and_send_result() {
+        for mutation in [
+            "logout",
+            "epoch",
+            "owner",
+            "auth",
+            "accepted-marker",
+            "journal",
+            "projected-generation",
+        ] {
+            let (_dir, store, intent, generation) = setup();
+            match mutation {
+                "logout" => store.put_runtime("one", "logged-out", b"epoch").unwrap(),
+                "epoch" => store.put_runtime("one", "logout-epoch", b"epoch").unwrap(),
+                "owner" => store
+                    .put_runtime("one", "validated-generation", b"new-owner")
+                    .unwrap(),
+                "auth" => store
+                    .save_accepted_authorization("one", b"new-accepted-state")
+                    .unwrap(),
+                "accepted-marker" => store
+                    .put_runtime("one", "saved-login-accepted-state-generation", b"wrong")
+                    .unwrap(),
+                "journal" => store
+                    .put_runtime("one", "saved-login-publication", b"new-pending-journal")
+                    .unwrap(),
+                "projected-generation" => store
+                    .put_runtime("one", "saved-login-projected-generation", b"new-generation")
+                    .unwrap(),
+                _ => unreachable!(),
+            }
+            let accepted = finalize(&store, &intent, &generation).unwrap();
+            assert_eq!(accepted.state, "accepted");
+            assert!(store
+                .runtime("one", "saved-login-projection-needed")
+                .unwrap()
+                .is_some());
+            assert_eq!(
+                store
+                    .runtime("one", "saved-login-projected-state-generation")
+                    .unwrap()
+                    .unwrap(),
+                b"previous-cipher-hash"
+            );
+            assert!(
+                canary(&store),
+                "expected fence skip evicted writer: {mutation}"
+            );
+        }
+    }
+    #[test]
+    fn marker_write_error_invalidates_writer_before_original_final_write() {
+        let (_dir, store, intent, generation) = setup();
+        assert!(canary(&store));
+        store.control("one",|db| {db.execute_batch("CREATE TRIGGER reject_projection_metadata BEFORE UPDATE OF value ON runtime WHEN NEW.key='saved-login-projected-state-generation' BEGIN SELECT RAISE(FAIL,'synthetic metadata failure'); END")?;Ok(())}).unwrap();
+        assert_eq!(
+            finalize(&store, &intent, &generation).unwrap().state,
+            "accepted"
+        );
+        assert!(!canary(&store), "actual SQL failure retained failed writer");
+    }
+    #[test]
+    fn final_write_failure_rolls_back_projection_markers_and_retains_receipt() {
+        let (_dir, store, intent, generation) = setup();
+        store.control("one",|db| {db.execute_batch("CREATE TRIGGER reject_final BEFORE UPDATE ON outbox WHEN NEW.state='accepted' BEGIN SELECT RAISE(FAIL,'synthetic final failure'); END")?;Ok(())}).unwrap();
+        assert!(finalize(&store, &intent, &generation).is_err());
+        assert_eq!(store.send("one", &intent.id).unwrap().state, "submitting");
+        assert_eq!(
+            store
+                .runtime("one", "saved-login-projected-state-generation")
+                .unwrap()
+                .unwrap(),
+            b"previous-cipher-hash"
+        );
+        assert!(store
+            .runtime("one", "saved-login-projection-needed")
+            .unwrap()
+            .is_some());
+        assert_eq!(
+            store
+                .runtime("one", "quote-receipt:fixture")
+                .unwrap()
+                .unwrap(),
+            b"sealed-authenticated-raw-receipt"
+        );
+    }
+    #[test]
+    fn rejected_unknown_and_cancelled_send_states_keep_existing_update_semantics() {
+        for (state, error) in [
+            ("failed", Some("service_rejected")),
+            ("needs_review", Some("quote_receipt_unverified")),
+            ("cancelled", None),
+        ] {
+            let (_dir, store, intent, generation) = setup();
+            if state == "cancelled" {
+                store
+                    .update_send("one", &intent.id, "cancelled", None, None)
+                    .unwrap();
+            }
+            let proof =
+                UnchangedSavedLoginCompletion::new(b"accepted-cipher", None, &generation, "owner")
+                    .unwrap();
+            let updated = store
+                .update_send_after_unchanged_projection(
+                    "one",
+                    SendFinalUpdate {
+                        id: &intent.id,
+                        state: if state == "cancelled" {
+                            "accepted"
+                        } else {
+                            state
+                        },
+                        server_id: Some("99"),
+                        error,
+                    },
+                    &proof,
+                )
+                .unwrap();
+            assert_eq!(updated.state, state);
+            assert_eq!(updated.error_code.as_deref(), error);
+        }
+    }
+    unsafe extern "C" fn deny_commit(
+        _context: *mut c_void,
+        action: std::ffi::c_int,
+        first: *const std::ffi::c_char,
+        _second: *const std::ffi::c_char,
+        _database: *const std::ffi::c_char,
+        _trigger: *const std::ffi::c_char,
+    ) -> std::ffi::c_int {
+        if action == rusqlite::ffi::SQLITE_TRANSACTION
+            && !first.is_null()
+            && CStr::from_ptr(first).to_bytes() == b"COMMIT"
+        {
+            rusqlite::ffi::SQLITE_DENY
+        } else {
+            rusqlite::ffi::SQLITE_OK
+        }
+    }
+    #[test]
+    fn shared_final_commit_failure_rolls_back_markers_but_never_erases_durable_receipt() {
+        let (_dir, store, intent, generation) = setup();
+        store
+            .control("one", |db| {
+                let rc = unsafe {
+                    rusqlite::ffi::sqlite3_set_authorizer(
+                        db.handle(),
+                        Some(deny_commit),
+                        std::ptr::null_mut(),
+                    )
+                };
+                anyhow::ensure!(rc == rusqlite::ffi::SQLITE_OK, "authorizer setup failed");
+                Ok(())
+            })
+            .unwrap();
+        assert!(finalize(&store, &intent, &generation).is_err());
+        assert_eq!(store.send("one", &intent.id).unwrap().state, "submitting");
+        assert!(store
+            .runtime("one", "saved-login-projection-needed")
+            .unwrap()
+            .is_some());
+        assert_eq!(
+            store
+                .runtime("one", "saved-login-projected-state-generation")
+                .unwrap()
+                .unwrap(),
+            b"previous-cipher-hash"
+        );
+        assert_eq!(
+            store
+                .runtime("one", "quote-receipt:fixture")
+                .unwrap()
+                .unwrap(),
+            b"sealed-authenticated-raw-receipt"
+        );
+        assert!(!canary(&store));
+    }

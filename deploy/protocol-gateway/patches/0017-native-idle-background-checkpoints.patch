+#[test]
+fn concurrent_worker_joins_wait_for_sql_without_closing_inflight_handles() {
+    let (tmp, store, ticket) = enabled();
+    let before_sql = arm(&ticket.gates.before_sql);
+    request(&ticket);
+    before_sql.entered();
+    let held = Arc::new(TestGate::default());
+    let callback = held.clone();
+    let active = store.clone();
+    let foreground = std::thread::spawn(move || {
+        active.control("one", |db| {
+            db.execute(
+                "INSERT INTO runtime(key,value) VALUES('before-worker-join',X'31')",
+                [],
+            )?;
+            callback.pause();
+            db.execute(
+                "INSERT INTO runtime(key,value) VALUES('after-worker-join',X'32')",
+                [],
+            )?;
+            Ok(())
+        })
+    });
+    held.entered();
+    let returned = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let first_store = store.clone();
+    let first_returned = returned.clone();
+    let first = std::thread::spawn(move || {
+        first_store.join_checkpoint_worker();
+        first_returned.fetch_add(1, Ordering::AcqRel);
+    });
+    let manager = store.checkpoints.as_ref().unwrap();
+    until(|| manager.shared.stopping.load(Ordering::Acquire) && manager.worker.try_lock().is_err());
+    let second_started = Arc::new(AtomicBool::new(false));
+    let second_entered = second_started.clone();
+    let second_store = store.clone();
+    let second_returned = returned.clone();
+    let second = std::thread::spawn(move || {
+        second_entered.store(true, Ordering::Release);
+        second_store.join_checkpoint_worker();
+        second_returned.fetch_add(1, Ordering::AcqRel);
+    });
+    until(|| second_started.load(Ordering::Acquire));
+    assert_eq!(returned.load(Ordering::Acquire), 0);
+    before_sql.release();
+    first.join().unwrap();
+    second.join().unwrap();
+    assert_eq!(returned.load(Ordering::Acquire), 2);
+    assert!(ticket.connection.lock().unwrap().is_some());
+    assert!(store.db.try_lock().is_err(), "foreground is still active");
+    held.release();
+    foreground.join().unwrap().unwrap();
+    store
+        .put_runtime("one", "joined-followup", b"full")
+        .unwrap();
+    assert_eq!(
+        store.runtime("one", "after-worker-join").unwrap().unwrap(),
+        b"2"
+    );
+    drop(ticket);
+    let root = tmp.path().join("data");
+    drop(store);
+    let reopened = Store::open_existing(&root).unwrap();
+    assert_eq!(
+        reopened
+            .runtime("one", "before-worker-join")
+            .unwrap()
+            .unwrap(),
+        b"1"
+    );
+    assert_eq!(
+        reopened
+            .runtime("one", "after-worker-join")
+            .unwrap()
+            .unwrap(),
+        b"2"
+    );
+    assert_eq!(
+        reopened.runtime("one", "joined-followup").unwrap().unwrap(),
+        b"full"
+    );
+}

[Unit]
Description=WeKeeper native protocol gateway
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
WorkingDirectory=@PROJECT_ROOT@
UMask=0077
ExecStart=@GATEWAY_EXECUTABLE@ --server-config @GATEWAY_CONFIG@ --listen 127.0.0.1:@GATEWAY_PORT@ serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target

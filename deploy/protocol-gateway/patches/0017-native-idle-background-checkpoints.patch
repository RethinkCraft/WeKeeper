+pub(super) fn header_generation(header: &[u8]) -> Result<[u8; 8]> {
+    ensure!(header.len() == 32, "incomplete checkpoint WAL header");
+    let magic = be(header);
+    ensure!(
+        matches!(magic, 0x377f0682 | 0x377f0683) && be(&header[4..]) == 3007000,
+        "unrecognized checkpoint WAL header"
+    );
+    ensure!(
+        checksum(&header[..24], magic & 1 != 0, [0, 0]) == [be(&header[24..]), be(&header[28..])],
+        "invalid checkpoint WAL header checksum"
+    );
+    Ok(header[16..24].try_into().expect("fixed WAL salt slice"))
+}

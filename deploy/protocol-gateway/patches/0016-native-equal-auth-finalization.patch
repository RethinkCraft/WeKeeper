+#[test]
+fn authorization_superseded_during_rpc_never_installs_old_result() {
+    for change in ["owner", "epoch", "cipher", "logout"] {
+        let (_dir, store, intent, snapshot) = setup();
+        match change {
+            "owner" => store
+                .put_runtime("one", "validated-generation", b"new-owner")
+                .unwrap(),
+            "epoch" => store
+                .put_runtime("one", "logout-epoch", b"new-epoch")
+                .unwrap(),
+            "cipher" => store
+                .save_accepted_authorization("one", b"newer-auth")
+                .unwrap(),
+            "logout" => store
+                .put_runtime("one", "logged-out", b"new-epoch")
+                .unwrap(),
+            _ => unreachable!(),
+        }
+        assert!(matches!(
+            store
+                .retain_equal_send_receipt("one", &intent.id, RAW, Some(&snapshot))
+                .unwrap(),
+            ReceiptDisposition::AuthorizationSuperseded
+        ));
+        assert!(!store
+            .save_accepted_equal_fallback("one", &snapshot, b"stale-rpc-result")
+            .unwrap());
+        assert_ne!(
+            store.runtime("one", "account-state").unwrap().as_deref(),
+            Some(b"stale-rpc-result".as_slice())
+        );
+        assert_raw(&store, &intent);
+        canary(&store);
+    }
+}

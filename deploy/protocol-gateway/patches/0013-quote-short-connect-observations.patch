+++ b/packages/native-client-rust/crates/wechat-protocol/src/short_http_connect.rs
@@ -0,0 +1,251 @@
+//! Optional observations around reqwest's actual short HTTP connector.
+use crate::rpc_observation::{Observer, Outcome, Phase};
+use std::{
+    future::Future,
+    pin::Pin,
+    sync::Arc,
+    task::{Context, Poll},
+    time::Instant,
+};
+use tower::{Layer, Service};
+
+pub(crate) fn observed(
+    builder: reqwest::blocking::ClientBuilder,
+    observer: Option<&dyn Observer>,
+) -> reqwest::blocking::ClientBuilder {
+    match observer.and_then(|observer| observer.owned()) {
+        Some(observer) => builder.connector_layer(ConnectLayer(observer)),
+        None => builder,
+    }
+}
+
+#[derive(Clone)]
+struct ConnectLayer(Arc<dyn Observer>);
+
+impl<S> Layer<S> for ConnectLayer {
+    type Service = ConnectService<S>;
+
+    fn layer(&self, inner: S) -> Self::Service {
+        ConnectService {
+            inner,
+            observer: self.0.clone(),
+        }
+    }
+}
+
+#[derive(Clone)]
+struct ConnectService<S> {
+    inner: S,
+    observer: Arc<dyn Observer>,
+}
+
+impl<S, Request> Service<Request> for ConnectService<S>
+where
+    S: Service<Request>,
+{
+    type Response = S::Response;
+    type Error = S::Error;
+    type Future = ConnectFuture<S::Future>;
+
+    fn poll_ready(&mut self, context: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+        self.inner.poll_ready(context)
+    }
+
+    fn call(&mut self, request: Request) -> Self::Future {
+        let span = ConnectSpan::new(self.observer.clone());
+        let future = self.inner.call(request);
+        ConnectFuture {
+            future: Box::pin(future),
+            span,
+        }
+    }
+}
+
+struct ConnectFuture<F> {
+    future: Pin<Box<F>>,
+    span: ConnectSpan,
+}
+
+impl<F, T, E> Future for ConnectFuture<F>
+where
+    F: Future<Output = Result<T, E>>,
+{
+    type Output = Result<T, E>;
+
+    fn poll(self: Pin<&mut Self>, context: &mut Context<'_>) -> Poll<Self::Output> {
+        let this = self.get_mut();
+        match this.future.as_mut().poll(context) {
+            Poll::Pending => Poll::Pending,
+            Poll::Ready(result) => {
+                this.span.finish(if result.is_ok() {
+                    Outcome::Ok
+                } else {
+                    Outcome::Error
+                });
+                Poll::Ready(result)
+            }
+        }
+    }
+}
+
+struct ConnectSpan {
+    observer: Arc<dyn Observer>,
+    started: Option<Instant>,
+}
+
+impl ConnectSpan {
+    fn new(observer: Arc<dyn Observer>) -> Self {
+        observer.begin(Phase::ShortHttpConnect);
+        Self {
+            observer,
+            started: Some(Instant::now()),
+        }
+    }
+
+    fn finish(&mut self, outcome: Outcome) {
+        if let Some(started) = self.started.take() {
+            self.observer
+                .end(Phase::ShortHttpConnect, started.elapsed(), outcome);
+        }
+    }
+}
+
+impl Drop for ConnectSpan {
+    fn drop(&mut self) {
+        self.finish(Outcome::Incomplete);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{
+        future::{pending, ready, Pending, Ready},
+        sync::{
+            atomic::{AtomicUsize, Ordering},
+            Mutex,
+        },
+        task::{Wake, Waker},
+        time::Duration,
+    };
+
+    #[derive(Debug, PartialEq, Eq)]
+    enum Event {
+        Begin,
+        End(Outcome),
+    }
+    #[derive(Default)]
+    struct Recorder(Mutex<Vec<Event>>);
+    impl Observer for Recorder {
+        fn begin(&self, phase: Phase) {
+            assert_eq!(phase, Phase::ShortHttpConnect);
+            self.0.lock().unwrap().push(Event::Begin);
+        }
+        fn end(&self, phase: Phase, _: Duration, outcome: Outcome) {
+            assert_eq!(phase, Phase::ShortHttpConnect);
+            self.0.lock().unwrap().push(Event::End(outcome));
+        }
+    }
+    struct Noop;
+    impl Wake for Noop {
+        fn wake(self: Arc<Self>) {}
+    }
+
+    struct Immediate {
+        result: Result<u8, &'static str>,
+        ready: Result<(), &'static str>,
+        called: Arc<AtomicUsize>,
+    }
+    impl Service<u8> for Immediate {
+        type Response = u8;
+        type Error = &'static str;
+        type Future = Ready<Result<u8, &'static str>>;
+        fn poll_ready(&mut self, _: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+            Poll::Ready(self.ready)
+        }
+        fn call(&mut self, request: u8) -> Self::Future {
+            assert_eq!(request, 7);
+            self.called.fetch_add(1, Ordering::SeqCst);
+            ready(self.result)
+        }
+    }
+
+    #[test]
+    fn connector_layer_forwards_request_result_and_error_without_extra_calls() {
+        for result in [Ok(9), Err("synthetic connection error")] {
+            let recorder = Arc::new(Recorder::default());
+            let called = Arc::new(AtomicUsize::new(0));
+            let mut service = ConnectLayer(recorder.clone()).layer(Immediate {
+                result,
+                ready: Ok(()),
+                called: called.clone(),
+            });
+            let waker = Waker::from(Arc::new(Noop));
+            let mut context = Context::from_waker(&waker);
+            assert_eq!(service.poll_ready(&mut context), Poll::Ready(Ok(())));
+            let mut future = Box::pin(service.call(7));
+            assert_eq!(future.as_mut().poll(&mut context), Poll::Ready(result));
+            drop(future);
+            assert_eq!(called.load(Ordering::SeqCst), 1);
+            assert_eq!(
+                *recorder.0.lock().unwrap(),
+                [
+                    Event::Begin,
+                    Event::End(if result.is_ok() {
+                        Outcome::Ok
+                    } else {
+                        Outcome::Error
+                    })
+                ]
+            );
+        }
+    }
+
+    #[test]
+    fn connector_layer_preserves_readiness_failure_without_a_connection_span() {
+        let recorder = Arc::new(Recorder::default());
+        let called = Arc::new(AtomicUsize::new(0));
+        let mut service = ConnectLayer(recorder.clone()).layer(Immediate {
+            result: Ok(9),
+            ready: Err("synthetic readiness error"),
+            called: called.clone(),
+        });
+        let waker = Waker::from(Arc::new(Noop));
+        let mut context = Context::from_waker(&waker);
+        assert_eq!(
+            service.poll_ready(&mut context),
+            Poll::Ready(Err("synthetic readiness error"))
+        );
+        assert_eq!(called.load(Ordering::SeqCst), 0);
+        assert!(recorder.0.lock().unwrap().is_empty());
+    }
+
+    struct Never;
+    impl Service<()> for Never {
+        type Response = ();
+        type Error = ();
+        type Future = Pending<Result<(), ()>>;
+        fn poll_ready(&mut self, _: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+            Poll::Ready(Ok(()))
+        }
+        fn call(&mut self, _: ()) -> Self::Future {
+            pending()
+        }
+    }
+
+    #[test]
+    fn connector_layer_dropped_pending_future_is_incomplete() {
+        let recorder = Arc::new(Recorder::default());
+        let mut service = ConnectLayer(recorder.clone()).layer(Never);
+        let mut future = Box::pin(service.call(()));
+        let waker = Waker::from(Arc::new(Noop));
+        let mut context = Context::from_waker(&waker);
+        assert_eq!(future.as_mut().poll(&mut context), Poll::Pending);
+        assert_eq!(*recorder.0.lock().unwrap(), [Event::Begin]);
+        drop(future);
+        assert_eq!(
+            *recorder.0.lock().unwrap(),
+            [Event::Begin, Event::End(Outcome::Incomplete)]
+        );
+    }
+}

+
+/// Correlate an authenticated Linux 4.1.13.26 CGI222 subtype-57 response with
+/// the saved attempt. The owner must seal the original bytes before decoding.
+/// Shape evidence: one isolated live quote response, 359 bytes, SHA-256
+/// 96da66294d9e29c2254da90e83b88d42b25ee8f503a8d14326e272fd28df2cd1.
+/// Fields 3/4/6 matched the saved sender/destination/client ID independently;
+/// their positions also agree with the existing strict app-message file decoder.
+/// Field 8 was 57. Fields 5/7 are checked as nonzero u32, not correlated with
+/// the request timestamp (the live response was one second later). Unknown
+/// extension contents establish neither quote-target identity nor phone receipt.
+pub fn decode_quote_send_correlated(
+    input: &[u8],
+    sender: &str,
+    destination: &str,
+    client_id: &str,
+) -> Result<MediaSendResult> {
+    ensure!(
+        identity(sender, false)
+            && identity(destination, false)
+            && client_id
+                .parse::<u32>()
+                .is_ok_and(|id| id > 0 && id.to_string() == client_id),
+        "invalid_quote_receipt_identity"
+    );
+    let fields = p::decode(input)?;
+    // Even ignored extensions cannot smuggle competing values into this single
+    // response. Do not select the first/last duplicate or search arbitrary fields.
+    let mut seen = std::collections::BTreeSet::new();
+    for field in &fields {
+        ensure!(seen.insert(field.number), "ambiguous_quote_response_field");
+    }
+    let base = p::decode(p::data(&fields, 1)?)?;
+    seen.clear();
+    for field in &base {
+        ensure!(seen.insert(field.number), "ambiguous_quote_response_status");
+    }
+    let raw_code = p::scalar(&base, 1)?;
+    let code = raw_code as i32;
+    ensure!(
+        raw_code == code as i64 as u64,
+        "invalid_quote_response_status"
+    );
+    p::optional_data(&base, 2)?;
+    if code != 0 {
+        return Ok(MediaSendResult {
+            status: SendStatus::Rejected,
+            service_code: code,
+            server_message_id: None,
+            client_id_matches: None,
+        });
+    }
+    for (number, expected) in [(3, sender), (4, destination), (6, client_id)] {
+        ensure!(
+            p::data(&fields, number)? == expected.as_bytes(),
+            "quote_receipt_identity_mismatch"
+        );
+    }
+    for number in [5, 7] {
+        ensure!(
+            u32::try_from(p::scalar(&fields, number)?)? > 0,
+            "invalid_quote_response_scalar"
+        );
+    }
+    ensure!(
+        p::scalar(&fields, 8)? == 57,
+        "quote_receipt_subtype_mismatch"
+    );
+    let server = p::scalar(&fields, 9)?;
+    ensure!(server > 0, "quote_receipt_server_id_missing");
+    // Observed extension wires only; no AES key requirement or inferred meaning.
+    for number in [11, 14] {
+        p::optional_data(&fields, number)?;
+    }
+    if let Some(value) = p::optional(&fields, 12)? {
+        ensure!(
+            matches!(value, p::Value::Varint(_)),
+            "invalid_quote_response_extension"
+        );
+    }
+    Ok(MediaSendResult {
+        status: SendStatus::ServerAccepted,
+        service_code: 0,
+        server_message_id: Some(server.to_string()),
+        client_id_matches: Some(true),
+    })
 }
 

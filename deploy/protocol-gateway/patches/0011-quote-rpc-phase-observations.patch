+//! Optional typed observations. No request, identity, endpoint or error values.
+use anyhow::Result;
+use std::time::{Duration, Instant};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Phase {
+    QuoteRequestPrepare,
+    SessionConnect,
+    DnsTcpConnect,
+    MmtlsHandshake,
+    AuthenticatedPacketPrepare,
+    ShortPacketPrepare,
+    HttpClientPrepare,
+    ShortHttp,
+    MmtlsReplyDecode,
+    AuthenticatedReplyDecode,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Outcome {
+    Ok,
+    Error,
+    Incomplete,
+}
+
+/// Observation callbacks cannot replace an RPC result. Callers supply a
+/// non-panicking sink; the native daemon uses its private bounded trace sink.
+pub trait Observer: Send + Sync {
+    fn begin(&self, phase: Phase);
+    fn end(&self, phase: Phase, duration: Duration, outcome: Outcome);
+}
+
+struct Span<'a> {
+    observer: &'a dyn Observer,
+    phase: Phase,
+    started: Option<Instant>,
+}
+
+impl Span<'_> {
+    fn finish(mut self, outcome: Outcome) {
+        if let Some(started) = self.started.take() {
+            self.observer.end(self.phase, started.elapsed(), outcome);
+        }
+    }
+}
+
+impl Drop for Span<'_> {
+    fn drop(&mut self) {
+        if let Some(started) = self.started.take() {
+            self.observer
+                .end(self.phase, started.elapsed(), Outcome::Incomplete);
+        }
+    }
+}
+
+pub(crate) fn measure<T>(
+    observer: Option<&dyn Observer>,
+    phase: Phase,
+    action: impl FnOnce() -> Result<T>,
+) -> Result<T> {
+    let Some(observer) = observer else {
+        // No timer, global sink, state or diagnostic allocation when disabled.
+        return action();
+    };
+    observer.begin(phase);
+    let span = Span {
+        observer,
+        phase,
+        started: Some(Instant::now()),
+    };
+    let result = action();
+    span.finish(if result.is_ok() {
+        Outcome::Ok
+    } else {
+        Outcome::Error
+    });
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{
+        atomic::{AtomicUsize, Ordering},
+        Mutex,
+    };
+
+    #[derive(Debug, PartialEq, Eq)]
+    enum Event {
+        Begin(Phase),
+        End(Phase, Outcome),
+    }
+    #[derive(Default)]
+    struct Recorder(Mutex<Vec<Event>>);
+    impl Observer for Recorder {
+        fn begin(&self, phase: Phase) {
+            self.0.lock().unwrap().push(Event::Begin(phase));
+        }
+        fn end(&self, phase: Phase, _duration: Duration, outcome: Outcome) {
+            self.0.lock().unwrap().push(Event::End(phase, outcome));
+        }
+    }
+
+    #[test]
+    fn disabled_runs_the_original_action_once_and_preserves_error() {
+        let count = AtomicUsize::new(0);
+        let result: Result<()> = measure(None, Phase::SessionConnect, || {
+            count.fetch_add(1, Ordering::SeqCst);
+            anyhow::bail!("synthetic transport failure")
+        });
+        assert_eq!(count.load(Ordering::SeqCst), 1);
+        assert_eq!(
+            result.unwrap_err().to_string(),
+            "synthetic transport failure"
+        );
+    }
+
+    #[test]
+    fn enabled_nested_phases_preserve_order_and_result_without_error_values() {
+        let recorder = Recorder::default();
+        let result: Result<()> = measure(Some(&recorder), Phase::SessionConnect, || {
+            measure(Some(&recorder), Phase::DnsTcpConnect, || Ok(()))?;
+            measure(Some(&recorder), Phase::MmtlsHandshake, || {
+                anyhow::bail!("private synthetic error")
+            })
+        });
+        assert_eq!(result.unwrap_err().to_string(), "private synthetic error");
+        let events = recorder.0.lock().unwrap();
+        assert_eq!(
+            *events,
+            [
+                Event::Begin(Phase::SessionConnect),
+                Event::Begin(Phase::DnsTcpConnect),
+                Event::End(Phase::DnsTcpConnect, Outcome::Ok),
+                Event::Begin(Phase::MmtlsHandshake),
+                Event::End(Phase::MmtlsHandshake, Outcome::Error),
+                Event::End(Phase::SessionConnect, Outcome::Error)
+            ]
+        );
+        assert!(!format!("{events:?}").contains("private synthetic error"));
+    }
+
+    #[test]
+    fn unwound_phase_is_incomplete_not_successful() {
+        let recorder = Recorder::default();
+        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _: Result<()> = measure(Some(&recorder), Phase::ShortHttp, || {
+                panic!("synthetic unwind")
+            });
+        }));
+        assert_eq!(
+            *recorder.0.lock().unwrap(),
+            [
+                Event::Begin(Phase::ShortHttp),
+                Event::End(Phase::ShortHttp, Outcome::Incomplete)
+            ]
+        );
+    }
+}

index 0000000000000000000000000000000000000000..ad69a267f7feb72cd0aef61f12a9b9ab727822be
--- /dev/null
+++ b/packages/native-client-rust/crates/wechat-store/src/control_connections.rs
@@ -0,0 +1,246 @@
+//! Owned operational connections, never official-profile connections.
+use crate::*;
+use rusqlite::config::DbConfig;
+use std::{collections::BTreeMap, mem::ManuallyDrop};
+
+const CAPACITY: usize = 8;
+
+#[derive(Default)]
+pub(crate) struct ControlConnections {
+    pub(crate) admitted: admission::AdmissionCache,
+    writers: BTreeMap<PathBuf, Writer>,
+    sequence: u64,
+}
+
+enum Writer {
+    Idle { db: Connection, used: u64 },
+    Unavailable { _held: Quarantined },
+}
+
+// An unknown family must never be rolled back/checkpointed by a destructor.
+// A failed close also must not release ownership while its handle is live.
+// Such an account requires process restart; OS cleanup then releases both.
+struct Quarantined {
+    _db: ManuallyDrop<Connection>,
+    _lease: ManuallyDrop<Arc<Lease>>,
+}
+
+fn no_close_checkpoint(db: &Connection) -> Result<()> {
+    anyhow::ensure!(
+        db.set_db_config(DbConfig::SQLITE_DBCONFIG_NO_CKPT_ON_CLOSE, true)?,
+        "cannot disable account close checkpoint"
+    );
+    Ok(())
+}
+
+fn full_defaults(db: &Connection) -> Result<()> {
+    let synchronous: i64 = db.pragma_query_value(None, "synchronous", |row| row.get(0))?;
+    let checkpoint: i64 = db.pragma_query_value(None, "wal_autocheckpoint", |row| row.get(0))?;
+    anyhow::ensure!(
+        synchronous == 2 && checkpoint == 1000,
+        "account connection durability settings changed"
+    );
+    Ok(())
+}
+
+impl ControlConnections {
+    fn quarantine(&mut self, path: &Path, db: Connection, lease: &Arc<Lease>) {
+        self.admitted.remove(path);
+        self.writers.insert(
+            path.into(),
+            Writer::Unavailable {
+                _held: Quarantined {
+                    _db: ManuallyDrop::new(db),
+                    _lease: ManuallyDrop::new(lease.clone()),
+                },
+            },
+        );
+    }
+
+    fn close_idle(&mut self, path: &Path, db: Connection, lease: &Arc<Lease>) -> Result<()> {
+        // This function can run after an external path change. Only connection
+        // configuration and autocommit inspection are allowed before close.
+        if no_close_checkpoint(&db).is_err() || !db.is_autocommit() {
+            self.quarantine(path, db, lease);
+            bail!("account connection unavailable; process restart required");
+        }
+        match db.close() {
+            Ok(()) => Ok(()),
+            Err((db, error)) => {
+                self.quarantine(path, db, lease);
+                Err(error).context("account connection close failed; process restart required")
+            }
+        }
+    }
+
+    pub(crate) fn evict(&mut self, path: &Path, lease: &Arc<Lease>) -> Result<()> {
+        match self.writers.remove(path) {
+            Some(Writer::Idle { db, .. }) => self.close_idle(path, db, lease)?,
+            Some(entry @ Writer::Unavailable { .. }) => {
+                self.writers.insert(path.into(), entry);
+                bail!("account connection unavailable; process restart required");
+            }
+            None => {}
+        }
+        self.admitted.remove(path);
+        Ok(())
+    }
+
+    fn make_room(&mut self, lease: &Arc<Lease>) -> Result<()> {
+        if self.writers.len() < CAPACITY {
+            return Ok(());
+        }
+        let path = self
+            .writers
+            .iter()
+            .filter_map(|(path, entry)| match entry {
+                Writer::Idle { used, .. } => Some(((*used, path), path.clone())),
+                Writer::Unavailable { .. } => None,
+            })
+            .min_by_key(|(key, _)| *key)
+            .map(|(_, path)| path)
+            .context("account connection capacity unavailable; process restart required")?;
+        self.evict(&path, lease)
+    }
+
+    fn checkout(&mut self, path: &Path, lease: &Arc<Lease>) -> Result<Connection> {
+        if matches!(self.writers.get(path), Some(Writer::Unavailable { .. })) {
+            bail!("account connection unavailable; process restart required");
+        }
+        // Use exactly the original RW probe and family predicate before any
+        // SQLite work, including on a long-lived handle.
+        let unchanged = admission::permission_probe(path)
+            .and_then(|()| admission::known_unchanged(&self.admitted, path));
+        match self.writers.remove(path) {
+            Some(Writer::Idle { db, .. }) if matches!(unchanged, Ok(true)) => {
+                if !db.is_autocommit() {
+                    self.quarantine(path, db, lease);
+                    bail!("account connection unavailable; process restart required");
+                }
+                return Ok(db);
+            }
+            Some(Writer::Idle { db, .. }) => {
+                self.close_idle(path, db, lease)?;
+                self.admitted.remove(path);
+            }
+            Some(Writer::Unavailable { .. }) => unreachable!("checked above"),
+            None => {}
+        }
+        unchanged?;
+        self.make_room(lease)?;
+        let (db, ()) =
+            admission::open_prepared(path, Some(&self.admitted), Store::prepare_account)?;
+        if let Err(error) = no_close_checkpoint(&db) {
+            self.close_idle(path, db, lease)?;
+            return Err(error);
+        }
+        Ok(db)
+    }
+
+    pub(crate) fn run<T>(
+        &mut self,
+        path: &Path,
+        lease: &Arc<Lease>,
+        f: impl FnOnce(&mut Connection) -> Result<T>,
+    ) -> Result<T> {
+        let mut db = self.checkout(path, lease)?;
+        let pin = match admission::pin_family(path) {
+            Ok(pin) => pin,
+            Err(error) => {
+                self.admitted.remove(path);
+                self.close_idle(path, db, lease)?;
+                return Err(error);
+            }
+        };
+        let initial_wal =
+            match db.pragma_query_value(None, "journal_mode", |row| row.get::<_, String>(0)) {
+                Ok(mode) => mode == "wal",
+                Err(error) => {
+                    self.admitted.remove(path);
+                    self.close_idle(path, db, lease)?;
+                    return Err(error.into());
+                }
+            };
+        // Preserve preparation on cache hits as well as fresh connections.
+        let result = Store::prepare_account(&mut db)
+            .and_then(|()| full_defaults(&db))
+            .and_then(|()| f(&mut db));
+        let same_files = pin.identities_unchanged(path, initial_wal && !db.is_autocommit());
+        if !matches!(same_files, Ok(true)) {
+            self.admitted.remove(path);
+            self.close_idle(path, db, lease)?;
+            same_files?;
+            bail!("account database family changed during operation; existing files preserved");
+        }
+        if !db.is_autocommit() {
+            if db.execute_batch("ROLLBACK").is_err() || !db.is_autocommit() {
+                self.quarantine(path, db, lease);
+                bail!("account transaction cleanup failed; process restart required");
+            }
+            self.admitted.remove(path);
+            self.close_idle(path, db, lease)?;
+            return Err(result.err().unwrap_or_else(|| {
+                anyhow::anyhow!("account callback left an unfinished transaction")
+            }));
+        }
+        let value = match result {
+            Ok(value) => value,
+            Err(error) => {
+                self.admitted.remove(path);
+                self.close_idle(path, db, lease)?;
+                return Err(error);
+            }
+        };
+        let settings = full_defaults(&db);
+        if let Err(error) = settings {
+            self.admitted.remove(path);
+            self.close_idle(path, db, lease)?;
+            return Err(error);
+        }
+        if let Err(error) = no_close_checkpoint(&db) {
+            self.admitted.remove(path);
+            self.close_idle(path, db, lease)?;
+            return Err(error);
+        }
+        let mode: String = match db.pragma_query_value(None, "journal_mode", |row| row.get(0)) {
+            Ok(mode) => mode,
+            Err(error) => {
+                self.admitted.remove(path);
+                self.close_idle(path, db, lease)?;
+                return Err(error.into());
+            }
+        };
+        let same_files = pin.identities_unchanged(path, initial_wal && mode == "wal");
+        if !matches!(same_files, Ok(true)) {
+            self.admitted.remove(path);
+            self.close_idle(path, db, lease)?;
+            same_files?;
+            bail!("account database family changed during operation; existing files preserved");
+        }
+        if mode != "wal" {
+            // DELETE and other existing modes retain their previous lifetime.
+            self.close_idle(path, db, lease)?;
+            admission::remember(&mut self.admitted, path)?;
+            return Ok(value);
+        }
+        if let Err(error) = admission::remember(&mut self.admitted, path) {
+            self.admitted.remove(path);
+            self.close_idle(path, db, lease)?;
+            return Err(error);
+        }
+        self.sequence = self.sequence.saturating_add(1);
+        self.writers.insert(
+            path.into(),
+            Writer::Idle {
+                db,
+                used: self.sequence,
+            },
+        );
+        Ok(value)
+    }
+
+    #[cfg(test)]
+    pub(crate) fn cached_writers(&self) -> usize {
+        self.writers.len()
+    }
+}

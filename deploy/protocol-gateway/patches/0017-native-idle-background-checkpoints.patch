+fn until(mut ready: impl FnMut() -> bool) {
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while Instant::now() < deadline {
+        if ready() {
+            return;
+        }
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    assert!(ready(), "checkpoint condition did not finish");
+}
+
+fn prepared() -> (tempfile::TempDir, Arc<Store>) {
+    let tmp = tempfile::tempdir().unwrap();
+    let store = Arc::new(Store::open(&tmp.path().join("data")).unwrap());
+    store.create_account("one").unwrap();
+    drop(store.read_snapshot("one").unwrap());
+    (tmp, store)
+}
+
+fn resident(store: &Store) -> Arc<Ticket> {
+    let path = store
+        .account_dir("one")
+        .unwrap()
+        .join("agent/control.sqlite");
+    store
+        .checkpoints
+        .as_ref()
+        .unwrap()
+        .shared
+        .tickets
+        .lock()
+        .unwrap()
+        .get(&path)
+        .unwrap()
+        .clone()
+}
+
+fn enabled() -> (tempfile::TempDir, Arc<Store>, Arc<Ticket>) {
+    let (tmp, store) = prepared();
+    store.enable_background_checkpoints().unwrap();
+    let ticket = resident(&store);
+    until(|| {
+        let state = ticket.state.lock().unwrap();
+        state.completed > 0 && state.phase == Phase::Idle
+    });
+    (tmp, store, ticket)
+}
+
+fn request(ticket: &Ticket) {
+    ticket.requested.store(true, Ordering::Release);
+    ticket.wake();
+}

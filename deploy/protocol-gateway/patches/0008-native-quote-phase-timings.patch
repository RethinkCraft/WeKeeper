+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn disabled_has_no_identity_allocation_or_events() {
+        let trace = Timings::default().command("private-account", "private-key", Runtime::Native);
+        assert!(trace.sink.is_none());
+        assert!(trace.command_id.is_none());
+        assert!(trace.command_key_hash.is_none());
+        assert_eq!(trace.measure(Stage::RawRpc, || Ok::<_, ()>(7)), Ok(7));
+    }
+
+    #[test]
+    fn command_hashes_are_length_delimited_and_events_exclude_raw_inputs() {
+        let (sink, receiver) = Timings::channel(32);
+        let a = sink.command("private-account", "private-key", Runtime::Native);
+        let again = sink.command("private-account", "private-key", Runtime::Native);
+        assert_eq!(a.command_key_hash, again.command_key_hash);
+        assert_ne!(a.command_id, again.command_id);
+        assert_ne!(
+            sink.command("ab", "c", Runtime::Native).command_key_hash,
+            sink.command("a", "bc", Runtime::Native).command_key_hash
+        );
+        let id = uuid::Uuid::new_v4().to_string();
+        let worker = a.bind(&id, Outcome::Created).worker();
+        assert_eq!(
+            worker.measure(Stage::RawRpc, || Err::<(), _>("private-token-error")),
+            Err("private-token-error")
+        );
+        let rows: Vec<_> = receiver
+            .try_iter()
+            .map(|row| serde_json::to_value(row).unwrap())
+            .collect();
+        let text = serde_json::to_string(&rows).unwrap();
+        for secret in ["private-account", "private-key", "private-token-error"] {
+            assert!(!text.contains(secret));
+        }
+        assert_eq!(rows[0]["intent_id"], id);
+        assert_eq!(rows[2]["outcome"], "error");
+        assert!(rows[2]["duration_us"].is_u64());
+        assert!(rows[2]["unix_us"].as_u64().unwrap() > 0);
+    }
+
+    #[test]
+    fn incomplete_scope_and_recovered_worker_are_explicit() {
+        let (sink, receiver) = Timings::channel(8);
+        let trace = sink.recovered_worker(&uuid::Uuid::new_v4().to_string(), Runtime::Native);
+        drop(trace.span(Stage::WorkerTotal));
+        let rows: Vec<_> = receiver
+            .try_iter()
+            .map(|row| serde_json::to_value(row).unwrap())
+            .collect();
+        assert_eq!(rows[1]["outcome"], "incomplete");
+        assert_eq!(rows[1]["recovery_context_missing"], true);
+        assert!(rows[1]["command_key_hash"].is_null());
+        assert!(rows[1]["attempt_id"].is_string());
+    }
+
+    #[test]
+    fn full_or_disconnected_sink_keeps_result_and_reports_loss() {
+        let (sink, receiver) = Timings::channel(1);
+        let trace = sink.command("account", "key", Runtime::Simulator);
+        assert_eq!(trace.measure(Stage::RawRpc, || Ok::<_, ()>(42)), Ok(42));
+        let _ = receiver.try_recv().unwrap();
+        trace.span(Stage::ReceiptRetain).finish(Outcome::Ok);
+        let row = receiver.try_recv().unwrap();
+        assert!(row.dropped_records > 0);
+        assert!(row.sequence > 1);
+        drop(receiver);
+        assert_eq!(trace.measure(Stage::RawRpc, || Err::<(), _>(9)), Err(9));
+    }
+
+    #[test]
+    fn writer_error_disconnects_without_affecting_send() {
+        struct Broken;
+        impl Write for Broken {
+            fn write(&mut self, _: &[u8]) -> std::io::Result<usize> {
+                Err(std::io::ErrorKind::BrokenPipe.into())
+            }
+            fn flush(&mut self) -> std::io::Result<()> {
+                panic!("timings must not flush")
+            }
+        }
+        let (sink, receiver) = Timings::channel(8);
+        let trace = sink.command("account", "key", Runtime::Native);
+        trace.span(Stage::RawRpc).finish(Outcome::Ok);
+        write_records(Broken, receiver, sink.0.as_ref().unwrap().dropped.clone());
+        assert_eq!(
+            trace.measure(Stage::ReceiptRetain, || Ok::<_, ()>(1)),
+            Ok(1)
+        );
+        assert!(sink.0.as_ref().unwrap().dropped.load(Ordering::Relaxed) >= 2);
+    }
+}

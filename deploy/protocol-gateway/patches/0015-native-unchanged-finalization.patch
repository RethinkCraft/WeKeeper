+//! Complete an unchanged saved-login projection with a send's final record.
+//! Accepted authorization and raw receipts are already separately committed.
+use crate::*;
+use rusqlite::{OptionalExtension, Transaction};
+
+pub struct UnchangedSavedLoginCompletion {
+    state_cipher: Vec<u8>,
+    logout_epoch: Option<Vec<u8>>,
+    credential_generation: String,
+    owner: String,
+}
+impl UnchangedSavedLoginCompletion {
+    /// Construct only after all existing official-profile/credentials/routing
+    /// checks have proved the unchanged path. This is not a profile cache.
+    pub fn new(cipher: &[u8], epoch: Option<&[u8]>, generation: &str, owner: &str) -> Result<Self> {
+        anyhow::ensure!(
+            generation.len() == 64 && generation.bytes().all(|b| b.is_ascii_hexdigit()),
+            "invalid saved login publication"
+        );
+        Ok(Self {
+            state_cipher: cipher.to_vec(),
+            logout_epoch: epoch.map(Vec::from),
+            credential_generation: generation.into(),
+            owner: owner.into(),
+        })
+    }
+}
+pub struct SendFinalUpdate<'a> {
+    pub id: &'a str,
+    pub state: &'a str,
+    pub server_id: Option<&'a str>,
+    pub error: Option<&'a str>,
+}
+#[derive(Debug)]
+struct ProjectionCompletionFailure(anyhow::Error);
+impl std::fmt::Display for ProjectionCompletionFailure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("saved_login_completion_failed")
+    }
+}
+impl std::error::Error for ProjectionCompletionFailure {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        Some(self.0.as_ref())
+    }
+}
+fn value(tx: &Transaction<'_>, key: &str) -> Result<Option<Vec<u8>>> {
+    Ok(tx
+        .query_row("SELECT value FROM runtime WHERE key=?1", [key], |r| {
+            r.get(0)
+        })
+        .optional()?)
+}
+fn complete(tx: &Transaction<'_>, proof: &UnchangedSavedLoginCompletion) -> Result<()> {
+    // A superseded projection cannot erase independently verified send facts.
+    // Expected policy denials remain Ok so the admitted writer stays healthy.
+    if !crate::authorization::saved_login_generation(
+        tx,
+        &proof.state_cipher,
+        proof.logout_epoch.as_deref(),
+    )? || value(tx, "validated-generation")?.as_deref() != Some(proof.owner.as_bytes())
+        || value(tx, "saved-login-publication")?.is_some()
+        || value(tx, "saved-login-projected-generation")?.as_deref()
+            != Some(proof.credential_generation.as_bytes())
+    {
+        return Ok(());
+    }
+    let state_generation = format!("{:x}", Sha256::digest(&proof.state_cipher));
+    for (key, value) in [
+        (
+            "saved-login-projected-generation",
+            proof.credential_generation.as_bytes(),
+        ),
+        (
+            "saved-login-projected-state-generation",
+            state_generation.as_bytes(),
+        ),
+    ] {
+        tx.execute(
+            "INSERT INTO runtime VALUES(?1,?2) ON CONFLICT(key)DO UPDATE SET value=excluded.value",
+            params![key, value],
+        )?;
+    }
+    tx.execute("DELETE FROM runtime WHERE key IN ('saved-login-publication','saved-login-projection-needed')",[])?;
+    Ok(())
+}
+impl Store {
+    pub fn update_send_after_unchanged_projection(
+        &self,
+        account: &str,
+        send: SendFinalUpdate<'_>,
+        proof: &UnchangedSavedLoginCompletion,
+    ) -> Result<SendIntent> {
+        let result=self.control(account,|db| {
+            let tx=db.transaction()?;
+            complete(&tx,proof).map_err(ProjectionCompletionFailure)?;
+            tx.execute("UPDATE outbox SET state=?2,server_id=COALESCE(?3,server_id),error_code=?4 WHERE id=?1 AND state!='cancelled'",params![send.id,send.state,send.server_id,send.error])?;
+            let intent=crate::read_send(&tx,account,send.id)?;
+            tx.execute("INSERT INTO events(kind,data_json,created_at)VALUES('send.updated',?1,?2)",params![serde_json::to_string(&intent)?,chrono::Utc::now().to_rfc3339()])?;
+            crate::event_consumers::prune_events(&tx,tx.last_insert_rowid())?;
+            tx.commit()?;
+            Ok(intent)
+        });
+        match result {
+            // The old Core ignored projection metadata errors, then performed
+            // this independent local final write. control has already rolled
+            // back and invalidated the failed writer. No network is retried.
+            Err(error)
+                if error
+                    .downcast_ref::<ProjectionCompletionFailure>()
+                    .is_some() =>
+            {
+                self.update_send(account, send.id, send.state, send.server_id, send.error)
+            }
+            other => other,
+        }
+    }
+}
+

+#[test]
+fn external_main_replacement_and_callback_replacement_never_rebind_a_writer() {
+    for inside_callback in [false, true] {
+        let (_directory, store) = wal_store();
+        store.put_runtime("one", "old", b"durable").unwrap();
+        let path = control_path(&store, "one");
+        let previous = path.with_extension("previous");
+        let old_main = fs::read(&path).unwrap();
+        let replace = || {
+            fs::rename(&path, &previous).unwrap();
+            private_write(&path, b"unknown replacement database");
+        };
+        let mut before = None;
+        if inside_callback {
+            let result = store.control("one", |_| {
+                replace();
+                before = Some(family(&path));
+                Ok(())
+            });
+            assert!(result.is_err());
+        } else {
+            replace();
+            before = Some(family(&path));
+            assert!(store.runtime("one", "old").is_err());
+        }
+        let before = before.unwrap();
+        assert_eq!(family(&path), before);
+        assert_eq!(fs::read(&previous).unwrap(), old_main);
+        assert_eq!(store.admitted.lock().unwrap().cached_writers(), 0);
+        drop(store);
+        assert_eq!(family(&path), before);
+    }
+}

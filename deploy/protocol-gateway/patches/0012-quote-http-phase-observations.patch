+
+fn short_http_observed(
+    observer: Option<&dyn RpcObserver>,
+    send: impl FnOnce() -> Result<reqwest::blocking::Response>,
+) -> Result<Vec<u8>> {
+    observe_rpc(observer, RpcPhase::ShortHttp, || {
+        let mut response = observe_rpc(observer, RpcPhase::ShortHttpHeaders, || {
+            let response = send()?;
+            ensure!(
+                response.status() == 200,
+                "Native shortlink HTTP status {}",
+                response.status().as_u16()
+            );
+            Ok(response)
+        })?;
+        observe_rpc(observer, RpcPhase::ShortHttpBody, || {
+            let mut bytes = Vec::new();
+            response
+                .by_ref()
+                .take((crate::MAX_MESSAGE_BYTES + 1) as u64)
+                .read_to_end(&mut bytes)?;
+            ensure!(
+                bytes.len() <= crate::MAX_MESSAGE_BYTES,
+                "Shortlink receive budget exceeded"
+            );
+            Ok(bytes)
+        })
+    })
+}

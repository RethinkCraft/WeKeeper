+#[tokio::test]
+async fn second_crash_after_receipt_recovery_still_repairs_profile_without_resending() {
+    let f = equal_fixture(false);
+    let old = f
+        .core
+        .store
+        .runtime("one", "account-state")
+        .unwrap()
+        .unwrap();

+++ b/packages/native-client-rust/crates/wechat-api/src/storage_maintenance_tests.rs
@@ -0,0 +1,145 @@
+use super::*;
+use axum::{body::Body, http::Request};
+use http_body_util::BodyExt;
+use tower::ServiceExt;
+
+const OWNER: &str = "0123456789abcdef0123456789abcdef";
+struct NoTransport;
+impl wechat_core::upstream::Upstream for NoTransport {
+    fn kind(&self) -> wechat_core::upstream::UpstreamKind {
+        wechat_core::upstream::UpstreamKind::Native
+    }
+    // The trait's native transport default fails closed; no network client.
+}
+
+fn fixture() -> (tempfile::TempDir, Arc<Core>, Router) {
+    let directory = tempfile::tempdir().unwrap();
+    let store = Arc::new(Store::open(&directory.path().join("data")).unwrap());
+    store.create_account("one").unwrap();
+    store.create_account("two").unwrap();
+    let core = Core::with_upstream(store, None, Arc::new(NoTransport)).unwrap();
+    let app = router(core.clone(), OWNER);
+    (directory, core, app)
+}
+
+async fn health(app: Router, account: &str, token: &str) -> (StatusCode, Value) {
+    let response = app
+        .oneshot(
+            Request::builder()
+                .uri(format!("/v1/accounts/{account}/storage-maintenance"))
+                .header("authorization", format!("Bearer {token}"))
+                .body(Body::empty())
+                .unwrap(),
+        )
+        .await
+        .unwrap();
+    let status = response.status();
+    let body = response.into_body().collect().await.unwrap().to_bytes();
+    (status, serde_json::from_slice(&body).unwrap())
+}
+
+#[tokio::test]
+async fn storage_health_requires_read_scope_and_the_correct_account() {
+    let (_directory, core, app) = fixture();
+    let read = "storage-read-one-synthetic-token";
+    let send = "storage-send-one-synthetic-token";
+    let grant = core
+        .store
+        .issue_token(
+            "read",
+            &format!("{:x}", Sha256::digest(read)),
+            &["one".into()],
+            &["read".into()],
+            None,
+        )
+        .unwrap();
+    core.store
+        .issue_token(
+            "send",
+            &format!("{:x}", Sha256::digest(send)),
+            &["one".into()],
+            &["send".into()],
+            None,
+        )
+        .unwrap();
+    let (status, body) = health(app.clone(), "one", read).await;
+    assert_eq!(status, StatusCode::OK);
+    assert_eq!(body["enabled"], true);
+    assert_eq!(body["stopping"], false);
+    assert!(body["state"].is_string());
+    assert_eq!(
+        health(app.clone(), "two", read).await.0,
+        StatusCode::FORBIDDEN
+    );
+    assert_eq!(
+        health(app.clone(), "one", send).await.0,
+        StatusCode::FORBIDDEN
+    );
+    core.store.revoke_token(&grant.id).unwrap();
+    assert_eq!(health(app, "one", read).await.0, StatusCode::UNAUTHORIZED);
+}
+
+#[tokio::test]
+async fn storage_health_avoids_control_queries_and_preserves_accepted_send() {
+    let (_directory, core, app) = fixture();
+    let intent = core
+        .store
+        .create_send("one", "accepted", "room", "hash", b"frozen", "7")
+        .unwrap()
+        .0;
+    core.store
+        .update_send("one", &intent.id, "accepted", Some("17"), None)
+        .unwrap();
+    let before = serde_json::to_value(core.store.send("one", &intent.id).unwrap()).unwrap();
+    core.store
+        .put_runtime(
+            "one",
+            "profile-identity-binding",
+            b"invalid-protected-record",
+        )
+        .unwrap();
+    assert!(core.account_status("one").is_err());
+    let (status, body) = health(app.clone(), "one", OWNER).await;
+    assert_eq!(status, StatusCode::OK);
+    assert_eq!(body["enabled"], true);
+    core.shutdown();
+    let (status, body) = health(app, "one", OWNER).await;
+    assert_eq!(status, StatusCode::OK);
+    assert_eq!(body["stopping"], true);
+    core.store
+        .clear_runtime("one", "profile-identity-binding")
+        .unwrap();
+    assert_eq!(
+        serde_json::to_value(core.store.send("one", &intent.id).unwrap()).unwrap(),
+        before
+    );
+    assert!(core.store.queued_sends("one").unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn new_send_under_storage_pressure_returns_503_without_an_intent() {
+    let (_directory, core, app) = fixture();
+    core.store.request_checkpoint_stop();
+    let response = app
+        .oneshot(
+            Request::builder()
+                .method("POST")
+                .uri("/v1/accounts/one/sends")
+                .header("authorization", format!("Bearer {OWNER}"))
+                .header("content-type", "application/json")
+                .header("idempotency-key", "storage-pressure-new")
+                .body(Body::from(r#"{"threadId":"room","text":"fixed reply"}"#))
+                .unwrap(),
+        )
+        .await
+        .unwrap();
+    assert_eq!(response.status(), StatusCode::SERVICE_UNAVAILABLE);
+    let body: Value =
+        serde_json::from_slice(&response.into_body().collect().await.unwrap().to_bytes()).unwrap();
+    assert_eq!(body["error"]["code"], "storage_maintenance_blocked");
+    assert!(core
+        .store
+        .send_by_key("one", "storage-pressure-new")
+        .is_err());
+    assert!(core.store.queued_sends("one").unwrap().is_empty());
+}

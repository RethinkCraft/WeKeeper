+#[test]
+fn preserve_request_for_nonaccepted_results_uses_original_fresh_authority() {
+    for state in ["failed", "needs_review"] {
+        let (_dir, store, intent, snapshot) = setup();
+        let staged = stage(&store, &intent, &snapshot);
+        let result = store
+            .finalize_equal_send_with_authority(
+                "one",
+                SendFinalUpdate {
+                    id: &intent.id,
+                    state,
+                    server_id: None,
+                    error: Some("synthetic_result"),
+                },
+                &staged,
+                EqualSendAuthority::Preserve {
+                    fresh_fallback: FRESH,
+                },
+            )
+            .unwrap();
+        assert!(result.authorization_installed);
+        assert_eq!(result.intent.state, state);
+        assert_eq!(
+            store.runtime("one", "account-state").unwrap().as_deref(),
+            Some(FRESH)
+        );
+        assert!(store
+            .runtime("one", NETWORK_BLOCKED_STATE)
+            .unwrap()
+            .is_none());
+        assert_raw(&store, &intent);
+    }
+}

+//! Retain quote evidence independently before deferring an equal auth refresh.
+use crate::*;
+use rusqlite::{OptionalExtension, Transaction};
+
+pub(crate) const NETWORK_BLOCKED_STATE: &str = "network-blocked-state";
+const RECEIPT_PREFIX: &str = "quote-receipt:";
+
+#[derive(Clone)]
+pub struct EqualSendSnapshot {
+    account_id: String,
+    pub state_cipher: Vec<u8>,
+    pub logout_epoch: Option<Vec<u8>>,
+    pub owner: String,
+    pub credential_generation: String,
+    pub projected_state_generation: String,
+}
+
+#[derive(Clone)]
+pub struct EqualSendStage {
+    snapshot: EqualSendSnapshot,
+    intent_id: String,
+    token: Vec<u8>,
+}
+
+pub enum ReceiptDisposition {
+    Staged(EqualSendStage),
+    MetadataFallback,
+    AuthorizationSuperseded,
+}
+
+pub struct EqualSendFinalResult {
+    pub intent: SendIntent,
+    pub authorization_installed: bool,
+}
+
+#[derive(Clone)]
+pub struct BlockedAuthorizationSnapshot {
+    account_id: String,
+    pub state_cipher: Vec<u8>,
+    pub logout_epoch: Option<Vec<u8>>,
+    pub validated_owner: Option<Vec<u8>>,
+    pub desired: Option<Vec<u8>>,
+}
+
+fn value(db: &Connection, key: &str) -> Result<Option<Vec<u8>>> {
+    Ok(db
+        .query_row("SELECT value FROM runtime WHERE key=?1", [key], |r| {
+            r.get(0)
+        })
+        .optional()?)
+}
+
+pub(crate) fn cipher_generation(cipher: &[u8]) -> Vec<u8> {
+    format!("{:x}", Sha256::digest(cipher)).into_bytes()
+}
+
+pub(crate) fn network_generation_blocked(db: &Connection, expected: &[u8]) -> Result<bool> {
+    Ok(
+        value(db, NETWORK_BLOCKED_STATE)?.as_deref()
+            == Some(cipher_generation(expected).as_slice()),
+    )
+}
+
+fn authorization_current(db: &Connection, snapshot: &EqualSendSnapshot) -> Result<bool> {
+    Ok(value(db, "logged-out")?.is_none()
+        && value(db, "validated-generation")?.as_deref() == Some(snapshot.owner.as_bytes())
+        && value(db, "logout-epoch")? == snapshot.logout_epoch
+        && value(db, "account-state")?.as_deref() == Some(snapshot.state_cipher.as_slice())
+        && value(db, "saved-login-accepted-state-generation")?.as_deref()
+            == Some(cipher_generation(&snapshot.state_cipher).as_slice()))
+}
+
+fn snapshot_current(db: &Connection, snapshot: &EqualSendSnapshot) -> Result<bool> {
+    Ok(authorization_current(db, snapshot)?
+        && value(db, "desired")?.as_deref() == Some(b"connected")
+        && value(db, "saved-login-projected-generation")?.as_deref()
+            == Some(snapshot.credential_generation.as_bytes())
+        && value(db, "saved-login-projected-state-generation")?.as_deref()
+            == Some(snapshot.projected_state_generation.as_bytes())
+        && value(db, "saved-login-publication")?.is_none())
+}
+
+fn fresh_cipher(old: &[u8], new: &[u8]) -> Result<()> {
+    anyhow::ensure!(
+        !new.is_empty() && cipher_generation(old) != cipher_generation(new),
+        "equal_send_requires_fresh_cipher"
+    );
+    Ok(())
+}
+
+enum ReceiptWrite {
+    Existing,
+    Retained(ReceiptDisposition),
+}
+
+#[derive(Debug)]
+struct EqualAuthMetadataFailure(anyhow::Error);
+impl std::fmt::Display for EqualAuthMetadataFailure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("equal_send_auth_metadata_failed")
+    }
+}
+impl std::error::Error for EqualAuthMetadataFailure {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        Some(self.0.as_ref())
+    }
+}
+
+fn update_send_in_tx(
+    tx: &Transaction<'_>,
+    account: &str,
+    send: &SendFinalUpdate<'_>,
+) -> Result<SendIntent> {
+    tx.execute("UPDATE outbox SET state=?2,server_id=COALESCE(?3,server_id),error_code=?4 WHERE id=?1 AND state!='cancelled'", params![send.id,send.state,send.server_id,send.error])?;
+    let intent = crate::read_send(tx, account, send.id)?;
+    crate::outbox::event(tx, &intent)?;
+    Ok(intent)
+}
+
+impl Store {
+    pub fn capture_equal_send_snapshot(
+        &self,
+        account: &str,
+        owner: &str,
+    ) -> Result<Option<EqualSendSnapshot>> {
+        self.control(account, |db| {
+            let tx = db.transaction()?;
+            let Some(cipher) = value(&tx, "account-state")? else {
+                return Ok(None);
+            };
+            let Some(generation) = value(&tx, "saved-login-projected-generation")? else {
+                return Ok(None);
+            };
+            let generation = match String::from_utf8(generation) {
+                Ok(generation)
+                    if generation.len() == 64
+                        && generation.bytes().all(|b| b.is_ascii_hexdigit()) =>
+                {
+                    generation
+                }
+                _ => return Ok(None),
+            };
+            let snapshot = EqualSendSnapshot {
+                account_id: account.into(),
+                projected_state_generation: String::from_utf8(cipher_generation(&cipher))?,
+                state_cipher: cipher,
+                logout_epoch: value(&tx, "logout-epoch")?,
+                owner: owner.into(),
+                credential_generation: generation,
+            };
+            if !snapshot_current(&tx, &snapshot)?
+                || value(&tx, "saved-login-projection-needed")?.is_some()
+                || value(&tx, NETWORK_BLOCKED_STATE)?.is_some()
+            {
+                return Ok(None);
+            }
+            Ok(Some(snapshot))
+        })
+    }
+
+    /// The receipt always precedes application parsing. Optional metadata may
+    /// fail independently, but must never replace the original protected bytes.
+    pub fn retain_equal_send_receipt(
+        &self,
+        account: &str,
+        id: &str,
+        sealed: &[u8],
+        snapshot: Option<&EqualSendSnapshot>,
+    ) -> Result<ReceiptDisposition> {
+        anyhow::ensure!(
+            !id.is_empty() && id.len() <= 200 && !sealed.is_empty(),
+            "invalid_quote_receipt"
+        );
+        let key = format!("{RECEIPT_PREFIX}{id}");
+        let mut committed = false;
+        let mut commit_attempted = false;
+        let mut optional_metadata_started = false;
+        let result = self.control(account, |db| {
+            let mut tx = db.transaction()?;
+            if value(&tx, &key)?.is_some() {
+                return Ok(ReceiptWrite::Existing);
+            }
+            tx.execute("INSERT INTO runtime VALUES(?1,?2)", params![key, sealed])?;
+            let mut disposition = ReceiptDisposition::MetadataFallback;
+            if let Some(snapshot) = snapshot {
+                optional_metadata_started = true;
+                let submitting: bool = tx.query_row(
+                    "SELECT EXISTS(SELECT 1 FROM outbox WHERE id=?1 AND state='submitting')",
+                    [id],
+                    |r| r.get(0),
+                )?;
+                if snapshot.account_id != account || !authorization_current(&tx, snapshot)? {
+                    disposition = ReceiptDisposition::AuthorizationSuperseded;
+                } else if submitting
+                    && snapshot_current(&tx, snapshot)?
+                    && value(&tx, "saved-login-projection-needed")?.is_none()
+                    && value(&tx, NETWORK_BLOCKED_STATE)?.is_none()
+                {
+                    let token = format!("equal-send:{id}:{}", uuid::Uuid::new_v4()).into_bytes();
+                    let mut savepoint = tx.savepoint()?;
+                    let metadata = (|| -> Result<()> {
+                        savepoint.execute(
+                            "INSERT INTO runtime VALUES('saved-login-projection-needed',?1)",
+                            [token.as_slice()],
+                        )?;
+                        savepoint.execute(
+                            "INSERT INTO runtime VALUES(?1,?2)",
+                            params![
+                                NETWORK_BLOCKED_STATE,
+                                cipher_generation(&snapshot.state_cipher)
+                            ],
+                        )?;
+                        Ok(())
+                    })();
+                    match metadata {
+                        Ok(()) => {
+                            savepoint.commit()?;
+                            disposition = ReceiptDisposition::Staged(EqualSendStage {
+                                snapshot: snapshot.clone(),
+                                intent_id: id.into(),
+                                token,
+                            });
+                        }
+                        Err(_) => {
+                            // ABORT leaves this savepoint usable; ROLLBACK and
+                            // fatal IO errors reach the receipt-only fallback.
+                            savepoint.rollback()?;
+                            savepoint.commit()?;
+                        }
+                    }
+                }
+            }
+            commit_attempted = true;
+            tx.commit()?;
+            committed = true;
+            Ok(ReceiptWrite::Retained(disposition))
+        });
+        match result {
+            Ok(ReceiptWrite::Existing) => bail!("quote_receipt_already_retained"),
+            Ok(ReceiptWrite::Retained(disposition)) => Ok(disposition),
+            Err(error) => {
+                // Visibility cannot prove a failed COMMIT reached stable
+                // storage. Keep that outcome unknown rather than parse it.
+                if !committed && (commit_attempted || !optional_metadata_started) {
+                    return Err(error);
+                }
+                // A metadata error may roll back the entire outer transaction.
+                // Re-enter normal Store admission; never bypass family checks.
+                self.retain_original_receipt_only(account, &key, sealed, committed)
+                    .map_err(|fallback| fallback.context(error))?;
+                Ok(ReceiptDisposition::MetadataFallback)
+            }
+        }
+    }
+
+    /// Preserve the original auth path when only coalescing eligibility changed.
+    /// The context CAS is in this transaction, not in a preceding Core read.
+    pub fn save_accepted_equal_fallback(
+        &self,
+        account: &str,
+        snapshot: &EqualSendSnapshot,
+        new_cipher: &[u8],
+    ) -> Result<bool> {
+        fresh_cipher(&snapshot.state_cipher, new_cipher)?;
+        if snapshot.account_id != account {
+            return Ok(false);
+        }
+        self.control(account, |db| {
+            let tx = db.transaction()?;
+            if !authorization_current(&tx, snapshot)? {
+                return Ok(false);
+            }
+            tx.execute(
+                "UPDATE runtime SET value=?1 WHERE key='account-state'",
+                [new_cipher],
+            )?;
+            crate::authorization::accepted_projection_needed(&tx, new_cipher)?;
+            tx.commit()?;
+            Ok(true)
+        })
+    }
+
+    fn retain_original_receipt_only(
+        &self,
+        account: &str,
+        key: &str,
+        sealed: &[u8],
+        known_committed: bool,
+    ) -> Result<()> {
+        enum Outcome {
+            Saved,
+            ExistingDifferent,
+            DurabilityUnknown,
+        }
+        let outcome = self.control(account, |db| {
+            let tx = db.transaction()?;
+            if let Some(existing) = value(&tx, key)? {
+                if existing != sealed {
+                    return Ok(Outcome::ExistingDifferent);
+                }
+                return Ok(if known_committed {
+                    Outcome::Saved
+                } else {
+                    Outcome::DurabilityUnknown
+                });
+            }
+            tx.execute("INSERT INTO runtime VALUES(?1,?2)", params![key, sealed])?;
+            tx.commit()?;
+            Ok(Outcome::Saved)
+        })?;
+        match outcome {
+            Outcome::Saved => Ok(()),
+            Outcome::ExistingDifferent => bail!("quote_receipt_already_retained"),
+            Outcome::DurabilityUnknown => bail!("quote_receipt_durability_unknown"),
+        }
+    }
+
+    pub fn finalize_equal_send(
+        &self,
+        account: &str,
+        send: SendFinalUpdate<'_>,
+        stage: &EqualSendStage,
+        new_cipher: &[u8],
+    ) -> Result<EqualSendFinalResult> {
+        anyhow::ensure!(
+            stage.intent_id == send.id && stage.snapshot.account_id == account,
+            "invalid_equal_send_intent"
+        );
+        fresh_cipher(&stage.snapshot.state_cipher, new_cipher)?;
+        let result = self.control(account, |db| {
+            let tx = db.transaction()?;
+            let install = snapshot_current(&tx, &stage.snapshot)?
+                && value(&tx, "saved-login-projection-needed")?.as_deref() == Some(stage.token.as_slice())
+                && network_generation_blocked(&tx, &stage.snapshot.state_cipher)?;
+            if install {
+                (|| -> Result<()> {
+                    tx.execute("INSERT INTO runtime VALUES('account-state',?1) ON CONFLICT(key)DO UPDATE SET value=excluded.value", [new_cipher])?;
+                    crate::authorization::accepted_projection_needed(&tx, new_cipher)?;
+                    let generation = cipher_generation(new_cipher);
+                    for (key, value) in [
+                        ("saved-login-projected-generation", stage.snapshot.credential_generation.as_bytes()),
+                        ("saved-login-projected-state-generation", generation.as_slice()),
+                    ] {
+                        tx.execute("INSERT INTO runtime VALUES(?1,?2) ON CONFLICT(key)DO UPDATE SET value=excluded.value", params![key,value])?;
+                    }
+                    tx.execute("DELETE FROM runtime WHERE key IN ('saved-login-publication','saved-login-projection-needed')", [])?;
+                    Ok(())
+                })().map_err(EqualAuthMetadataFailure)?;
+            }
+            let intent = update_send_in_tx(&tx, account, &send)?;
+            tx.commit()?;
+            Ok(EqualSendFinalResult { intent, authorization_installed: install })
+        });
+        match result {
+            Err(error) if error.downcast_ref::<EqualAuthMetadataFailure>().is_some() => {
+                let intent =
+                    self.update_send(account, send.id, send.state, send.server_id, send.error)?;
+                Ok(EqualSendFinalResult {
+                    intent,
+                    authorization_installed: false,
+                })
+            }
+            other => other,
+        }
+    }
+
+    pub fn blocked_authorization_snapshot(
+        &self,
+        account: &str,
+    ) -> Result<Option<BlockedAuthorizationSnapshot>> {
+        self.control(account, |db| {
+            let tx = db.transaction()?;
+            let Some(cipher) = value(&tx, "account-state")? else {
+                return Ok(None);
+            };
+            if value(&tx, "logged-out")?.is_some()
+                || !network_generation_blocked(&tx, &cipher)?
+                || value(&tx, "saved-login-accepted-state-generation")?.as_deref()
+                    != Some(cipher_generation(&cipher).as_slice())
+            {
+                return Ok(None);
+            }
+            Ok(Some(BlockedAuthorizationSnapshot {
+                account_id: account.into(),
+                state_cipher: cipher,
+                logout_epoch: value(&tx, "logout-epoch")?,
+                validated_owner: value(&tx, "validated-generation")?,
+                desired: value(&tx, "desired")?,
+            }))
+        })
+    }
+
+    pub fn repair_blocked_authorization(
+        &self,
+        account: &str,
+        snapshot: &BlockedAuthorizationSnapshot,
+        new_cipher: &[u8],
+    ) -> Result<bool> {
+        fresh_cipher(&snapshot.state_cipher, new_cipher)?;
+        if snapshot.account_id != account {
+            return Ok(false);
+        }
+        self.control(account, |db| {
+            let tx = db.transaction()?;
+            if value(&tx, "logged-out")?.is_some()
+                || value(&tx, "logout-epoch")? != snapshot.logout_epoch
+                || value(&tx, "validated-generation")? != snapshot.validated_owner
+                || value(&tx, "desired")? != snapshot.desired
+                || value(&tx, "account-state")?.as_deref() != Some(snapshot.state_cipher.as_slice())
+                || value(&tx, "saved-login-accepted-state-generation")?.as_deref()
+                    != Some(cipher_generation(&snapshot.state_cipher).as_slice())
+                || !network_generation_blocked(&tx, &snapshot.state_cipher)?
+            {
+                return Ok(false);
+            }
+            tx.execute(
+                "UPDATE runtime SET value=?1 WHERE key='account-state'",
+                [new_cipher],
+            )?;
+            crate::authorization::accepted_projection_needed(&tx, new_cipher)?;
+            tx.commit()?;
+            Ok(true)
+        })
+    }
+}

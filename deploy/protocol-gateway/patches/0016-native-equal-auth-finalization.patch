+#[test]
+fn desired_or_pending_changes_allow_fenced_auth_without_dropping_new_cookie() {
+    for change in ["desired", "needed", "journal"] {
+        let (_dir, store, intent, snapshot) = setup();
+        match change {
+            "desired" => store
+                .put_runtime("one", "desired", b"disconnected")
+                .unwrap(),
+            "needed" => store
+                .put_runtime("one", "saved-login-projection-needed", b"pending")
+                .unwrap(),
+            "journal" => store
+                .put_runtime("one", "saved-login-publication", b"pending-journal")
+                .unwrap(),
+            _ => unreachable!(),
+        }
+        assert!(matches!(
+            store
+                .retain_equal_send_receipt("one", &intent.id, RAW, Some(&snapshot))
+                .unwrap(),
+            ReceiptDisposition::MetadataFallback
+        ));
+        let desired = store.runtime("one", "desired").unwrap();
+        assert!(store
+            .save_accepted_equal_fallback("one", &snapshot, b"new-cookie-full-state")
+            .unwrap());
+        assert_eq!(
+            store.runtime("one", "account-state").unwrap().as_deref(),
+            Some(b"new-cookie-full-state".as_slice())
+        );
+        assert_eq!(store.runtime("one", "desired").unwrap(), desired);
+        assert_raw(&store, &intent);
+    }
+}

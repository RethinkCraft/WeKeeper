+    fn defer_archive_projection(&self, account: &str) -> Result<bool> {
+        // Bot receive path does not wait for message.committed. Yield the
+        // account lock while foreground send/receive work is active, but never
+        // starve archive projection longer than sixty seconds.
+        let oldest = self.store.oldest_pending_projection_age_secs(account)?;
+        if oldest.is_some_and(|age| age >= 60) {
+            return Ok(false);
+        }
+        if !self.store.queued_sends(account)?.is_empty()
+            || !self.store.submitting_sends(account)?.is_empty()
+            || self.store.required_consumers_unacked(account)?
+        {
+            return Ok(true);
+        }
+        if self
+            .store
+            .recent_event_activity_secs(account)?
+            .is_some_and(|age| age <= 2)
+        {
+            return Ok(true);
+        }
+        Ok(false)
+    }
